// view shows a TIM1 image. Drag, scroll or use the arrows to look around a
// picture bigger than the window, and drag the strip under the window to
// resize it. Only the tiles in view are read from the file and decoded, so
// the picture can be much bigger than view's memory.

import gfx
import image
import io
import mem
import os
import text

manifest {
    memory = 4 * MiB
    stack = 32 * KiB
    allow = "read window"
}

const SLOTS = 96                // decoded tiles kept at once

struct Slot {
    tile u32                    // tile number + 1, or 0 when empty
    pixels [image.TILE_PIXELS]u32
    image gfx.Image
}

var file u32
var header image.Header
var table []u8                  // the header and tile offsets
var compressed [image.TILE_PIXELS * 5]u8
var slots [SLOTS]Slot
var next_slot u32
var canvas gfx.Canvas
var words [4096]u32
var strings [256]u8
var width i32
var height i32
var scroll_x i32
var scroll_y i32
var arena mem.Arena

fn main(memory []u8) u32 {
    mem.arena_init(&arena, memory)
    var name [256]u8
    var n = os.arg(0, name[:])
    if os.arg_count() != 1 || n > 256 {
        os.complain("view", "usage: view picture.tim", "")
        return 2
    }
    var path = name[0:n]
    file = io.open(path, io.MODE_READ)
    if file == io.FAILED {
        os.complain("view", "can't read", path)
        return 1
    }
    var first [16]u8
    if io.read(file, first[:]) != first.len || !text.equal(first[0:4], "TIM1") || mem.read_word(first[:], 12) != image.TILE {
        os.complain("view", "not a TIM1 image:", path)
        return 1
    }
    // The table of where each tile starts has to fit in memory, with room
    // left for the tiles themselves.
    var tiles_x = (mem.read_word(first[:], 4) + image.TILE - 1) / image.TILE
    var tiles_y = (mem.read_word(first[:], 8) + image.TILE - 1) / image.TILE
    var room = (arena.memory.len - arena.used) / 8
    if tiles_x == 0 || tiles_y == 0 || tiles_x > room || tiles_y > room / tiles_x {
        os.complain("view", "too big to view:", path)
        return 1
    }
    table = mem.alloc_bytes(&arena, 16 + (tiles_x * tiles_y + 1) * 4)
    io.seek(file, 0)
    if io.read(file, table) != table.len || !image.read_header(table, &header) {
        os.complain("view", "not a TIM1 image:", path)
        return 1
    }

    var screen gfx.ScreenInfo
    gfx.screen_info(&screen)
    width = min_i(header.width as i32, screen.width as i32 - 60)
    height = min_i(header.height as i32, screen.height as i32 - 80)
    var window = gfx.window_open(path, width as u32, height as u32)
    if window == io.FAILED {
        os.complain("view", "can't open a window", "")
        return 1
    }
    gfx.window_resizable(window, 64, 64)
    gfx.canvas_init(&canvas, window, words[:], strings[:])
    while true {
        var e gfx.Event
        gfx.event_wait(&e, gfx.FOREVER)
        var dx i32 = 0
        var dy i32 = 0
        if e.kind == gfx.EVENT_CLOSE {
            return 0
        } else if e.kind == gfx.EVENT_KEY_DOWN {
            if e.key == gfx.KEY_LEFT { dx = -32 }
            if e.key == gfx.KEY_RIGHT { dx = 32 }
            if e.key == gfx.KEY_UP { dy = -32 }
            if e.key == gfx.KEY_DOWN { dy = 32 }
        } else if e.kind == gfx.EVENT_WHEEL {
            dx = e.x * 24
            dy = e.y * 24
        } else if e.kind == gfx.EVENT_MOUSE_DOWN {
            drag_from_x = e.x
            drag_from_y = e.y
        } else if e.kind == gfx.EVENT_MOUSE_MOVE && e.buttons != 0 {
            dx = drag_from_x - e.x
            dy = drag_from_y - e.y
            drag_from_x = e.x
            drag_from_y = e.y
        } else if e.kind == gfx.EVENT_RESIZE {
            width = e.x
            height = e.y
        } else if e.kind != gfx.EVENT_DRAW {
            continue
        }
        scroll_x = clamp(scroll_x + dx, header.width as i32 - width)
        scroll_y = clamp(scroll_y + dy, header.height as i32 - height)
        draw()
    }
    return 0
}

var drag_from_x i32
var drag_from_y i32

fn min_i(a i32, b i32) i32 {
    if a < b {
        return a
    }
    return b
}

fn clamp(v i32, most i32) i32 {
    if v > most {
        return most
    }
    if v < 0 {
        return 0
    }
    return v
}

fn min_u(a u32, b u32) u32 {
    if a < b {
        return a
    }
    return b
}

// The decoded pixels of a tile, reading it from the file if need be.
fn tile_image(tx u32, ty u32) *gfx.Image {
    var n = ty * header.tiles_x + tx
    for i in 0..SLOTS {
        if slots[i].tile == n + 1 {
            return &slots[i].image
        }
    }
    var slot = &slots[next_slot]
    next_slot = (next_slot + 1) % SLOTS
    slot.tile = n + 1
    slot.image.width = image.tile_width(&header, tx)
    slot.image.height = image.tile_height(&header, ty)
    slot.image.pixels = slot.pixels[:]
    var start = image.tile_offset(table, n)
    var size = image.tile_offset(table, n + 1) - start
    var count = slot.image.width * slot.image.height
    if size > compressed.len || io.seek(file, start) != start || io.read(file, compressed[0:size]) != size || !image.decode_tile(compressed[0:size], slot.pixels[:], count) {
        for i in 0..count {
            slot.pixels[i] = 0xffff00ff
        }
    }
    return &slot.image
}

fn draw() {
    // A window bigger than the picture shows a border around it.
    if width > header.width as i32 || height > header.height as i32 {
        gfx.draw_fill(&canvas, 0, 0, width, height, 0xff1b1d23)
    }
    var first_x = scroll_x as u32 / image.TILE
    var first_y = scroll_y as u32 / image.TILE
    var last_x = min_u((scroll_x + width - 1) as u32 / image.TILE, header.tiles_x - 1)
    var last_y = min_u((scroll_y + height - 1) as u32 / image.TILE, header.tiles_y - 1)
    for ty in first_y..last_y + 1 {
        for tx in first_x..last_x + 1 {
            var tile = tile_image(tx, ty)
            var x = (tx * image.TILE) as i32 - scroll_x
            var y = (ty * image.TILE) as i32 - scroll_y
            gfx.draw_image(&canvas, tile, 0, 0, tile.width as i32, tile.height as i32, x, y, false)
        }
        // Tiles might be reused by later rows, so send this row now.
        gfx.present(&canvas)
    }
}
