// view shows a TIM1 image. Drag, scroll or use the arrows to look around a
// picture bigger than the window, and drag the strip under the window to
// resize it. Only the tiles in view are read from the file and decoded, so
// the picture can be much bigger than view's memory.

manifest {
    memory = 4 * MiB;
    stack = 32 * KiB;
    allow = "read window";
}

const SLOTS = 96;               // decoded tiles kept at once

struct Slot {
    tile: u32;                  // tile number + 1, or 0 when empty
    pixels: [TILE_PIXELS]u32;
    image: Image;
}

var file: u32;
var header: ImageHeader;
var table: []u8;                // the header and tile offsets
var compressed: [TILE_PIXELS * 5]u8;
var slots: [SLOTS]Slot;
var next_slot: u32;
var canvas: Canvas;
var words: [4096]u32;
var strings: [256]u8;
var width: i32;
var height: i32;
var scroll_x: i32;
var scroll_y: i32;
var arena: Arena;

fn main(memory: []u8) -> u32 {
    arena_init(&arena, memory);
    var name: [256]u8;
    var n = arg(0, name[:]);
    if arg_count() != 1 || n > 256 {
        complain("view", "usage: view picture.tim", "");
        return 2;
    }
    var path = name[0:n];
    file = open(path, MODE_READ);
    if file == FAILED {
        complain("view", "can't read", path);
        return 1;
    }
    var first: [16]u8;
    read(file, first[:]);
    var tiles = ((read_word(first[:], 4) + TILE - 1) / TILE) * ((read_word(first[:], 8) + TILE - 1) / TILE);
    table = alloc_bytes(&arena, 16 + (tiles + 1) * 4);
    seek(file, 0);
    if read(file, table) != table.len || !image_header(table, &header) {
        complain("view", "not a TIM1 image:", path);
        return 1;
    }

    var screen: ScreenInfo;
    screen_info(&screen);
    width = min_i(header.width as i32, screen.width as i32 - 60);
    height = min_i(header.height as i32, screen.height as i32 - 80);
    var window = window_open(path, width as u32, height as u32);
    if window == FAILED {
        complain("view", "can't open a window", "");
        return 1;
    }
    window_resizable(window, 64, 64);
    canvas_init(&canvas, window, words[:], strings[:]);
    while true {
        var e: Event;
        event_wait(&e, FOREVER);
        var dx: i32 = 0;
        var dy: i32 = 0;
        if e.kind == EVENT_CLOSE {
            return 0;
        } else if e.kind == EVENT_KEY_DOWN {
            if e.key == KEY_LEFT { dx = -32; }
            if e.key == KEY_RIGHT { dx = 32; }
            if e.key == KEY_UP { dy = -32; }
            if e.key == KEY_DOWN { dy = 32; }
        } else if e.kind == EVENT_WHEEL {
            dx = e.x * 24;
            dy = e.y * 24;
        } else if e.kind == EVENT_MOUSE_DOWN {
            drag_from_x = e.x;
            drag_from_y = e.y;
        } else if e.kind == EVENT_MOUSE_MOVE && e.buttons != 0 {
            dx = drag_from_x - e.x;
            dy = drag_from_y - e.y;
            drag_from_x = e.x;
            drag_from_y = e.y;
        } else if e.kind == EVENT_RESIZE {
            width = e.x;
            height = e.y;
        } else if e.kind != EVENT_DRAW {
            continue;
        }
        scroll_x = clamp(scroll_x + dx, header.width as i32 - width);
        scroll_y = clamp(scroll_y + dy, header.height as i32 - height);
        draw();
    }
    return 0;
}

var drag_from_x: i32;
var drag_from_y: i32;

fn min_i(a: i32, b: i32) -> i32 {
    if a < b {
        return a;
    }
    return b;
}

fn clamp(v: i32, most: i32) -> i32 {
    if v > most {
        return most;
    }
    if v < 0 {
        return 0;
    }
    return v;
}

fn min_u(a: u32, b: u32) -> u32 {
    if a < b {
        return a;
    }
    return b;
}

// The decoded pixels of a tile, reading it from the file if need be.
fn tile_image(tx: u32, ty: u32) -> *Image {
    var n = ty * header.tiles_x + tx;
    for i in 0..SLOTS {
        if slots[i].tile == n + 1 {
            return &slots[i].image;
        }
    }
    var slot = &slots[next_slot];
    next_slot = (next_slot + 1) % SLOTS;
    slot.tile = n + 1;
    slot.image.width = tile_width(&header, tx);
    slot.image.height = tile_height(&header, ty);
    slot.image.pixels = slot.pixels[:];
    var start = tile_offset(table, n);
    var size = tile_offset(table, n + 1) - start;
    var count = slot.image.width * slot.image.height;
    if size > compressed.len || seek(file, start) != start || read(file, compressed[0:size]) != size || !decode_tile(compressed[0:size], slot.pixels[:], count) {
        for i in 0..count {
            slot.pixels[i] = 0xffff00ff;
        }
    }
    return &slot.image;
}

fn draw() {
    // A window bigger than the picture shows a border around it.
    if width > header.width as i32 || height > header.height as i32 {
        draw_fill(&canvas, 0, 0, width, height, 0xff1b1d23);
    }
    var first_x = scroll_x as u32 / TILE;
    var first_y = scroll_y as u32 / TILE;
    var last_x = min_u((scroll_x + width - 1) as u32 / TILE, header.tiles_x - 1);
    var last_y = min_u((scroll_y + height - 1) as u32 / TILE, header.tiles_y - 1);
    for ty in first_y..last_y + 1 {
        for tx in first_x..last_x + 1 {
            var image = tile_image(tx, ty);
            var x = (tx * TILE) as i32 - scroll_x;
            var y = (ty * TILE) as i32 - scroll_y;
            draw_image(&canvas, image, 0, 0, image.width as i32, image.height as i32, x, y, false);
        }
        // Tiles might be reused by later rows, so send this row now.
        present(&canvas);
    }
}
