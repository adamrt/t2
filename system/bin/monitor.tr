// monitor shows what the machine is doing: the memory each process reserved,
// how many instructions each runs per second, and how busy the CPU has been.
// Stop ends a process, for when one misbehaves.

manifest {
    memory = 256 * KiB;
    stack = 32 * KiB;
    allow = "window processes recovery";
}

const WIDTH = 520;
const HEIGHT = 330;
const HISTORY = 100;
const MAX = 32;

var canvas: Canvas;
var words: [4096]u32;
var strings: [4096]u8;
var ui: Ui;
var records: [MAX]ProcessInfo;
var count: u32;
var last_cycles: [MAX]u32;
var last_ids: [MAX]u32;
var rates: [MAX]u32;
var history: [HISTORY]u32;
var history_at: u32;
var last_time: u32;
var line_text: [96]u8;

fn main(memory: []u8) -> u32 {
    var window = window_open("Monitor", WIDTH, HEIGHT);
    if window == FAILED {
        complain("monitor", "can't open a window", "");
        return 1;
    }
    canvas_init(&canvas, window, words[:], strings[:]);
    ui_init(&ui, &canvas);
    last_time = time();
    sample();
    while true {
        var e: Event;
        if event_wait(&e, 500) == 1 {
            if e.kind == EVENT_CLOSE {
                return 0;
            }
            if e.kind == EVENT_MOUSE_MOVE && ui.active == 0 {
                continue;
            }
            ui_event(&ui, &e);
        } else {
            e.kind = 0;
            ui_event(&ui, &e);
            sample();
        }
        draw();
        ui_end(&ui);
    }
    return 0;
}

// Reads the process list and works out instructions per second.
fn sample() {
    var now = time();
    var elapsed = now - last_time;
    if elapsed == 0 {
        elapsed = 1;
    }
    last_time = now;
    var bytes = processes((&records[0] as *u8)[0:size_of(ProcessInfo) * MAX]);
    count = bytes / size_of(ProcessInfo);
    var total: u32 = 0;
    for i in 0..count {
        var p = &records[i];
        rates[i] = 0;
        for j in 0..MAX {
            if last_ids[j] == p.id && p.cycles >= last_cycles[j] {
                rates[i] = (p.cycles - last_cycles[j]) / elapsed * 1000;
            }
        }
        total += rates[i];
    }
    for i in 0..MAX {
        last_ids[i] = 0;
    }
    for i in 0..count {
        last_ids[i] = records[i].id;
        last_cycles[i] = records[i].cycles;
    }
    history[history_at] = total;
    history_at = (history_at + 1) % HISTORY;
}

fn draw() {
    draw_fill(&canvas, 0, 0, WIDTH, HEIGHT, rgb(242, 239, 230));
    var free: u32;
    var total = memory_info(&free);
    var used = total - free;
    var w: Writer;

    writer_init(&w, STDOUT, line_text[:]);
    put(&w, "Memory: ");
    put_u32(&w, used / KiB);
    put(&w, " of ");
    put_u32(&w, total / KiB);
    put(&w, " KiB reserved");
    draw_text(&canvas, 10, 8, rgb(30, 30, 36), line_text[0:w.used]);
    draw_fill(&canvas, 10, 28, WIDTH - 20, 14, rgb(210, 205, 192));
    var bar = ((WIDTH - 20) as u32 * (used / KiB) / (total / KiB)) as i32;
    draw_fill(&canvas, 10, 28, bar, 14, rgb(45, 90, 80));

    draw_text(&canvas, 10, 52, rgb(120, 116, 106), "  id  name            memory   stack instructions/s");
    for i in 0..count {
        var p = &records[i];
        var y = 72 + (i as i32) * 16;
        if y > 200 {
            break;
        }
        writer_init(&w, STDOUT, line_text[:]);
        pad(&w, p.id, 4);
        put(&w, "  ");
        var name = process_name(p);
        put(&w, name[0:min(name.len, 14)]);
        for k in name.len..14 {
            put_byte(&w, ' ');
        }
        pad(&w, p.memory / KiB, 7);
        put(&w, "K");
        pad(&w, p.stack, 8);
        pad(&w, rates[i], 15);
        draw_text(&canvas, 10, y, rgb(30, 30, 36), line_text[0:w.used]);
        if p.id > 1 && ui_button(&ui, p.id, WIDTH - 52, y - 1, 44, 17, "Stop") {
            kill(p.id);
            sample();
        }
    }

    // Instructions per second over the last minute or so.
    var graph_y: i32 = 220;
    var graph_h: i32 = 96;
    draw_fill(&canvas, 10, graph_y, WIDTH - 20, graph_h, rgb(30, 30, 36));
    var peak: u32 = 1;
    for i in 0..HISTORY {
        if history[i] > peak {
            peak = history[i];
        }
    }
    var bar_w: i32 = (WIDTH - 20) / HISTORY;
    for i in 0..HISTORY {
        var v = history[(history_at + i) % HISTORY];
        var h = ((v / 1000) * (graph_h as u32 - 4) / (peak / 1000 + 1)) as i32;
        draw_fill(&canvas, 10 + (i as i32) * bar_w, graph_y + graph_h - 2 - h, bar_w - 1, h, rgb(232, 195, 90));
    }
    writer_init(&w, STDOUT, line_text[:]);
    put(&w, "peak ");
    put_u32(&w, peak / 1000);
    put(&w, "K instructions/s");
    draw_text(&canvas, 14, graph_y + 4, rgb(216, 212, 200), line_text[0:w.used]);
    present(&canvas);
}

fn pad(w: *Writer, value: u32, width: u32) {
    var digits: [12]u8;
    var d: Writer;
    writer_init(&d, STDOUT, digits[:]);
    put_u32(&d, value);
    for i in d.used..width {
        put_byte(w, ' ');
    }
    put(w, digits[0:d.used]);
}

fn min(a: u32, b: u32) -> u32 {
    if a < b {
        return a;
    }
    return b;
}
