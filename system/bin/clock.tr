// clock, an analog clock, drawn with fixed-point sines.

manifest {
    memory = 128 * KiB;
    stack = 16 * KiB;
    allow = "window";
}

const SIZE = 200;
const CENTER = 100;

var canvas: Canvas;
var words: [2048]u32;
var strings: [256]u8;
var text: [32]u8;

fn main(memory: []u8) -> u32 {
    var window = window_open("Clock", SIZE, SIZE + 20);
    if window == FAILED {
        complain("clock", "can't open a window", "");
        return 1;
    }
    canvas_init(&canvas, window, words[:], strings[:]);
    var shown: u32 = 0;
    while true {
        var e: Event;
        if event_wait(&e, 250) == 1 {
            if e.kind == EVENT_CLOSE {
                return 0;
            }
            if e.kind == EVENT_DRAW {
                shown = 0;
            }
        }
        var now = date();
        if now != shown {
            draw(now);
            shown = now;
        }
    }
    return 0;
}

// A hand pointing at a fraction of the way round, from twelve o'clock.
fn hand(turn: u32, length: fixed, width: i32, color: u32) {
    var angle = (turn + TURN * 3 / 4) % TURN;
    var x = CENTER + (cos(angle) * length) as i32;
    var y = CENTER + (sin(angle) * length) as i32;
    for d in 0..width {
        var o = d as i32 - width / 2;
        draw_line(&canvas, CENTER + o, CENTER, x + o, y, color);
        draw_line(&canvas, CENTER, CENTER + o, x, y + o, color);
    }
}

fn draw(now: u32) {
    draw_fill(&canvas, 0, 0, SIZE, SIZE + 20, rgb(242, 239, 230));
    // The face: a mark for each hour.
    for h in 0..12 {
        var angle = h * TURN / 12;
        var outer: fixed = 90;
        var inner: fixed = 80;
        if h % 3 == 0 {
            inner = 72;
        }
        var c = cos(angle);
        var s = sin(angle);
        draw_line(&canvas, CENTER + (c * inner) as i32, CENTER + (s * inner) as i32, CENTER + (c * outer) as i32, CENTER + (s * outer) as i32, rgb(30, 30, 36));
    }
    var seconds = now % 86400;
    var hours = seconds / 3600 % 12;
    var minutes = seconds / 60 % 60;
    hand((hours * 60 + minutes) * TURN / 720, 48, 3, rgb(30, 30, 36));
    hand(seconds % 3600 * TURN / 3600, 70, 2, rgb(30, 30, 36));
    hand(seconds % 60 * TURN / 60, 80, 1, rgb(200, 70, 60));
    draw_fill(&canvas, CENTER - 3, CENTER - 3, 6, 6, rgb(45, 90, 80));
    var w: Writer;
    writer_init(&w, STDOUT, text[:]);
    put_date(&w, now);
    draw_text(&canvas, (SIZE - (w.used * 8) as i32) / 2, SIZE, rgb(30, 30, 36), text[0:w.used]);
    present(&canvas);
}
