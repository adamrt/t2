// init is the first program. It starts the shell, and when the shell ends,
// so does Terrarium.

manifest {
    memory = 64 * KiB;
    stack = 16 * KiB;
    allow = "read write spawn window processes recovery";
}

fn main(memory: []u8) -> u32 {
    var screen: ScreenInfo;
    if screen_info(&screen) != FAILED {
        spawn("/bin/launch", "", STDIN, STDOUT, STDERR);
        spawn("/bin/term", "", STDIN, STDOUT, STDERR);
    }
    print("\nWelcome to Terrarium. Type 'help' for help.\n\n");
    var shell = spawn("/bin/sh", "", STDIN, STDOUT, STDERR);
    if shell == FAILED {
        print("init: can't start /bin/sh\n");
        return 1;
    }
    return wait(shell);
}
