// sh, the Terrarium shell. It runs commands typed at the prompt, or the lines
// of a file given as its argument:
//
//     ls /bin | wc > count.txt
//
// Words are separated by spaces, and quotes keep spaces inside a word. "|"
// feeds one command's output to the next, "<" reads input from a file, and
// ">" writes output to one (">>" adds to its end). A line ending in "&"
// runs in the background. A word with "*" in it, outside quotes, becomes the
// names it matches, as in "tc -o all.asm /lib/core.tr *.tr". A line starting
// with "#" is a comment. Programs without a "/" in their name come from /bin.

manifest {
    memory = 256 * KiB;
    stack = 16 * KiB;
    allow = "read write spawn window processes recovery audio network";
}

const MAX_WORDS = 64;
const MAX_STAGES = 8;

struct Stage {
    words: [MAX_WORDS][]u8;
    count: u32;
    input: []u8;
    output: []u8;
    append: bool;
}

var line: [1024]u8;
var text: [8192]u8;             // the words, with quotes removed
var listing: [16384]u8;
var text_used: u32;
var stages: [MAX_STAGES]Stage;
var stage_count: u32;
var read_buffer: [1024]u8;
var finished: bool;
var background: bool;
var records: [32]ProcessInfo;

fn main(memory: []u8) -> u32 {
    var input = STDIN;
    var interactive = true;
    if arg_count() > 0 {
        var name: [256]u8;
        var n = arg(0, name[:]);
        input = open(name[0:min(n, 256)], MODE_READ);
        if input == FAILED {
            complain("sh", "can't read", name[0:min(n, 256)]);
            return 1;
        }
        interactive = false;
    }
    var reader: Reader;
    reader_init(&reader, input, read_buffer[:]);
    var status: u32 = 0;
    while !finished {
        collect_background();
        if interactive {
            prompt();
        }
        var n = read_line(&reader, line[:]);
        if n == FAILED {
            break;
        }
        status = run_line(line[0:n]);
    }
    return status;
}

fn min(a: u32, b: u32) -> u32 {
    if a < b {
        return a;
    }
    return b;
}

// Collects the status of background programs that have ended, so they don't
// linger.
fn collect_background() {
    var n = processes((&records[0] as *u8)[0:size_of(ProcessInfo) * 32]) / size_of(ProcessInfo);
    var me = parent_of_children();
    for i in 0..n {
        if records[i].state == 3 && records[i].parent == me {
            wait(records[i].id);
        }
    }
}

// The shell's own id: the parent of the processes it started.
var my_id: u32;

fn parent_of_children() -> u32 {
    return my_id;
}

fn prompt() {
    var dir: [256]u8;
    var n = get_dir(dir[:]);
    write_all(STDOUT, dir[0:min(n, 256)]);
    write_all(STDOUT, "> ");
}

fn run_line(input: []u8) -> u32 {
    if !parse(input) {
        return 1;
    }
    if stage_count == 0 {
        return 0;
    }
    var first = &stages[0];
    if stage_count == 1 && run_builtin(first) {
        return 0;
    }
    return run_pipeline();
}

// Parsing ------------------------------------------------------------------------

fn is_special(c: u8) -> bool {
    return c == '|' || c == '<' || c == '>';
}

// Splits a line into stages. Returns false, after complaining, if it's malformed.
fn parse(line_text: []u8) -> bool {
    text_used = 0;
    stage_count = 0;
    background = false;
    var input = line_text;
    var end = input.len;
    while end > 0 && input[end - 1] == ' ' {
        end -= 1;
    }
    if end > 0 && input[end - 1] == '&' {
        background = true;
        input = input[0:end - 1];
    }
    var i: u32 = 0;
    while i < input.len && input[i] == ' ' {
        i += 1;
    }
    if i == input.len || input[i] == '#' {
        return true;
    }
    var stage = new_stage();
    while i < input.len {
        var c = input[i];
        if c == ' ' || c == '\t' {
            i += 1;
            continue;
        }
        if c == '|' {
            if stage.count == 0 {
                complain("sh", "missing command before '|'", "");
                return false;
            }
            if stage_count == MAX_STAGES {
                complain("sh", "too many commands in one line", "");
                return false;
            }
            stage = new_stage();
            i += 1;
            continue;
        }
        var redirect = c;
        if c == '<' || c == '>' {
            i += 1;
            if c == '>' && i < input.len && input[i] == '>' {
                stage.append = true;
                i += 1;
            }
            while i < input.len && input[i] == ' ' {
                i += 1;
            }
        }
        var start = text_used;
        var quoted = false;
        while i < input.len && input[i] != ' ' && input[i] != '\t' && !is_special(input[i]) {
            var q = input[i];
            if q == '"' || q == '\'' {
                quoted = true;
                i += 1;
                while i < input.len && input[i] != q {
                    add_text(input[i]);
                    i += 1;
                }
                if i == input.len {
                    complain("sh", "a quote isn't closed", "");
                    return false;
                }
                i += 1;
            } else {
                add_text(q);
                i += 1;
            }
        }
        var word = text[start:text_used];
        if redirect == '<' || redirect == '>' {
            if word.len == 0 {
                complain("sh", "missing file name after", input[i - 1:i]);
                return false;
            }
            if redirect == '<' {
                stage.input = word;
            } else {
                stage.output = word;
            }
            continue;
        }
        if !quoted && has_star(word) && expand(stage, word) {
            continue;
        }
        if stage.count == MAX_WORDS {
            complain("sh", "too many words", "");
            return false;
        }
        stage.words[stage.count] = word;
        stage.count += 1;
    }
    if stage.count == 0 {
        complain("sh", "missing command", "");
        return false;
    }
    return true;
}

fn has_star(word: []u8) -> bool {
    for i in 0..word.len {
        if word[i] == '*' {
            return true;
        }
    }
    return false;
}

// Whether a name fits a pattern, where "*" stands for any run of characters.
fn matches(pattern: []u8, name: []u8) -> bool {
    if pattern.len == 0 {
        return name.len == 0;
    }
    if pattern[0] == '*' {
        for skip in 0..name.len + 1 {
            if matches(pattern[1:], name[skip:]) {
                return true;
            }
        }
        return false;
    }
    return name.len > 0 && pattern[0] == name[0] && matches(pattern[1:], name[1:]);
}

// Adds the names in a directory that fit the pattern, sorted. Returns false
// if none do, so the word stays as it was typed.
fn expand(stage: *Stage, word: []u8) -> bool {
    var slash = word.len;
    while slash > 0 && word[slash - 1] != '/' {
        slash -= 1;
    }
    var dir = word[0:slash];
    var pattern = word[slash:];
    var path = ".";
    if dir.len > 0 {
        path = dir;
    }
    var n = list(path, listing[:]);
    if n == FAILED {
        return false;
    }
    var first = stage.count;
    var i: u32 = 0;
    while i + 64 <= n {
        var e = &listing[i] as *ListEntry;
        var name = entry_name(e);
        i += 64;
        if !matches(pattern, name) || (name.len > 0 && name[0] == '.' && pattern[0] != '.') {
            continue;
        }
        if stage.count == MAX_WORDS || text_used + dir.len + name.len > text.len {
            break;
        }
        var start = text_used;
        for k in 0..dir.len {
            add_text(dir[k]);
        }
        for k in 0..name.len {
            add_text(name[k]);
        }
        stage.words[stage.count] = text[start:text_used];
        stage.count += 1;
    }
    // Sort the new words.
    for a in first + 1..stage.count {
        var b = a;
        while b > first && before(stage.words[b], stage.words[b - 1]) {
            var t = stage.words[b];
            stage.words[b] = stage.words[b - 1];
            stage.words[b - 1] = t;
            b -= 1;
        }
    }
    return stage.count > first;
}

fn before(x: []u8, y: []u8) -> bool {
    for i in 0..x.len {
        if i == y.len {
            return false;
        }
        if x[i] != y[i] {
            return x[i] < y[i];
        }
    }
    return x.len < y.len;
}

fn new_stage() -> *Stage {
    var stage = &stages[stage_count];
    stage_count += 1;
    mem_fill(stage as *u8, 0, size_of(Stage));
    return stage;
}

fn add_text(c: u8) {
    if text_used < text.len {
        text[text_used] = c;
        text_used += 1;
    }
}

// Running --------------------------------------------------------------------------

fn run_builtin(stage: *Stage) -> bool {
    var name = stage.words[0];
    if text_equal(name, "cd") {
        var dir = "/";
        if stage.count > 1 {
            dir = stage.words[1];
        }
        if set_dir(dir) == FAILED {
            complain("cd", "no such directory:", dir);
        }
        return true;
    }
    if text_equal(name, "exit") {
        finished = true;
        return true;
    }
    if text_equal(name, "help") {
        if stage.count > 1 {
            show_notes(stage.words[1]);
            return true;
        }
        print("Commands are programs in /bin:\n  ");
        var buffer: [4096]u8;
        var n = list("/bin", buffer[:]);
        var i: u32 = 0;
        while i + 64 <= n {
            var e = &buffer[i] as *ListEntry;
            print(entry_name(e));
            print(" ");
            i += 64;
        }
        print("\nBuilt in: cd, exit, help. 'help name' explains a program.\n");
        print("'|' connects commands; '<', '>' and '>>' redirect to files.\n");
        return true;
    }
    return false;
}

// Prints the comment at the top of a program's source, which explains it.
fn show_notes(program: []u8) {
    var path: [128]u8;
    var file = FAILED;
    if program.len < 100 {
        copy(path[:], "/src/bin/");
        copy(path[9:], program);
        copy(path[9 + program.len:], ".tr");
        file = open(path[0:program.len + 12], MODE_READ);
    }
    if file == FAILED {
        complain("help", "no notes for", program);
        return;
    }
    var buffer: [1024]u8;
    var reader: Reader;
    reader_init(&reader, file, buffer[:]);
    var line: [256]u8;
    while true {
        var n = read_line(&reader, line[:]);
        if n == FAILED || n < 2 || line[0] != '/' || line[1] != '/' {
            break;
        }
        var text = line[2:n];
        if text.len > 0 && text[0] == ' ' {
            text = text[1:];
        }
        print(text);
        print("\n");
    }
    close(file);
}

fn run_pipeline() -> u32 {
    var ids: [MAX_STAGES]u32;
    var input = STDIN;
    for s in 0..stage_count {
        var stage = &stages[s];
        if stage.input.len > 0 {
            if input != STDIN {
                close(input);
            }
            input = open(stage.input, MODE_READ);
            if input == FAILED {
                complain("sh", "can't read", stage.input);
                return wait_all(ids[0:s]);
            }
        }
        var output = STDOUT;
        var next_input = STDIN;
        if stage.output.len > 0 {
            var mode = MODE_WRITE;
            if stage.append {
                mode = MODE_APPEND;
            }
            output = open(stage.output, mode);
            if output == FAILED {
                complain("sh", "can't write", stage.output);
                output = STDOUT;
            }
        } else if s + 1 < stage_count {
            var write_end: u32;
            next_input = open_pipe(&write_end);
            if next_input == FAILED {
                complain("sh", "can't make a pipe", "");
                next_input = STDIN;
            } else {
                output = write_end;
            }
        }

        ids[s] = start(stage, input, output);
        if ids[s] != FAILED && my_id == 0 {
            learn_my_id(ids[s]);
        }
        if input != STDIN {
            close(input);
        }
        if output != STDOUT {
            close(output);
        }
        input = next_input;
    }
    if background {
        if ids[stage_count - 1] == FAILED {
            return 1;
        }
        var out: Writer;
        var buffer: [64]u8;
        writer_init(&out, STDOUT, buffer[:]);
        put_byte(&out, '[');
        put_u32(&out, ids[stage_count - 1]);
        put(&out, "]\n");
        flush(&out);
        return 0;
    }
    return wait_all(ids[0:stage_count]);
}

// Finds the shell's id from the parent of a process it started.
fn learn_my_id(child: u32) {
    var n = processes((&records[0] as *u8)[0:size_of(ProcessInfo) * 32]) / size_of(ProcessInfo);
    for i in 0..n {
        if records[i].id == child {
            my_id = records[i].parent;
        }
    }
}

// Starts one command. Returns its process id, or FAILED.
fn start(stage: *Stage, input: u32, output: u32) -> u32 {
    var path: [256]u8;
    var name = stage.words[0];
    var n: u32 = 0;
    if find_slash(name) == name.len {
        copy(path[:], "/bin/");
        n = 5;
    }
    if n + name.len > path.len {
        complain("sh", "name is too long", "");
        return FAILED;
    }
    copy(path[n:], name);
    n += name.len;

    var args: [2048]u8;
    var used: u32 = 0;
    for i in 1..stage.count {
        var word = stage.words[i];
        if used + word.len + 1 > args.len {
            complain("sh", "arguments are too long", "");
            return FAILED;
        }
        copy(args[used:], word);
        used += word.len;
        args[used] = 0;
        used += 1;
    }
    var id = spawn(path[0:n], args[0:used], input, output, STDERR);
    if id == FAILED {
        complain("sh", "can't run", name);
    }
    return id;
}

fn find_slash(name: []u8) -> u32 {
    for i in 0..name.len {
        if name[i] == '/' {
            return i;
        }
    }
    return name.len;
}

fn wait_all(ids: []u32) -> u32 {
    var status: u32 = 0;
    for i in 0..ids.len {
        if ids[i] != FAILED {
            status = wait(ids[i]);
        } else {
            status = 1;
        }
    }
    return status;
}
