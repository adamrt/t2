// calc, a calculator. It works in fixed point, so it keeps four decimal
// places and stays between -32768 and 32767. Type the keys or click them.

import gfx
import io
import os
import ui

manifest {
    memory = 128 * KiB
    stack = 16 * KiB
    allow = "window"
}

const KEY_SIZE = 44
const GAP = 6
const WIDTH = 4 * KEY_SIZE + 5 * GAP
const DISPLAY = 40
const HEIGHT = DISPLAY + 5 * KEY_SIZE + 7 * GAP

var canvas gfx.Canvas
var words [2048]u32
var strings [512]u8
var panel ui.Panel
var shown fixed                 // the number on the display
var stored fixed                // the number before the operator
var operator u8
var typing bool                 // digits go on the end of the display
var decimals u32                // digits typed after the point, plus one
var error bool
var display_text [32]u8

fn key_label(row u32, column u32) []u8 {
    var keys = "789/456*123-0.=+"
    var i = row * 4 + column
    return keys[i:i + 1]
}

fn main(memory []u8) u32 {
    var window = gfx.window_open("Calculator", WIDTH, HEIGHT)
    if window == io.FAILED {
        os.complain("calc", "can't open a window", "")
        return 1
    }
    gfx.canvas_init(&canvas, window, words[:], strings[:])
    ui.init(&panel, &canvas)
    while true {
        var e gfx.Event
        gfx.event_wait(&e, gfx.FOREVER)
        if e.kind == gfx.EVENT_CLOSE {
            return 0
        }
        if e.kind == gfx.EVENT_MOUSE_MOVE && panel.active == 0 {
            continue
        }
        ui.event(&panel, &e)
        if panel.typed != 0 && panel.typed < 128 {
            press(panel.typed as u8)
        } else if panel.key == gfx.KEY_BACKSPACE || panel.key == gfx.KEY_ESCAPE {
            press('C')
        }
        draw()
        ui.end(&panel)
        gfx.present(&canvas)
    }
    return 0
}

fn press(c u8) {
    if c == 'c' || c == 'C' {
        shown = 0
        stored = 0
        operator = 0
        typing = false
        decimals = 0
        error = false
        return
    }
    if error {
        return
    }
    if c >= '0' && c <= '9' {
        if !typing {
            shown = 0
            typing = true
            decimals = 0
        }
        var digit = (c - '0') as fixed
        if decimals == 0 {
            if shown < 3276 {
                shown = shown * 10 + digit
            }
        } else if decimals < 5 {
            var place fixed = 1
            for i in 0..decimals {
                place = place / 10
            }
            shown = shown + digit * place
            decimals += 1
        }
        return
    }
    if c == '.' {
        if !typing {
            shown = 0
            typing = true
        }
        if decimals == 0 {
            decimals = 1
        }
        return
    }
    if c == '+' || c == '-' || c == '*' || c == '/' || c == '=' {
        if operator != 0 && (typing || c == '=') {
            shown = apply(stored, operator, shown)
        }
        stored = shown
        if c == '=' {
            operator = 0
        } else {
            operator = c
        }
        typing = false
    }
}

fn apply(a fixed, op u8, b fixed) fixed {
    if op == '+' {
        return a + b
    }
    if op == '-' {
        return a - b
    }
    if op == '*' {
        return a * b
    }
    if b == 0 {
        error = true
        return 0
    }
    return a / b
}

// Writes a fixed-point number with up to four decimal places.
fn format_fixed(value fixed) []u8 {
    var w io.Writer
    io.writer_init(&w, io.STDOUT, display_text[:])
    var v = value
    if v < 0 {
        io.put_byte(&w, '-')
        v = -v
    }
    var whole = v as i32
    io.put_u32(&w, whole as u32)
    // Round the fraction to four places.
    var fraction = ((v - whole as fixed) * 10000 + 0.5) as i32
    if fraction >= 10000 {
        fraction = 9999
    }
    if fraction > 0 {
        io.put_byte(&w, '.')
        var digits [4]u8
        var f = fraction as u32
        var i u32 = 4
        while i > 0 {
            i -= 1
            digits[i] = (f % 10 + '0') as u8
            f /= 10
        }
        var end u32 = 4
        while end > 1 && digits[end - 1] == '0' {
            end -= 1
        }
        io.put(&w, digits[0:end])
    }
    return display_text[0:w.used]
}

fn draw() {
    gfx.draw_fill(&canvas, 0, 0, WIDTH, HEIGHT, ui.FACE)
    ui.sunken(&canvas, GAP, GAP, WIDTH - 2 * GAP, DISPLAY - GAP)
    var text = "error"
    if !error {
        text = format_fixed(shown)
    }
    var x = WIDTH - GAP - 8 - (text.len * 16) as i32
    gfx.draw_text_scaled(&canvas, x, GAP + 2, ui.BLACK, text, 2)
    for row in 0..4 {
        for column in 0..4 {
            var label = key_label(row, column)
            var kx = GAP + (column * (KEY_SIZE + GAP)) as i32
            var ky = DISPLAY + GAP + (row * (KEY_SIZE + GAP)) as i32
            var id = row * 4 + column + 1
            // = is the default button, which Enter presses.
            var hit = false
            if label[0] == '=' {
                hit = ui.default_button(&panel, id, kx + 2, ky + 2, KEY_SIZE - 4, KEY_SIZE - 4, label)
            } else {
                hit = ui.button(&panel, id, kx, ky, KEY_SIZE, KEY_SIZE, label)
            }
            if hit {
                press(label[0])
            }
        }
    }
    var cy = DISPLAY + GAP + (4 * (KEY_SIZE + GAP)) as i32
    if ui.button(&panel, 100, GAP, cy, WIDTH - 2 * GAP, KEY_SIZE, "Clear") {
        press('C')
    }
}
