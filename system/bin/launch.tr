// launch, a window of buttons that start programs.

manifest {
    memory = 128 * KiB;
    stack = 16 * KiB;
    allow = "read write spawn window processes audio network";
}

const WIDTH = 150;
const BUTTON = 26;
const COUNT = 9;

var canvas: Canvas;
var words: [512]u32;
var strings: [512]u8;
var pressed: i32;

fn label(i: u32) -> []u8 {
    match i {
        0 => { return "Terminal"; }
        1 => { return "Files"; }
        2 => { return "Editor"; }
        3 => { return "Monitor"; }
        4 => { return "Cube"; }
        5 => { return "Fractal"; }
        6 => { return "Piano"; }
        7 => { return "Worm"; }
    }
    return "GPU demo";
}

fn program(i: u32) -> []u8 {
    match i {
        0 => { return "/bin/term"; }
        1 => { return "/bin/files"; }
        2 => { return "/bin/edit"; }
        3 => { return "/bin/monitor"; }
        4 => { return "/bin/cube"; }
        5 => { return "/bin/fractal"; }
        6 => { return "/bin/piano"; }
        7 => { return "/bin/worm"; }
    }
    return "/bin/demo";
}

fn main(memory: []u8) -> u32 {
    var window = window_open("Programs", WIDTH, COUNT * BUTTON + 8);
    if window == FAILED {
        complain("launch", "can't open a window", "");
        return 1;
    }
    canvas_init(&canvas, window, words[:], strings[:]);
    pressed = -1;
    while true {
        var e: Event;
        event_wait(&e, FOREVER);
        if e.kind == EVENT_CLOSE {
            return 0;
        }
        if e.kind == EVENT_MOUSE_DOWN {
            pressed = (e.y - 4) / BUTTON;
            if pressed < 0 || pressed >= COUNT {
                pressed = -1;
            }
        } else if e.kind == EVENT_MOUSE_UP {
            var over = (e.y - 4) / BUTTON;
            if pressed >= 0 && over == pressed {
                spawn(program(pressed as u32), "", STDIN, STDOUT, STDERR);
            }
            pressed = -1;
        } else if e.kind != EVENT_DRAW {
            continue;
        }
        draw();
    }
    return 0;
}

fn draw() {
    draw_fill(&canvas, 0, 0, WIDTH, COUNT * BUTTON + 8, rgb(242, 239, 230));
    for i in 0..COUNT {
        var y = 4 + (i * BUTTON) as i32;
        var face = rgb(224, 219, 206);
        if pressed == i as i32 {
            face = rgb(232, 195, 90);
        }
        draw_fill(&canvas, 6, y + 2, WIDTH - 12, BUTTON - 4, rgb(30, 30, 36));
        draw_fill(&canvas, 7, y + 3, WIDTH - 14, BUTTON - 6, face);
        draw_text(&canvas, 16, y + 5, rgb(30, 30, 36), label(i));
    }
    present(&canvas);
}
