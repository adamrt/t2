// launch, a window of buttons that start programs.

manifest {
    memory = 128 * KiB;
    stack = 16 * KiB;
    allow = "read write spawn window processes audio network";
}

const WIDTH = 150;
const BUTTON = 26;
const COUNT = 10;

var canvas: Canvas;
var words: [1024]u32;
var strings: [512]u8;
var ui: Ui;

fn label(i: u32) -> []u8 {
    match i {
        0 => { return "Terminal"; }
        1 => { return "Files"; }
        2 => { return "Editor"; }
        3 => { return "Monitor"; }
        4 => { return "Calculator"; }
        5 => { return "Cube"; }
        6 => { return "Fractal"; }
        7 => { return "Piano"; }
        8 => { return "Worm"; }
    }
    return "GPU demo";
}

fn program(i: u32) -> []u8 {
    match i {
        0 => { return "/bin/term"; }
        1 => { return "/bin/files"; }
        2 => { return "/bin/edit"; }
        3 => { return "/bin/monitor"; }
        4 => { return "/bin/calc"; }
        5 => { return "/bin/cube"; }
        6 => { return "/bin/fractal"; }
        7 => { return "/bin/piano"; }
        8 => { return "/bin/worm"; }
    }
    return "/bin/demo";
}

fn main(memory: []u8) -> u32 {
    var window = window_open("Programs", WIDTH, COUNT * BUTTON + 8);
    if window == FAILED {
        complain("launch", "can't open a window", "");
        return 1;
    }
    canvas_init(&canvas, window, words[:], strings[:]);
    ui_init(&ui, &canvas);
    while true {
        var e: Event;
        event_wait(&e, FOREVER);
        if e.kind == EVENT_CLOSE {
            return 0;
        }
        if e.kind == EVENT_MOUSE_MOVE && ui.active == 0 {
            continue;
        }
        ui_event(&ui, &e);
        draw_fill(&canvas, 0, 0, WIDTH, COUNT * BUTTON + 8, UI_BACKGROUND);
        for i in 0..COUNT {
            var y = 4 + (i * BUTTON) as i32;
            if ui_button(&ui, i + 1, 6, y + 2, WIDTH - 12, BUTTON - 4, label(i)) {
                spawn(program(i), "", STDIN, STDOUT, STDERR);
            }
        }
        ui_end(&ui);
        present(&canvas);
    }
    return 0;
}
