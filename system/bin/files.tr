// files, a file browser. Click a directory to open it, or ".." to go up.
// Clicking a file opens it: pictures (.tim) in view, sounds (.tsn) in play,
// anything else in edit. The scroll bar or the wheel moves through a long
// directory, and the grow box in the window's corner resizes it.

import gfx
import io
import mem
import os
import text
import ui

manifest {
    memory = 256 * KiB
    stack = 32 * KiB
    allow = "read spawn window audio"
}

const WIDTH = 360
const ROWS = 22
const ROW = 18
const HEADER = 24                   // the bar with the directory's path
const GROW = 15                     // the window's grow box, in its corner
const MAX = 256

var canvas gfx.Canvas
var panel ui.Panel
var words [2048]u32
var strings [4096]u8
var listing [MAX * 64]u8
var entries []os.ListEntry
var count u32
var dir [256]u8
var dir_len u32
var top u32
var full_path [512]u8
var width i32
var height i32
var rows u32

fn main(memory []u8) u32 {
    width = WIDTH
    height = HEADER + ROWS * ROW + 4
    rows = ROWS
    var window = gfx.window_open("Files", width as u32, height as u32)
    if window == io.FAILED {
        os.complain("files", "can't open a window", "")
        return 1
    }
    gfx.window_resizable(window, 200, HEADER + 4 * ROW + 4)
    gfx.canvas_init(&canvas, window, words[:], strings[:])
    ui.init(&panel, &canvas)
    dir_len = min(os.get_dir(dir[:]), dir.len)
    load()
    while true {
        var e gfx.Event
        gfx.event_wait(&e, gfx.FOREVER)
        if e.kind == gfx.EVENT_CLOSE {
            return 0
        }
        if e.kind == gfx.EVENT_MOUSE_MOVE && panel.active == 0 {
            continue
        }
        if e.kind == gfx.EVENT_RESIZE {
            width = e.x
            height = e.y
            rows = ((height - HEADER - 4) / ROW) as u32
        } else if e.kind == gfx.EVENT_WHEEL {
            if e.y > 0 && top + rows < count + 1 {
                top += 1
            } else if e.y < 0 && top > 0 {
                top -= 1
            }
        }
        ui.event(&panel, &e)
        // A press in the list opens what's under it.
        var list_w = width - ui.SCROLL_WIDTH + 1
        if panel.pressed && panel.mouse_x < list_w && panel.mouse_y >= HEADER {
            var row = (panel.mouse_y - HEADER - 2) / ROW
            if row >= 0 && (row as u32) < rows {
                click(top + row as u32)
            }
        }
        draw()
        ui.end(&panel)
        gfx.present(&canvas)
    }
    return 0
}

fn min(a u32, b u32) u32 {
    if a < b {
        return a
    }
    return b
}

fn load() {
    var n = os.list(dir[0:dir_len], listing[:])
    if n == io.FAILED {
        n = 0
    }
    count = n / 64
    entries = (&listing[0] as *os.ListEntry)[0:count]
    // Directories first, then by name.
    for i in 1..count {
        var j = i
        while j > 0 && before(&entries[j], &entries[j - 1]) {
            var swap = entries[j]
            entries[j] = entries[j - 1]
            entries[j - 1] = swap
            j -= 1
        }
    }
    top = 0
}

fn before(a *os.ListEntry, b *os.ListEntry) bool {
    if a.kind != b.kind {
        return a.kind == os.KIND_DIR
    }
    var x = os.entry_name(a)
    var y = os.entry_name(b)
    for i in 0..x.len {
        if i == y.len {
            return false
        }
        if x[i] != y[i] {
            return x[i] < y[i]
        }
    }
    return x.len < y.len
}

// Row 0 is "..", and the entries follow.
fn click(row u32) {
    if row == 0 {
        while dir_len > 1 && dir[dir_len - 1] != '/' {
            dir_len -= 1
        }
        if dir_len > 1 {
            dir_len -= 1
        }
        load()
        return
    }
    if row > count {
        return
    }
    var e = &entries[row - 1]
    var name = os.entry_name(e)
    var n u32 = 0
    mem.copy(full_path[:], dir[0:dir_len])
    n = dir_len
    if n > 1 {
        full_path[n] = '/'
        n += 1
    }
    mem.copy(full_path[n:], name)
    n += name.len
    if e.kind == os.KIND_DIR {
        mem.copy(dir[:], full_path[0:n])
        dir_len = n
        load()
        return
    }
    var args [512]u8
    mem.copy(args[:], full_path[0:n])
    args[n] = 0
    var program = "/bin/edit"
    if name.len > 4 && text.equal(name[name.len - 4:], ".tim") {
        program = "/bin/view"
    } else if name.len > 4 && text.equal(name[name.len - 4:], ".tsn") {
        program = "/bin/play"
    }
    os.spawn(program, args[0:n + 1], io.STDIN, io.STDOUT, io.STDERR)
}

fn draw() {
    var list_w = width - ui.SCROLL_WIDTH + 1
    gfx.draw_fill(&canvas, 0, 0, width, HEADER, ui.FACE)
    gfx.draw_fill(&canvas, 0, 0, width, 1, ui.WHITE)
    gfx.draw_fill(&canvas, 0, HEADER - 1, width, 1, ui.BLACK)
    ui.bold_label(&panel, 8, 4, dir[0:dir_len])
    gfx.draw_fill(&canvas, 0, HEADER, list_w, height - HEADER, ui.WHITE)
    for row in 0..rows {
        var n = top + row
        var y = HEADER + 2 + (row * ROW) as i32
        if n == 0 {
            folder(8, y + 2)
            ui.bold_label(&panel, 28, y, "..")
            continue
        }
        if n > count {
            break
        }
        var e = &entries[n - 1]
        if e.kind == os.KIND_DIR {
            folder(8, y + 2)
            ui.bold_label(&panel, 28, y, os.entry_name(e))
        } else {
            page(8, y + 1)
            ui.label(&panel, 28, y, os.entry_name(e))
            var digits [12]u8
            var w io.Writer
            io.writer_init(&w, io.STDOUT, digits[:])
            io.put_u32(&w, e.size)
            ui.dim_label(&panel, list_w - 10 - (w.used * 8) as i32, y, digits[0:w.used])
        }
    }
    // The scroll bar runs from under the path to the grow box.
    var bar_h = height - HEADER + 1 - (GROW - 1)
    ui.scrollbar(&panel, 1, list_w - 1, HEADER - 1, bar_h, &top, count + 1, rows)
}

// A folder, 14 by 11 pixels: a tab on top of a box.
fn folder(x i32, y i32) {
    ui.outline(&canvas, x, y, 6, 3, ui.BLACK)
    ui.outline(&canvas, x, y + 2, 14, 9, ui.BLACK)
    gfx.draw_fill(&canvas, x + 1, y + 1, 4, 2, ui.FACE)
    gfx.draw_fill(&canvas, x + 1, y + 3, 12, 7, ui.FACE)
    gfx.draw_fill(&canvas, x + 1, y + 3, 12, 1, ui.WHITE)
}

// A page, 10 by 13 pixels, with its top right corner turned down.
fn page(x i32, y i32) {
    gfx.draw_fill(&canvas, x, y, 7, 1, ui.BLACK)
    gfx.draw_fill(&canvas, x, y + 1, 1, 12, ui.BLACK)
    gfx.draw_fill(&canvas, x, y + 12, 10, 1, ui.BLACK)
    gfx.draw_fill(&canvas, x + 9, y + 3, 1, 9, ui.BLACK)
    gfx.draw_line(&canvas, x + 6, y, x + 9, y + 3, ui.BLACK)
    gfx.draw_fill(&canvas, x + 6, y + 1, 1, 3, ui.BLACK)
    gfx.draw_fill(&canvas, x + 6, y + 3, 3, 1, ui.BLACK)
}
