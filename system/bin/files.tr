// files, a file browser. Click a directory to open it, or ".." to go up.
// Clicking a file opens it: pictures (.tim) in view, sounds (.tsn) in play,
// anything else in edit. Dragging the strip under the window resizes it.

manifest {
    memory = 256 * KiB;
    stack = 32 * KiB;
    allow = "read spawn window audio";
}

const WIDTH = 360;
const ROWS = 22;
const ROW = 18;
const MAX = 256;

var canvas: Canvas;
var words: [2048]u32;
var strings: [4096]u8;
var listing: [MAX * 64]u8;
var entries: []ListEntry;
var count: u32;
var dir: [256]u8;
var dir_len: u32;
var top: u32;
var full_path: [512]u8;
var width: i32;
var height: i32;
var rows: u32;

fn main(memory: []u8) -> u32 {
    width = WIDTH;
    height = ROWS * ROW + 28;
    rows = ROWS;
    var window = window_open("Files", width as u32, height as u32);
    if window == FAILED {
        complain("files", "can't open a window", "");
        return 1;
    }
    window_resizable(window, 200, 4 * ROW + 28);
    canvas_init(&canvas, window, words[:], strings[:]);
    dir_len = min(get_dir(dir[:]), dir.len);
    load();
    while true {
        var e: Event;
        event_wait(&e, FOREVER);
        if e.kind == EVENT_CLOSE {
            return 0;
        }
        if e.kind == EVENT_RESIZE {
            width = e.x;
            height = e.y;
            rows = ((height - 28) / ROW) as u32;
        } else if e.kind == EVENT_MOUSE_DOWN {
            var row = (e.y - 24) / ROW;
            if row >= 0 && (row as u32) < rows {
                click(top + row as u32);
            }
        } else if e.kind == EVENT_WHEEL {
            if e.y > 0 && top + rows < count + 1 {
                top += 1;
            } else if e.y < 0 && top > 0 {
                top -= 1;
            }
        } else if e.kind != EVENT_DRAW {
            continue;
        }
        draw();
    }
    return 0;
}

fn min(a: u32, b: u32) -> u32 {
    if a < b {
        return a;
    }
    return b;
}

fn load() {
    var n = list(dir[0:dir_len], listing[:]);
    if n == FAILED {
        n = 0;
    }
    count = n / 64;
    entries = (&listing[0] as *ListEntry)[0:count];
    // Directories first, then by name.
    for i in 1..count {
        var j = i;
        while j > 0 && before(&entries[j], &entries[j - 1]) {
            var swap = entries[j];
            entries[j] = entries[j - 1];
            entries[j - 1] = swap;
            j -= 1;
        }
    }
    top = 0;
}

fn before(a: *ListEntry, b: *ListEntry) -> bool {
    if a.kind != b.kind {
        return a.kind == KIND_DIR;
    }
    var x = entry_name(a);
    var y = entry_name(b);
    for i in 0..x.len {
        if i == y.len {
            return false;
        }
        if x[i] != y[i] {
            return x[i] < y[i];
        }
    }
    return x.len < y.len;
}

// Row 0 is "..", and the entries follow.
fn click(row: u32) {
    if row == 0 {
        while dir_len > 1 && dir[dir_len - 1] != '/' {
            dir_len -= 1;
        }
        if dir_len > 1 {
            dir_len -= 1;
        }
        load();
        return;
    }
    if row > count {
        return;
    }
    var e = &entries[row - 1];
    var name = entry_name(e);
    var n: u32 = 0;
    copy(full_path[:], dir[0:dir_len]);
    n = dir_len;
    if n > 1 {
        full_path[n] = '/';
        n += 1;
    }
    copy(full_path[n:], name);
    n += name.len;
    if e.kind == KIND_DIR {
        copy(dir[:], full_path[0:n]);
        dir_len = n;
        load();
        return;
    }
    var args: [512]u8;
    copy(args[:], full_path[0:n]);
    args[n] = 0;
    var program = "/bin/edit";
    if name.len > 4 && text_equal(name[name.len - 4:], ".tim") {
        program = "/bin/view";
    } else if name.len > 4 && text_equal(name[name.len - 4:], ".tsn") {
        program = "/bin/play";
    }
    spawn(program, args[0:n + 1], STDIN, STDOUT, STDERR);
}

fn draw() {
    draw_fill(&canvas, 0, 0, width, height, rgb(242, 239, 230));
    draw_fill(&canvas, 0, 0, width, 22, rgb(224, 219, 206));
    draw_text(&canvas, 8, 3, rgb(30, 30, 36), dir[0:dir_len]);
    for row in 0..rows {
        var n = top + row;
        var y = 24 + (row * ROW) as i32;
        if n == 0 {
            draw_text(&canvas, 8, y, rgb(45, 90, 80), "..");
            continue;
        }
        if n > count {
            break;
        }
        var e = &entries[n - 1];
        if e.kind == KIND_DIR {
            draw_text(&canvas, 8, y, rgb(45, 90, 80), entry_name(e));
            draw_text(&canvas, 8 + char_count(entry_name(e)) as i32 * 8, y, rgb(45, 90, 80), "/");
        } else {
            draw_text(&canvas, 8, y, rgb(30, 30, 36), entry_name(e));
            var digits: [12]u8;
            var w: Writer;
            writer_init(&w, STDOUT, digits[:]);
            put_u32(&w, e.size);
            draw_text(&canvas, width - 12 - (w.used * 8) as i32, y, rgb(120, 116, 106), digits[0:w.used]);
        }
    }
    present(&canvas);
}
