// term, a terminal: a window with a shell in it. What you type is edited
// here a line at a time, drawn after whatever the shell has printed, and
// sent to the shell when you press Enter. Up and Down bring back earlier
// lines, Ctrl-C stops whatever the shell is running, and dragging the strip
// under the window resizes it.

manifest {
    memory = 512 * KiB;
    stack = 32 * KiB;
    allow = "read write spawn window processes recovery audio network";
}

const MAX_COLUMNS = 160;
const MAX_ROWS = 64;
const MARGIN = 4;
const BACKGROUND: u32 = 0xff1b1d23;
const FOREGROUND: u32 = 0xffd8d4c8;
const CURSOR: u32 = 0xffe8c35a;

// Each row of text takes MAX_COLUMNS bytes, however wide the window is.
var cells: [MAX_ROWS * MAX_COLUMNS]u8;
var columns: u32;
var rows: u32;
var width: i32;
var height: i32;
var cursor_x: u32;
var cursor_y: u32;
var typed: [256]u8;
var typed_len: u32;
var canvas: Canvas;
var strings: [8192]u8;
var words: [4096]u32;
var buffer: [4096]u8;
var font_width: i32;
var font_height: i32;
var to_shell: u32;
var from_shell: u32;
var shell: u32;
var history: [16][256]u8;
var history_len: [16]u32;
var history_count: u32;
var history_at: u32;                // which line Up and Down have reached
var records: [32]ProcessInfo;

fn main(memory: []u8) -> u32 {
    var screen: ScreenInfo;
    if screen_info(&screen) == FAILED {
        complain("term", "there is no screen", "");
        return 1;
    }
    font_width = screen.font_width as i32;
    font_height = screen.font_height as i32;
    columns = 80;
    rows = 30;
    width = columns as i32 * font_width + 2 * MARGIN;
    height = rows as i32 * font_height + 2 * MARGIN;
    var window = window_open("Terminal", width as u32, height as u32);
    if window == FAILED {
        complain("term", "can't open a window", "");
        return 1;
    }
    window_resizable(window, 20 * screen.font_width + 2 * MARGIN, 4 * screen.font_height + 2 * MARGIN);
    canvas_init(&canvas, window, words[:], strings[:]);
    mem_fill(&cells[0], ' ', cells.len);

    var shell_input: u32;
    var shell_output: u32;
    var input_end = open_pipe(&to_shell);
    from_shell = open_pipe(&shell_output);
    shell_input = input_end;
    shell = spawn("/bin/sh", "", shell_input, shell_output, shell_output);
    close(shell_input);
    close(shell_output);
    if shell == FAILED {
        complain("term", "can't start /bin/sh", "");
        return 1;
    }

    while true {
        var changed = false;
        while true {
            var n = available(from_shell);
            if n == FAILED {
                return 0;
            }
            if n == 0 {
                break;
            }
            var got = read(from_shell, buffer[0:min(n, buffer.len)]);
            for i in 0..got {
                put_char(buffer[i]);
            }
            changed = true;
        }
        var e: Event;
        if event_wait(&e, 20) == 1 {
            if e.kind == EVENT_CLOSE {
                kill(shell);
                return 0;
            }
            if e.kind == EVENT_RESIZE {
                resize(e.x, e.y);
            }
            if e.kind == EVENT_DRAW || handle_key(&e) {
                changed = true;
            }
        }
        if changed {
            draw();
        }
    }
    return 0;
}

fn min(a: u32, b: u32) -> u32 {
    if a < b {
        return a;
    }
    return b;
}

// Returns true if the screen changed.
fn handle_key(e: *Event) -> bool {
    if e.kind == EVENT_TEXT {
        if typed_len + 1 < typed.len {
            typed[typed_len] = e.key as u8;
            typed_len += 1;
        }
        return true;
    }
    if e.kind != EVENT_KEY_DOWN {
        return false;
    }
    if (e.modifiers & MOD_CTRL) != 0 && e.key == 'c' {
        stop_programs();
        typed_len = 0;
        return true;
    }
    if (e.modifiers & (MOD_CTRL | MOD_SUPER)) != 0 && e.key == 'v' {
        paste();
        return true;
    }
    if e.key == KEY_UP || e.key == KEY_DOWN {
        recall(e.key == KEY_UP);
        return true;
    }
    if e.key == KEY_ENTER {
        remember();
        typed[typed_len] = '\n';
        typed_len += 1;
        for i in 0..typed_len {
            put_char(typed[i]);
        }
        write_all(to_shell, typed[0:typed_len]);
        typed_len = 0;
        return true;
    }
    if e.key == KEY_BACKSPACE && typed_len > 0 {
        typed_len -= 1;
        return true;
    }
    return false;
}

// Adds the clipboard to the typed line, up to its first line break.
fn paste() {
    var text: [256]u8;
    var n = min(clipboard_get(text[:]), text.len);
    for i in 0..n {
        if text[i] == '\n' || typed_len + 1 >= typed.len {
            return;
        }
        if text[i] >= 32 && text[i] < 127 {
            typed[typed_len] = text[i];
            typed_len += 1;
        }
    }
}

// Keeps the typed line, unless it's empty or the same as the last one.
fn remember() {
    if typed_len == 0 {
        return;
    }
    if history_count > 0 {
        var last = (history_count - 1) % 16;
        if history_len[last] == typed_len && text_equal(history[last][0:typed_len], typed[0:typed_len]) {
            history_at = history_count;
            return;
        }
    }
    var slot = history_count % 16;
    copy(history[slot][:], typed[0:typed_len]);
    history_len[slot] = typed_len;
    history_count += 1;
    history_at = history_count;
}

fn recall(older: bool) {
    var oldest: u32 = 0;
    if history_count > 16 {
        oldest = history_count - 16;
    }
    if older && history_at > oldest {
        history_at -= 1;
    } else if !older && history_at < history_count {
        history_at += 1;
    }
    if history_at == history_count {
        typed_len = 0;
        return;
    }
    var slot = history_at % 16;
    typed_len = history_len[slot];
    copy(typed[:], history[slot][0:typed_len]);
}

// Stops every program the shell started.
fn stop_programs() {
    var n = processes((&records[0] as *u8)[0:size_of(ProcessInfo) * 32]) / size_of(ProcessInfo);
    for i in 0..n {
        if records[i].parent == shell && records[i].state != 3 {
            kill(records[i].id);
        }
    }
    put_char('^');
    put_char('C');
    put_char('\n');
}

// Fits the text to a new window size, scrolling up if the cursor would be
// below the bottom.
fn resize(new_width: i32, new_height: i32) {
    width = new_width;
    height = new_height;
    columns = min(((width - 2 * MARGIN) / font_width) as u32, MAX_COLUMNS);
    rows = min(((height - 2 * MARGIN) / font_height) as u32, MAX_ROWS);
    while cursor_y >= rows {
        scroll();
        cursor_y -= 1;
    }
    if cursor_x > columns {
        cursor_x = columns;
    }
}

fn scroll() {
    copy(cells[:], cells[MAX_COLUMNS:]);
    mem_fill(&cells[(MAX_ROWS - 1) * MAX_COLUMNS], ' ', MAX_COLUMNS);
}

fn put_char(c: u8) {
    if c == '\n' {
        cursor_x = 0;
        new_line();
        return;
    }
    if c == '\t' {
        put_char(' ');
        while cursor_x % 8 != 0 {
            put_char(' ');
        }
        return;
    }
    if c < 32 || c > 126 {
        return;
    }
    if cursor_x >= columns {
        cursor_x = 0;
        new_line();
    }
    cells[cursor_y * MAX_COLUMNS + cursor_x] = c;
    cursor_x += 1;
}

fn new_line() {
    if cursor_y + 1 < rows {
        cursor_y += 1;
        return;
    }
    // Clear what's below the visible rows, then move everything up one.
    for r in rows..MAX_ROWS {
        mem_fill(&cells[r * MAX_COLUMNS], ' ', MAX_COLUMNS);
    }
    scroll();
}

fn draw() {
    draw_fill(&canvas, 0, 0, width, height, BACKGROUND);
    for row in 0..rows {
        var line = cells[row * MAX_COLUMNS:row * MAX_COLUMNS + columns];
        var end = columns;
        while end > 0 && line[end - 1] == ' ' {
            end -= 1;
        }
        if end > 0 {
            draw_text(&canvas, MARGIN, MARGIN + row as i32 * font_height, FOREGROUND, line[0:end]);
        }
    }
    var x = MARGIN + cursor_x as i32 * font_width;
    var y = MARGIN + cursor_y as i32 * font_height;
    draw_text(&canvas, x, y, FOREGROUND, typed[0:typed_len]);
    x += typed_len as i32 * font_width;
    draw_fill(&canvas, x, y, font_width, font_height, CURSOR);
    present(&canvas);
}
