// paint, a pixel-art editor. Pick a color on the right and draw with the
// mouse; Fill floods an area with the color. Save writes the picture as a
// TIM1 image, which view can show.
//
//     paint [picture.tim]

import gfx
import image
import io
import mem
import os
import ui

manifest {
    memory = 2 * MiB
    stack = 64 * KiB
    allow = "read write window"
}

const W = 160                   // the picture, in pixels
const H = 120
const ZOOM = 3                  // screen pixels per picture pixel
const SIDE = 64                 // the palette and buttons beside it
const WIDTH = W * ZOOM + SIDE
const HEIGHT = H * ZOOM
const SWATCH = 24

var picture [W * H]u32
var zoomed [W * ZOOM * H * ZOOM]u32
var view_image gfx.Image
var palette [16]u32
var color u32
var filling bool
var drawing bool
var last_x i32                  // the picture pixel the pen was last on
var last_y i32
var canvas gfx.Canvas
var words [2048]u32
var strings [512]u8
var panel ui.Panel
var path [256]u8
var path_len u32
var message []u8
var stack_x [W * H]u16
var stack_y [W * H]u16
var scratch [32 * KiB]u8
var offsets [64]u32
var file_bytes [128 * KiB]u8

fn main(memory []u8) u32 {
    var colors = "000000ffffff1e1e24e8c35a2d5a50dc4646508ce85ac878f2efe6a0522db464c8f0a03c8c8c8c46464646c8c8f0f050"
    for i in 0..16 {
        palette[i] = 0xff000000 | hex(colors[i * 6:i * 6 + 6])
    }
    for i in 0..picture.len {
        picture[i] = palette[1]
    }
    color = 0
    if os.arg_count() > 0 {
        path_len = min(os.arg(0, path[:]), path.len)
        load()
    }
    view_image.width = W * ZOOM
    view_image.height = H * ZOOM
    view_image.pixels = zoomed[:]
    for y in 0..H {
        for x in 0..W {
            show_pixel(x, y)
        }
    }
    var window = gfx.window_open("Paint", WIDTH, HEIGHT)
    if window == io.FAILED {
        os.complain("paint", "can't open a window", "")
        return 1
    }
    gfx.canvas_init(&canvas, window, words[:], strings[:])
    ui.init(&panel, &canvas)
    while true {
        var e gfx.Event
        gfx.event_wait(&e, gfx.FOREVER)
        if e.kind == gfx.EVENT_CLOSE {
            return 0
        }
        ui.event(&panel, &e)
        if e.kind == gfx.EVENT_MOUSE_DOWN && e.x < W * ZOOM {
            if filling {
                flood((e.x / ZOOM) as u32, (e.y / ZOOM) as u32)
            } else {
                drawing = true
                last_x = e.x / ZOOM
                last_y = e.y / ZOOM
                stroke(e.x, e.y)
            }
        } else if e.kind == gfx.EVENT_MOUSE_MOVE && drawing {
            stroke(e.x, e.y)
        } else if e.kind == gfx.EVENT_MOUSE_UP {
            drawing = false
        } else if e.kind == gfx.EVENT_KEY_DOWN && (e.modifiers & (gfx.MOD_CTRL | gfx.MOD_SUPER)) != 0 && e.key == 's' {
            save()
        }
        draw()
        ui.end(&panel)
    }
    return 0
}

fn min(a u32, b u32) u32 {
    if a < b {
        return a
    }
    return b
}

fn hex(text []u8) u32 {
    var v u32 = 0
    for i in 0..text.len {
        var c = text[i]
        var d u32 = c - '0'
        if c >= 'a' {
            d = c - 'a' + 10
        }
        v = v * 16 + d
    }
    return v
}

// Copies a picture pixel into the zoomed image on screen.
fn show_pixel(x u32, y u32) {
    var p = picture[y * W + x]
    for dy in 0..ZOOM {
        var row = (y * ZOOM + dy) * W * ZOOM + x * ZOOM
        for dx in 0..ZOOM {
            zoomed[row + dx] = p
        }
    }
}

fn plot(x i32, y i32) {
    if x < 0 || y < 0 || x >= W || y >= H {
        return
    }
    picture[(y * W + x) as u32] = palette[color]
    show_pixel(x as u32, y as u32)
}

// Draws from the pen's last pixel to the one under the mouse, so a quick
// stroke has no gaps.
fn stroke(sx i32, sy i32) {
    var x1 = sx / ZOOM
    var y1 = sy / ZOOM
    var dx = x1 - last_x
    var dy = y1 - last_y
    var steps = dx
    if steps < 0 {
        steps = -steps
    }
    var ady = dy
    if ady < 0 {
        ady = -ady
    }
    if ady > steps {
        steps = ady
    }
    for i in 0..steps as u32 + 1 {
        var t = i as i32
        if steps == 0 {
            plot(x1, y1)
        } else {
            plot(last_x + dx * t / steps, last_y + dy * t / steps)
        }
    }
    last_x = x1
    last_y = y1
}

// Fills the area of one color around a pixel, with a stack instead of
// recursion so it can't run out of stack.
fn flood(x0 u32, y0 u32) {
    var old = picture[y0 * W + x0]
    var new_color = palette[color]
    if old == new_color {
        return
    }
    var top u32 = 0
    stack_x[0] = x0 as u16
    stack_y[0] = y0 as u16
    top = 1
    picture[y0 * W + x0] = new_color
    while top > 0 {
        top -= 1
        var x u32 = stack_x[top]
        var y u32 = stack_y[top]
        show_pixel(x, y)
        for d in 0..4 {
            var nx = x
            var ny = y
            if d == 0 && x > 0 { nx = x - 1 }
            if d == 1 && x + 1 < W { nx = x + 1 }
            if d == 2 && y > 0 { ny = y - 1 }
            if d == 3 && y + 1 < H { ny = y + 1 }
            if picture[ny * W + nx] == old {
                picture[ny * W + nx] = new_color
                stack_x[top] = nx as u16
                stack_y[top] = ny as u16
                top += 1
            }
        }
    }
}

fn load() {
    var file = io.open(path[0:path_len], io.MODE_READ)
    if file == io.FAILED {
        message = "new picture"
        return
    }
    var n = io.read(file, file_bytes[:])
    io.close(file)
    var h image.Header
    if n == io.FAILED || !image.read_header(file_bytes[0:n], &h) || h.width > W || h.height > H {
        message = "can't open that picture"
        return
    }
    var tile [image.TILE_PIXELS]u32
    for ty in 0..h.tiles_y {
        for tx in 0..h.tiles_x {
            var t = ty * h.tiles_x + tx
            var tw = image.tile_width(&h, tx)
            var th = image.tile_height(&h, ty)
            var start = image.tile_offset(file_bytes[:], t)
            var end = image.tile_offset(file_bytes[:], t + 1)
            if end > n || start > end || !image.decode_tile(file_bytes[start:end], tile[:], tw * th) {
                message = "the picture is damaged"
                return
            }
            for y in 0..th {
                for x in 0..tw {
                    picture[(ty * image.TILE + y) * W + tx * image.TILE + x] = tile[y * tw + x]
                }
            }
        }
    }
}

fn save() {
    if path_len == 0 {
        mem.copy(path[:], "picture.tim")
        path_len = 11
    }
    var file = io.open(path[0:path_len], io.MODE_WRITE)
    if file == io.FAILED || !image.save(file, W, H, picture[:], scratch[:], offsets[:]) {
        message = "can't save"
    } else {
        message = "saved"
    }
    io.close(file)
}

fn draw() {
    gfx.draw_image(&canvas, &view_image, 0, 0, W * ZOOM, H * ZOOM, 0, 0, false)
    var x0 i32 = W * ZOOM
    gfx.draw_fill(&canvas, x0, 0, SIDE, HEIGHT, ui.BACKGROUND)
    for i in 0..16 {
        var x = x0 + 6 + (i % 2) as i32 * (SWATCH + 4)
        var y = 6 + (i / 2) as i32 * (SWATCH + 4)
        if panel.pressed && ui.inside(&panel, x, y, SWATCH, SWATCH) {
            color = i
        }
        var edge = ui.EDGE
        if color == i {
            gfx.draw_fill(&canvas, x - 3, y - 3, SWATCH + 6, SWATCH + 6, ui.PRESSED)
        }
        gfx.draw_fill(&canvas, x - 1, y - 1, SWATCH + 2, SWATCH + 2, edge)
        gfx.draw_fill(&canvas, x, y, SWATCH, SWATCH, palette[i])
    }
    var tool = "Pen"
    if filling {
        tool = "Fill"
    }
    if ui.button(&panel, 100, x0 + 6, HEIGHT - 84, SIDE - 12, 24, tool) {
        filling = !filling
    }
    if ui.button(&panel, 101, x0 + 6, HEIGHT - 56, SIDE - 12, 24, "Save") {
        save()
    }
    if message.len > 0 {
        gfx.draw_text(&canvas, x0 + 4, HEIGHT - 24, ui.TEXT, message[0:min(message.len, 7)])
    }
    gfx.present(&canvas)
}
