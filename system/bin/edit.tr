// edit, a text editor.
//
//     edit [file]
//
// Arrows, Home, End, Page Up and Page Down move, and select with Shift; the
// mouse places the cursor, dragging selects, and the wheel scrolls; dragging
// the strip under the window resizes it. Tab inserts four spaces. With Ctrl
// (or Cmd): S saves, A selects everything, C copies the selection (or the
// line), X cuts it, V pastes, and F finds text (Enter finds the next, Escape
// stops).
//
// The text lives in a gap buffer: one array with the unused space kept at the
// cursor, so typing only ever touches the gap.

manifest {
    memory = 2 * MiB;
    stack = 32 * KiB;
    allow = "read write window";
}

const CAPACITY = 1 * MiB;
const MAX_COLUMNS = 160;
const MAX_ROWS = 64;
const GUTTER = 5;               // columns for line numbers
const MARGIN = 4;

const BACKGROUND: u32 = 0xfff2efe6;
const FOREGROUND: u32 = 0xff1e1e24;
const NUMBERS: u32 = 0xff9a968c;
const COMMENT: u32 = 0xff5a8a70;
const STRING: u32 = 0xffb05a3c;
const CURSOR: u32 = 0xff2d5a50;
const SELECTION: u32 = 0xffcfe0d4;
const NONE: u32 = 0xffffffff;
const STATUS: u32 = 0xff1e1e24;
const STATUS_TEXT: u32 = 0xfff2efe6;

var text: [CAPACITY]u8;
var gap_start: u32;
var gap_end: u32;
var cursor: u32;            // a position in the text, gap not counted
var anchor: u32;            // the other end of the selection, or NONE
var dragging: bool;
var top: u32;               // the first line shown
var left: u32;              // the first column shown
var modified: bool;
var path: [256]u8;
var path_len: u32;
var message: []u8;
var finding: bool;
var find_text: [64]u8;
var find_len: u32;
var clip: [64 * KiB]u8;

var canvas: Canvas;
var strings: [8192]u8;
var words: [8192]u32;
var row_text: [MAX_COLUMNS * 4]u8;    // a row's characters, as UTF-8
var columns: u32;
var rows: u32;
var window_width: i32;
var window_height: i32;
var number_text: [8]u8;
var status_text: [160]u8;
var font_width: i32;
var font_height: i32;

fn main(memory: []u8) -> u32 {
    anchor = NONE;
    gap_start = 0;
    gap_end = CAPACITY;
    if arg_count() > 0 {
        path_len = min(arg(0, path[:]), path.len);
        load();
    }
    var screen: ScreenInfo;
    if screen_info(&screen) == FAILED {
        complain("edit", "there is no screen", "");
        return 1;
    }
    font_width = screen.font_width as i32;
    font_height = screen.font_height as i32;
    var title = "edit";
    if path_len > 0 {
        title = path[0:path_len];
    }
    columns = 88;
    rows = 32;
    window_width = columns as i32 * font_width + 2 * MARGIN;
    window_height = (rows + 1) as i32 * font_height + 2 * MARGIN;
    var window = window_open(title, window_width as u32, window_height as u32);
    if window == FAILED {
        complain("edit", "can't open a window", "");
        return 1;
    }
    window_resizable(window, 30 * screen.font_width, 6 * screen.font_height);
    canvas_init(&canvas, window, words[:], strings[:]);

    while true {
        var e: Event;
        event_wait(&e, FOREVER);
        if e.kind == EVENT_CLOSE {
            return 0;
        }
        if e.kind == EVENT_RESIZE {
            window_width = e.x;
            window_height = e.y;
            columns = min(((window_width - 2 * MARGIN) / font_width) as u32, MAX_COLUMNS);
            rows = min(((window_height - 2 * MARGIN) / font_height) as u32 - 1, MAX_ROWS);
            keep_cursor_visible();
            draw();
            continue;
        }
        handle(&e);
        if e.kind != EVENT_KEY_UP && (e.kind != EVENT_MOUSE_MOVE || dragging) && e.kind != EVENT_MOUSE_UP {
            draw();
        }
    }
    return 0;
}

fn min(a: u32, b: u32) -> u32 {
    if a < b {
        return a;
    }
    return b;
}

// The gap buffer ---------------------------------------------------------------

fn length() -> u32 {
    return CAPACITY - (gap_end - gap_start);
}

fn char_at(i: u32) -> u8 {
    if i < gap_start {
        return text[i];
    }
    return text[i + gap_end - gap_start];
}

// Moves the gap to a position in the text.
fn move_gap(position: u32) {
    if position < gap_start {
        var n = gap_start - position;
        mem_copy(&text[gap_end - n], &text[position], n);
        gap_start -= n;
        gap_end -= n;
    } else if position > gap_start {
        var n = position - gap_start;
        mem_copy(&text[gap_start], &text[gap_end], n);
        gap_start += n;
        gap_end += n;
    }
}

fn insert_char(c: u32) {
    var bytes: [4]u8;
    var n = encode_char(c, bytes[:]);
    for i in 0..n {
        insert(bytes[i]);
    }
}

fn insert(c: u8) {
    if gap_start == gap_end {
        message = "the file is too big";
        return;
    }
    move_gap(cursor);
    text[gap_start] = c;
    gap_start += 1;
    cursor += 1;
    modified = true;
}

fn delete_before() {
    if cursor == 0 {
        return;
    }
    var start = previous_char(cursor);
    move_gap(cursor);
    gap_start = start;
    cursor = start;
    modified = true;
}

fn delete_after() {
    if cursor == length() {
        return;
    }
    move_gap(cursor);
    gap_end += next_char(cursor) - cursor;
    modified = true;
}

// Characters -------------------------------------------------------------------

// Positions are bytes, and a character can take up to four of them, so
// these look at up to four bytes on either side.

fn next_char(position: u32) -> u32 {
    var bytes: [4]u8;
    var n = min(4, length() - position);
    for i in 0..n {
        bytes[i] = char_at(position + i);
    }
    return position + char_length(bytes[0:n], 0);
}

fn previous_char(position: u32) -> u32 {
    var bytes: [4]u8;
    var n = min(4, position);
    for i in 0..n {
        bytes[i] = char_at(position - n + i);
    }
    return position - n + char_start(bytes[0:n], n);
}

// The column of a position on the line that starts at start.
fn column_of(start: u32, position: u32) -> u32 {
    var column: u32 = 0;
    var p = start;
    while p < position {
        p = next_char(p);
        column += 1;
    }
    return column;
}

// Lines ------------------------------------------------------------------------

fn line_start(position: u32) -> u32 {
    var p = position;
    while p > 0 && char_at(p - 1) != '\n' {
        p -= 1;
    }
    return p;
}

fn line_end(position: u32) -> u32 {
    var p = position;
    var n = length();
    while p < n && char_at(p) != '\n' {
        p += 1;
    }
    return p;
}

// The line number of a position, counting from 0.
fn line_of(position: u32) -> u32 {
    var line: u32 = 0;
    for i in 0..position {
        if char_at(i) == '\n' {
            line += 1;
        }
    }
    return line;
}

// The position where a line starts, or the end of the text.
fn start_of_line(line: u32) -> u32 {
    var p: u32 = 0;
    var n = length();
    var count: u32 = 0;
    while count < line && p < n {
        if char_at(p) == '\n' {
            count += 1;
        }
        p += 1;
    }
    return p;
}

// Moves to the same column on the line that starts at start.
fn move_to_column(start: u32, column: u32) {
    var end = line_end(start);
    cursor = start;
    for i in 0..column {
        if cursor >= end {
            return;
        }
        cursor = next_char(cursor);
    }
}

fn lines() -> u32 {
    return line_of(length()) + 1;
}

// Files ------------------------------------------------------------------------

fn load() {
    var file = open(path[0:path_len], MODE_READ);
    if file == FAILED {
        message = "new file";
        return;
    }
    while gap_start < CAPACITY {
        var n = read(file, text[gap_start:]);
        if n == 0 || n == FAILED {
            break;
        }
        gap_start += n;
    }
    close(file);
    // Keep the gap after the text, with the cursor at the start.
    var n = gap_start;
    mem_copy(&text[CAPACITY - n], &text[0], n);
    gap_start = 0;
    gap_end = CAPACITY - n;
}

fn save() {
    if path_len == 0 {
        message = "no file name; start edit with one";
        return;
    }
    var file = open(path[0:path_len], MODE_WRITE);
    if file == FAILED {
        message = "can't save";
        return;
    }
    var ok = write_all(file, text[0:gap_start]) && write_all(file, text[gap_end:CAPACITY]);
    close(file);
    if ok {
        modified = false;
        message = "saved";
    } else {
        message = "can't save";
    }
}

// Input ------------------------------------------------------------------------

fn handle(e: *Event) {
    message = "";
    if finding && (e.kind == EVENT_TEXT || e.kind == EVENT_KEY_DOWN) {
        handle_find(e);
        keep_cursor_visible();
        return;
    }
    if e.kind == EVENT_TEXT {
        delete_selection();
        insert_char(e.key);
    } else if e.kind == EVENT_KEY_DOWN {
        key(e.key, e.modifiers);
    } else if e.kind == EVENT_MOUSE_DOWN && e.buttons == 1 {
        place_cursor(e.x, e.y);
        anchor = cursor;
        dragging = true;
    } else if e.kind == EVENT_MOUSE_MOVE && dragging {
        place_cursor(e.x, e.y);
    } else if e.kind == EVENT_MOUSE_UP {
        dragging = false;
        if anchor == cursor {
            anchor = NONE;
        }
        return;
    } else if e.kind == EVENT_WHEEL {
        if e.y > 0 {
            top = min(top + 3, lines() - 1);
        } else if e.y < 0 && top > 0 {
            top -= min(top, 3);
        }
        return;
    }
    keep_cursor_visible();
}

// Moves the cursor to where the mouse is.
fn place_cursor(x: i32, y: i32) {
    var row = (y - MARGIN) / font_height;
    var column = (x - MARGIN) / font_width - GUTTER;
    if row < 0 {
        row = 0;
    }
    if row >= rows as i32 {
        row = rows as i32 - 1;
    }
    if column < 0 {
        column = 0;
    }
    move_to_column(start_of_line(top + row as u32), left + column as u32);
}

fn is_movement(code: u32) -> bool {
    return code == KEY_LEFT || code == KEY_RIGHT || code == KEY_UP || code == KEY_DOWN || code == KEY_HOME || code == KEY_END || code == KEY_PAGE_UP || code == KEY_PAGE_DOWN;
}

fn key(code: u32, modifiers: u32) {
    if (modifiers & (MOD_CTRL | MOD_SUPER)) != 0 {
        if code == 's' {
            save();
        } else if code == 'a' {
            anchor = 0;
            cursor = length();
        } else if code == 'c' || code == 'x' {
            copy_text(code == 'x');
        } else if code == 'v' {
            paste();
        } else if code == 'f' {
            finding = true;
        }
        return;
    }
    if is_movement(code) {
        // Shift keeps the selection's other end where it was.
        if (modifiers & MOD_SHIFT) == 0 {
            anchor = NONE;
        } else if anchor == NONE {
            anchor = cursor;
        }
    }
    var start = line_start(cursor);
    var column = column_of(start, cursor);
    match code {
        KEY_ENTER => {
            delete_selection();
            insert('\n');
        }
        KEY_TAB => {
            delete_selection();
            for i in 0..4 {
                insert(' ');
            }
        }
        KEY_BACKSPACE => {
            if !delete_selection() {
                delete_before();
            }
        }
        KEY_DELETE => {
            if !delete_selection() {
                delete_after();
            }
        }
        KEY_LEFT => {
            if cursor > 0 {
                cursor = previous_char(cursor);
            }
        }
        KEY_RIGHT => {
            if cursor < length() {
                cursor = next_char(cursor);
            }
        }
        KEY_HOME => { cursor = start; }
        KEY_END => { cursor = line_end(cursor); }
        KEY_UP => {
            if start > 0 {
                move_to_column(line_start(start - 1), column);
            }
        }
        KEY_DOWN => {
            var end = line_end(cursor);
            if end < length() {
                move_to_column(end + 1, column);
            }
        }
        KEY_PAGE_UP => {
            var line = line_of(cursor);
            move_to_column(start_of_line(line - min(line, rows - 1)), column);
        }
        KEY_PAGE_DOWN => {
            var line = line_of(cursor) + rows - 1;
            var target = start_of_line(line);
            move_to_column(line_start(target), column);
        }
    }
}

// The selection ---------------------------------------------------------------

fn has_selection() -> bool {
    return anchor != NONE && anchor != cursor;
}

fn selection_start() -> u32 {
    return min(anchor, cursor);
}

fn selection_end() -> u32 {
    if anchor > cursor {
        return anchor;
    }
    return cursor;
}

fn delete_range(start: u32, end: u32) {
    move_gap(start);
    gap_end += end - start;
    cursor = start;
    modified = true;
}

// Deletes the selected text, if there is any.
fn delete_selection() -> bool {
    if !has_selection() {
        anchor = NONE;
        return false;
    }
    delete_range(selection_start(), selection_end());
    anchor = NONE;
    return true;
}

// Copies the selection, or without one the cursor's line with its line
// break, and cuts it too if asked.
fn copy_text(cut: bool) {
    var whole_line = !has_selection();
    var start = line_start(cursor);
    var end = line_end(cursor);
    if end < length() {
        end += 1;
    }
    if !whole_line {
        start = selection_start();
        end = selection_end();
    }
    var n = min(end - start, clip.len);
    for i in 0..n {
        clip[i] = char_at(start + i);
    }
    clipboard_set(clip[0:n]);
    if cut {
        delete_range(start, start + n);
        anchor = NONE;
    }
    if n < end - start {
        message = "only the first 64 KiB fit";
    } else if cut && whole_line {
        message = "cut the line";
    } else if cut {
        message = "cut the selection";
    } else if whole_line {
        message = "copied the line";
    } else {
        message = "copied the selection";
    }
}

// Pastes at the cursor, or over the selection. Whole lines go in above the
// cursor's line.
fn paste() {
    var n = min(clipboard_get(clip[:]), clip.len);
    if !delete_selection() && n > 0 && clip[n - 1] == '\n' {
        cursor = line_start(cursor);
    }
    for i in 0..n {
        if clip[i] != '\r' {
            insert(clip[i]);
        }
    }
}

fn handle_find(e: *Event) {
    if e.kind == EVENT_TEXT {
        find_len += encode_char(e.key, find_text[find_len:]);
        return;
    }
    if e.key == KEY_ESCAPE {
        finding = false;
    } else if e.key == KEY_BACKSPACE && find_len > 0 {
        find_len = char_start(find_text[:], find_len);
    } else if e.key == KEY_ENTER {
        find_next();
    }
}

// Moves the cursor to the next place the text appears, wrapping around.
fn find_next() {
    var n = length();
    if find_len == 0 || find_len > n {
        return;
    }
    // A match leaves the cursor at its end, so this starts at the cursor.
    for step in 0..n {
        var p = (cursor + step) % n;
        if p + find_len > n {
            continue;
        }
        var found = true;
        for i in 0..find_len {
            if char_at(p + i) != find_text[i] {
                found = false;
                break;
            }
        }
        if found {
            anchor = p;
            cursor = p + find_len;
            return;
        }
    }
    message = "not found";
}

fn keep_cursor_visible() {
    var line = line_of(cursor);
    if line < top {
        top = line;
    } else if line >= top + rows {
        top = line - rows + 1;
    }
    var column = column_of(line_start(cursor), cursor);
    var width = columns - GUTTER - 1;
    if column < left {
        left = column;
    } else if column >= left + width {
        left = column - width + 1;
    }
}

// Drawing ----------------------------------------------------------------------

fn draw() {
    var width = window_width;
    draw_fill(&canvas, 0, 0, width, window_height, BACKGROUND);
    var p = start_of_line(top);
    var n = length();
    var cursor_row: i32 = -1;
    var cursor_column: i32 = 0;
    for row in 0..rows {
        var y = MARGIN + row as i32 * font_height;
        if p > n || (p == n && row > 0 && (n == 0 || char_at(n - 1) != '\n')) {
            break;
        }
        draw_number(top + row + 1, y);
        var start = p;
        var end = line_end(p);
        var used: u32 = 0;              // bytes in row_text
        var shown: u32 = 0;             // characters in row_text
        var comment = row_text.len;     // where in row_text a comment starts
        var comment_column: u32 = 0;
        var column: u32 = 0;
        var i = start;
        while i < end {
            var next = next_char(i);
            var c = char_at(i);
            if c == '/' && i + 1 < end && char_at(i + 1) == '/' && comment == row_text.len {
                comment = used;
                comment_column = shown;
            }
            if column >= left && shown < columns - GUTTER {
                if c < 32 || c == 127 {
                    row_text[used] = ' ';
                    used += 1;
                } else {
                    for k in i..next {
                        row_text[used] = char_at(k);
                        used += 1;
                    }
                }
                shown += 1;
            }
            column += 1;
            i = next;
        }
        var x = MARGIN + GUTTER as i32 * font_width;
        draw_selection(start, end, x, y);
        if comment < used {
            draw_text(&canvas, x, y, FOREGROUND, row_text[0:comment]);
            draw_text(&canvas, x + comment_column as i32 * font_width, y, COMMENT, row_text[comment:used]);
        } else {
            draw_strings(x, y, row_text[0:used]);
        }
        if cursor >= start && cursor <= end {
            cursor_row = row as i32;
            cursor_column = column_of(start, cursor) as i32 - left as i32;
        }
        p = end + 1;
    }
    if cursor_row >= 0 {
        var x = MARGIN + (GUTTER as i32 + cursor_column) * font_width;
        draw_fill(&canvas, x, MARGIN + cursor_row * font_height, 2, font_height, CURSOR);
    }
    draw_status(width);
    present(&canvas);
}

// Shades the selected part of the line from start to end, and one more
// column if the selection takes its line break.
fn draw_selection(start: u32, end: u32, x: i32, y: i32) {
    if !has_selection() {
        return;
    }
    var from = selection_start();
    var to = selection_end();
    if to <= start || from > end {
        return;
    }
    var first = column_of(start, max_u32(from, start));
    var last = column_of(start, min(to, end));
    if to > end {
        last += 1;
    }
    var width = columns - GUTTER;
    first = min(max_u32(first, left) - left, width);
    last = min(max_u32(last, left) - left, width);
    if last > first {
        draw_fill(&canvas, x + first as i32 * font_width, y, (last - first) as i32 * font_width, font_height, SELECTION);
    }
}

fn max_u32(a: u32, b: u32) -> u32 {
    if a > b {
        return a;
    }
    return b;
}

// Draws a line, coloring text in double quotes.
fn draw_strings(x: i32, y: i32, line: []u8) {
    var start: u32 = 0;
    var i: u32 = 0;
    while i < line.len {
        if line[i] == '"' {
            draw_text(&canvas, x + char_count(line[0:start]) as i32 * font_width, y, FOREGROUND, line[start:i]);
            var end = i + 1;
            while end < line.len && line[end] != '"' {
                if line[end] == '\\' && end + 1 < line.len {
                    end += 1;
                }
                end += char_length(line, end);
            }
            end = min(end + 1, line.len);
            draw_text(&canvas, x + char_count(line[0:i]) as i32 * font_width, y, STRING, line[i:end]);
            start = end;
            i = end;
            continue;
        }
        i += 1;
    }
    draw_text(&canvas, x + char_count(line[0:start]) as i32 * font_width, y, FOREGROUND, line[start:]);
}

fn draw_number(n: u32, y: i32) {
    var w: Writer;
    writer_init(&w, STDOUT, number_text[:]);
    put_u32(&w, n);
    var x = MARGIN + (GUTTER as i32 - 1 - w.used as i32) * font_width;
    draw_text(&canvas, x, y, NUMBERS, number_text[0:w.used]);
}

fn draw_status(width: i32) {
    var y = window_height - font_height - MARGIN;
    draw_fill(&canvas, 0, y, width, font_height + MARGIN, STATUS);
    var w: Writer;
    writer_init(&w, STDOUT, status_text[:]);
    if path_len > 0 {
        put(&w, path[0:path_len]);
    } else {
        put(&w, "(no name)");
    }
    if modified {
        put(&w, " *");
    }
    put(&w, "  line ");
    put_u32(&w, line_of(cursor) + 1);
    put(&w, ", column ");
    put_u32(&w, column_of(line_start(cursor), cursor) + 1);
    if finding {
        put(&w, "  find: ");
        put(&w, find_text[0:find_len]);
    } else if message.len > 0 {
        put(&w, "  ");
        put(&w, message);
    }
    draw_text(&canvas, MARGIN, y + 1, STATUS_TEXT, status_text[0:w.used]);
}
