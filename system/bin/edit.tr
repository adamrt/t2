// edit, a text editor.
//
//     edit [file]
//
// Arrows, Home, End, Page Up and Page Down move; the mouse places the cursor
// and the wheel scrolls. Ctrl-S (or Cmd-S) saves. Tab inserts four spaces.
//
// The text lives in a gap buffer: one array with the unused space kept at the
// cursor, so typing only ever touches the gap.

manifest {
    memory = 2 * MiB;
    stack = 32 * KiB;
}

const CAPACITY = 1 * MiB;
const COLUMNS = 88;
const ROWS = 32;
const GUTTER = 5;               // columns for line numbers
const MARGIN = 4;

const BACKGROUND: u32 = 0xfff2efe6;
const FOREGROUND: u32 = 0xff1e1e24;
const NUMBERS: u32 = 0xff9a968c;
const COMMENT: u32 = 0xff5a8a70;
const STRING: u32 = 0xffb05a3c;
const CURSOR: u32 = 0xff2d5a50;
const STATUS: u32 = 0xff1e1e24;
const STATUS_TEXT: u32 = 0xfff2efe6;

var text: [CAPACITY]u8;
var gap_start: u32;
var gap_end: u32;
var cursor: u32;            // a position in the text, gap not counted
var top: u32;               // the first line shown
var left: u32;              // the first column shown
var modified: bool;
var path: [256]u8;
var path_len: u32;
var message: []u8;

var canvas: Canvas;
var strings: [8192]u8;
var words: [8192]u32;
var row_text: [COLUMNS]u8;
var number_text: [8]u8;
var status_text: [160]u8;
var font_width: i32;
var font_height: i32;

fn main(memory: []u8) -> u32 {
    gap_start = 0;
    gap_end = CAPACITY;
    if arg_count() > 0 {
        path_len = min(arg(0, path[:]), path.len);
        load();
    }
    var screen: ScreenInfo;
    if screen_info(&screen) == FAILED {
        complain("edit", "there is no screen", "");
        return 1;
    }
    font_width = screen.font_width as i32;
    font_height = screen.font_height as i32;
    var title = "edit";
    if path_len > 0 {
        title = path[0:path_len];
    }
    var window = window_open(title, COLUMNS * screen.font_width + 2 * MARGIN, (ROWS + 1) * screen.font_height + 2 * MARGIN);
    if window == FAILED {
        complain("edit", "can't open a window", "");
        return 1;
    }
    canvas_init(&canvas, window, words[:], strings[:]);

    while true {
        var e: Event;
        event_wait(&e, FOREVER);
        if e.kind == EVENT_CLOSE {
            return 0;
        }
        handle(&e);
        if e.kind != EVENT_KEY_UP && e.kind != EVENT_MOUSE_MOVE && e.kind != EVENT_MOUSE_UP {
            draw();
        }
    }
    return 0;
}

fn min(a: u32, b: u32) -> u32 {
    if a < b {
        return a;
    }
    return b;
}

// The gap buffer ---------------------------------------------------------------

fn length() -> u32 {
    return CAPACITY - (gap_end - gap_start);
}

fn char_at(i: u32) -> u8 {
    if i < gap_start {
        return text[i];
    }
    return text[i + gap_end - gap_start];
}

// Moves the gap to a position in the text.
fn move_gap(position: u32) {
    if position < gap_start {
        var n = gap_start - position;
        mem_copy(&text[gap_end - n], &text[position], n);
        gap_start -= n;
        gap_end -= n;
    } else if position > gap_start {
        var n = position - gap_start;
        mem_copy(&text[gap_start], &text[gap_end], n);
        gap_start += n;
        gap_end += n;
    }
}

fn insert(c: u8) {
    if gap_start == gap_end {
        message = "the file is too big";
        return;
    }
    move_gap(cursor);
    text[gap_start] = c;
    gap_start += 1;
    cursor += 1;
    modified = true;
}

fn delete_before() {
    if cursor == 0 {
        return;
    }
    move_gap(cursor);
    gap_start -= 1;
    cursor -= 1;
    modified = true;
}

fn delete_after() {
    if cursor == length() {
        return;
    }
    move_gap(cursor);
    gap_end += 1;
    modified = true;
}

// Lines ------------------------------------------------------------------------

fn line_start(position: u32) -> u32 {
    var p = position;
    while p > 0 && char_at(p - 1) != '\n' {
        p -= 1;
    }
    return p;
}

fn line_end(position: u32) -> u32 {
    var p = position;
    var n = length();
    while p < n && char_at(p) != '\n' {
        p += 1;
    }
    return p;
}

// The line number of a position, counting from 0.
fn line_of(position: u32) -> u32 {
    var line: u32 = 0;
    for i in 0..position {
        if char_at(i) == '\n' {
            line += 1;
        }
    }
    return line;
}

// The position where a line starts, or the end of the text.
fn start_of_line(line: u32) -> u32 {
    var p: u32 = 0;
    var n = length();
    var count: u32 = 0;
    while count < line && p < n {
        if char_at(p) == '\n' {
            count += 1;
        }
        p += 1;
    }
    return p;
}

// Moves to the same column on the line that starts at start.
fn move_to_column(start: u32, column: u32) {
    var end = line_end(start);
    cursor = min(start + column, end);
}

fn lines() -> u32 {
    return line_of(length()) + 1;
}

// Files ------------------------------------------------------------------------

fn load() {
    var file = open(path[0:path_len], MODE_READ);
    if file == FAILED {
        message = "new file";
        return;
    }
    while gap_start < CAPACITY {
        var n = read(file, text[gap_start:]);
        if n == 0 || n == FAILED {
            break;
        }
        gap_start += n;
    }
    close(file);
    // Keep the gap after the text, with the cursor at the start.
    var n = gap_start;
    mem_copy(&text[CAPACITY - n], &text[0], n);
    gap_start = 0;
    gap_end = CAPACITY - n;
}

fn save() {
    if path_len == 0 {
        message = "no file name; start edit with one";
        return;
    }
    var file = open(path[0:path_len], MODE_WRITE);
    if file == FAILED {
        message = "can't save";
        return;
    }
    var ok = write_all(file, text[0:gap_start]) && write_all(file, text[gap_end:CAPACITY]);
    close(file);
    if ok {
        modified = false;
        message = "saved";
    } else {
        message = "can't save";
    }
}

// Input ------------------------------------------------------------------------

fn handle(e: *Event) {
    message = "";
    if e.kind == EVENT_TEXT {
        insert(e.key as u8);
    } else if e.kind == EVENT_KEY_DOWN {
        key(e.key, e.modifiers);
    } else if e.kind == EVENT_MOUSE_DOWN {
        var row = (e.y - MARGIN) / font_height;
        var column = (e.x - MARGIN) / font_width - GUTTER;
        if row >= 0 && row < ROWS {
            var start = start_of_line(top + row as u32);
            if column < 0 {
                column = 0;
            }
            move_to_column(start, left + column as u32);
        }
    } else if e.kind == EVENT_WHEEL {
        if e.y > 0 {
            top = min(top + 3, lines() - 1);
        } else if e.y < 0 && top > 0 {
            top -= min(top, 3);
        }
        return;
    }
    keep_cursor_visible();
}

fn key(code: u32, modifiers: u32) {
    if (modifiers & (MOD_CTRL | MOD_SUPER)) != 0 {
        if code == 's' {
            save();
        }
        return;
    }
    var start = line_start(cursor);
    var column = cursor - start;
    match code {
        KEY_ENTER => { insert('\n'); }
        KEY_TAB => {
            for i in 0..4 {
                insert(' ');
            }
        }
        KEY_BACKSPACE => { delete_before(); }
        KEY_DELETE => { delete_after(); }
        KEY_LEFT => {
            if cursor > 0 {
                cursor -= 1;
            }
        }
        KEY_RIGHT => {
            if cursor < length() {
                cursor += 1;
            }
        }
        KEY_HOME => { cursor = start; }
        KEY_END => { cursor = line_end(cursor); }
        KEY_UP => {
            if start > 0 {
                move_to_column(line_start(start - 1), column);
            }
        }
        KEY_DOWN => {
            var end = line_end(cursor);
            if end < length() {
                move_to_column(end + 1, column);
            }
        }
        KEY_PAGE_UP => {
            var line = line_of(cursor);
            move_to_column(start_of_line(line - min(line, ROWS - 1)), column);
        }
        KEY_PAGE_DOWN => {
            var line = line_of(cursor) + ROWS - 1;
            var target = start_of_line(line);
            move_to_column(line_start(target), column);
        }
    }
}

fn keep_cursor_visible() {
    var line = line_of(cursor);
    if line < top {
        top = line;
    } else if line >= top + ROWS {
        top = line - ROWS + 1;
    }
    var column = cursor - line_start(cursor);
    var width: u32 = COLUMNS - GUTTER - 1;
    if column < left {
        left = column;
    } else if column >= left + width {
        left = column - width + 1;
    }
}

// Drawing ----------------------------------------------------------------------

fn draw() {
    var width = COLUMNS * font_width + 2 * MARGIN;
    draw_fill(&canvas, 0, 0, width, ROWS * font_height + 2 * MARGIN, BACKGROUND);
    var p = start_of_line(top);
    var n = length();
    var cursor_row: i32 = -1;
    var cursor_column: i32 = 0;
    for row in 0..ROWS {
        var y = MARGIN + row as i32 * font_height;
        if p > n || (p == n && row > 0 && (n == 0 || char_at(n - 1) != '\n')) {
            break;
        }
        draw_number(top + row + 1, y);
        var start = p;
        var end = line_end(p);
        var used: u32 = 0;
        var comment: u32 = COLUMNS;
        for i in start..end {
            var column = i - start;
            var c = char_at(i);
            if c == '/' && i + 1 < end && char_at(i + 1) == '/' && comment == COLUMNS {
                if column >= left {
                    comment = column - left;
                } else {
                    comment = 0;
                }
            }
            if column >= left && used < COLUMNS - GUTTER {
                if c < 32 || c > 126 {
                    c = ' ';
                }
                row_text[used] = c;
                used += 1;
            }
        }
        var x = MARGIN + GUTTER as i32 * font_width;
        if comment < used {
            draw_text(&canvas, x, y, FOREGROUND, row_text[0:comment]);
            draw_text(&canvas, x + comment as i32 * font_width, y, COMMENT, row_text[comment:used]);
        } else {
            draw_strings(x, y, row_text[0:used]);
        }
        if cursor >= start && cursor <= end {
            cursor_row = row as i32;
            cursor_column = (cursor - start) as i32 - left as i32;
        }
        p = end + 1;
    }
    if cursor_row >= 0 {
        var x = MARGIN + (GUTTER as i32 + cursor_column) * font_width;
        draw_fill(&canvas, x, MARGIN + cursor_row * font_height, 2, font_height, CURSOR);
    }
    draw_status(width);
    present(&canvas);
}

// Draws a line, coloring text in double quotes.
fn draw_strings(x: i32, y: i32, line: []u8) {
    var start: u32 = 0;
    var i: u32 = 0;
    while i < line.len {
        if line[i] == '"' {
            draw_text(&canvas, x + start as i32 * font_width, y, FOREGROUND, line[start:i]);
            var end = i + 1;
            while end < line.len && line[end] != '"' {
                if line[end] == '\\' {
                    end += 1;
                }
                end += 1;
            }
            end = min(end + 1, line.len);
            draw_text(&canvas, x + i as i32 * font_width, y, STRING, line[i:end]);
            start = end;
            i = end;
            continue;
        }
        i += 1;
    }
    draw_text(&canvas, x + start as i32 * font_width, y, FOREGROUND, line[start:]);
}

fn draw_number(n: u32, y: i32) {
    var w: Writer;
    writer_init(&w, STDOUT, number_text[:]);
    put_u32(&w, n);
    var x = MARGIN + (GUTTER as i32 - 1 - w.used as i32) * font_width;
    draw_text(&canvas, x, y, NUMBERS, number_text[0:w.used]);
}

fn draw_status(width: i32) {
    var y = MARGIN + ROWS as i32 * font_height;
    draw_fill(&canvas, 0, y, width, font_height + MARGIN, STATUS);
    var w: Writer;
    writer_init(&w, STDOUT, status_text[:]);
    if path_len > 0 {
        put(&w, path[0:path_len]);
    } else {
        put(&w, "(no name)");
    }
    if modified {
        put(&w, " *");
    }
    put(&w, "  line ");
    put_u32(&w, line_of(cursor) + 1);
    put(&w, ", column ");
    put_u32(&w, cursor - line_start(cursor) + 1);
    if message.len > 0 {
        put(&w, "  ");
        put(&w, message);
    }
    draw_text(&canvas, MARGIN, y + 1, STATUS_TEXT, status_text[0:w.used]);
}
