// fetch asks a web server for a page and prints what comes back.
//
//     fetch host port /path

manifest {
    memory = 128 * KiB;
    stack = 16 * KiB;
    allow = "network";
}

var buffer: [8192]u8;

fn main(memory: []u8) -> u32 {
    var arena: Arena;
    arena_init(&arena, memory);
    var args: [3][]u8;
    if arg_count() != 3 {
        complain("fetch", "usage: fetch host port /path", "");
        return 2;
    }
    get_args(&arena, args[:]);
    var port = parse_u32(args[1]);
    var connection = connect(args[0], port);
    if port == FAILED || connection == FAILED {
        complain("fetch", "can't connect to", args[0]);
        return 1;
    }
    var request: [512]u8;
    var w: Writer;
    writer_init(&w, connection, request[:]);
    put(&w, "GET ");
    put(&w, args[2]);
    put(&w, " HTTP/1.0\r\nHost: ");
    put(&w, args[0]);
    put(&w, "\r\nUser-Agent: Terrarium\r\n\r\n");
    flush(&w);
    while true {
        var n = read(connection, buffer[:]);
        if n == 0 || n == FAILED {
            break;
        }
        write_all(STDOUT, buffer[0:n]);
    }
    close(connection);
    return 0;
}
