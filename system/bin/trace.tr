// trace runs a program and shows every system call it makes, and the calls
// of any programs it starts.
//
//     trace ls /bin

import io;
import mem;
import os;

manifest {
    memory = 128 * KiB;
    stack = 16 * KiB;
    allow = "read write spawn window processes recovery audio network";
}

var buffer: [4096]u8;

fn main(memory: []u8) -> u32 {
    var arena: mem.Arena;
    mem.arena_init(&arena, memory);
    if os.arg_count() == 0 {
        os.complain("trace", "usage: trace program [arguments...]", "");
        return 2;
    }
    var args: [64][]u8;
    var count = os.get_args(&arena, args[:]);
    var path: [256]u8;
    var n: u32 = 0;
    var name = args[0];
    var slash = false;
    for i in 0..name.len {
        if name[i] == '/' {
            slash = true;
        }
    }
    if !slash {
        mem.copy(path[:], "/bin/");
        n = 5;
    }
    mem.copy(path[n:], name);
    n += name.len;
    var rest: [2048]u8;
    var used: u32 = 0;
    for i in 1..count {
        mem.copy(rest[used:], args[i]);
        used += args[i].len;
        rest[used] = 0;
        used += 1;
    }

    var write_end: u32;
    var read_end = os.open_pipe(&write_end);
    os.trace_spawns(write_end);
    var child = os.spawn(path[0:n], rest[0:used], io.STDIN, io.STDOUT, io.STDERR);
    os.trace_spawns(io.FAILED);
    io.close(write_end);
    if child == io.FAILED {
        os.complain("trace", "can't run", name);
        return 1;
    }
    while true {
        var got = io.read(read_end, buffer[:]);
        if got == 0 || got == io.FAILED {
            break;
        }
        io.write_all(io.STDERR, buffer[0:got]);
    }
    return os.wait(child);
}
