// hex shows the bytes of a file, or of its input, sixteen to a line: where
// they are, their values, and as text.
//
//     hex /bin/echo

import io;
import mem;
import os;

manifest {
    memory = 64 * KiB;
    stack = 16 * KiB;
    allow = "read";
}

var buffer: [16 * KiB]u8;
var out: io.Writer;
var out_buffer: [4096]u8;

fn main(memory: []u8) -> u32 {
    var arena: mem.Arena;
    mem.arena_init(&arena, memory);
    var args: [2][]u8;
    var count = os.get_args(&arena, args[:]);
    if count > 1 {
        os.complain("hex", "usage: hex [file]", "");
        return 2;
    }
    var file = io.STDIN;
    if count == 1 {
        file = io.open(args[0], io.MODE_READ);
        if file == io.FAILED {
            os.complain("hex", "can't read", args[0]);
            return 1;
        }
    }
    io.writer_init(&out, io.STDOUT, out_buffer[:]);
    var offset: u32 = 0;
    var have: u32 = 0;
    while true {
        var n = io.read(file, buffer[have:]);
        if n == 0 || n == io.FAILED {
            break;
        }
        have += n;
        var done: u32 = 0;
        while have - done >= 16 {
            show_line(offset, buffer[done:done + 16]);
            offset += 16;
            done += 16;
        }
        mem.copy(buffer[:], buffer[done:have]);
        have -= done;
    }
    if have > 0 {
        show_line(offset, buffer[0:have]);
    }
    io.flush(&out);
    return 0;
}

fn put_digit(value: u32) {
    io.put_byte(&out, "0123456789abcdef"[value & 15]);
}

fn show_line(offset: u32, bytes: []u8) {
    io.put_hex(&out, offset);
    io.put(&out, "  ");
    for i in 0..16 {
        if i == 8 {
            io.put_byte(&out, ' ');
        }
        if i < bytes.len {
            put_digit((bytes[i] >> 4) as u32);
            put_digit(bytes[i] as u32);
            io.put_byte(&out, ' ');
        } else {
            io.put(&out, "   ");
        }
    }
    io.put(&out, " |");
    for i in 0..bytes.len {
        var c = bytes[i];
        if c < 32 || c > 126 {
            c = '.';
        }
        io.put_byte(&out, c);
    }
    io.put(&out, "|\n");
}
