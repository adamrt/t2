// kill stops processes by id.

manifest {
    memory = 64 * KiB;
    stack = 16 * KiB;
    allow = "processes recovery";
}

fn main(memory: []u8) -> u32 {
    var arena: Arena;
    arena_init(&arena, memory);
    var args: [32][]u8;
    var count = get_args(&arena, args[:]);
    var status: u32 = 0;
    for i in 0..count {
        var id = parse_u32(args[i]);
        if id == FAILED || kill(id) == FAILED {
            complain("kill", "no such process:", args[i]);
            status = 1;
        }
    }
    return status;
}
