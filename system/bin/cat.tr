// cat copies files, or its input, to its output.
//
//     cat [file...]

import io;
import mem;
import os;

manifest {
    memory = 128 * KiB;
    stack = 16 * KiB;
    allow = "read";
}

var arena: mem.Arena;
var buffer: [16 * KiB]u8;

fn main(memory: []u8) -> u32 {
    mem.arena_init(&arena, memory);
    var args: [64][]u8;
    var count = os.get_args(&arena, args[:]);
    if count == 0 {
        copy_file(io.STDIN);
        return 0;
    }
    var status: u32 = 0;
    for i in 0..count {
        var file = io.open(args[i], io.MODE_READ);
        if file == io.FAILED {
            os.complain("cat", "can't read", args[i]);
            status = 1;
            continue;
        }
        copy_file(file);
        io.close(file);
    }
    return status;
}

fn copy_file(file: u32) {
    while true {
        var n = io.read(file, buffer[:]);
        if n == 0 || n == io.FAILED {
            return;
        }
        if !io.write_all(io.STDOUT, buffer[0:n]) {
            return;
        }
    }
}
