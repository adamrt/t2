// mkdir makes directories. One that already exists is fine.

import io;
import mem;
import os;

manifest {
    memory = 64 * KiB;
    stack = 16 * KiB;
    allow = "read write";
}

fn main(memory: []u8) -> u32 {
    var arena: mem.Arena;
    mem.arena_init(&arena, memory);
    var args: [64][]u8;
    var count = os.get_args(&arena, args[:]);
    var status: u32 = 0;
    for i in 0..count {
        var existing: os.FileInfo;
        if os.make_dir(args[i]) == io.FAILED && (os.info(args[i], &existing) == io.FAILED || existing.kind != os.KIND_DIR) {
            os.complain("mkdir", "can't make", args[i]);
            status = 1;
        }
    }
    return status;
}
