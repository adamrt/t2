// mkdir makes directories.

manifest {
    memory = 64 * KiB;
    stack = 16 * KiB;
}

fn main(memory: []u8) -> u32 {
    var arena: Arena;
    arena_init(&arena, memory);
    var args: [32][]u8;
    var count = get_args(&arena, args[:]);
    var status: u32 = 0;
    for i in 0..count {
        if make_dir(args[i]) == FAILED {
            complain("mkdir", "can't make", args[i]);
            status = 1;
        }
    }
    return status;
}
