// mkdir makes directories. One that already exists is fine.

manifest {
    memory = 64 * KiB;
    stack = 16 * KiB;
    allow = "read write";
}

fn main(memory: []u8) -> u32 {
    var arena: Arena;
    arena_init(&arena, memory);
    var args: [32][]u8;
    var count = get_args(&arena, args[:]);
    var status: u32 = 0;
    for i in 0..count {
        var existing: FileInfo;
        if make_dir(args[i]) == FAILED && (info(args[i], &existing) == FAILED || existing.kind != KIND_DIR) {
            complain("mkdir", "can't make", args[i]);
            status = 1;
        }
    }
    return status;
}
