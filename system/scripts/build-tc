# Builds the compiler from its source, with the assembler from /lib/asm.tr,
# then has the new compiler build itself again and checks the two results
# are the same, and the same as the compiler the host built. The files are
# in the order the Makefile uses.
mkdir /tmp
tc -o /tmp/tc /src/tc/check.tr /src/tc/gen.tr /src/tc/lex.tr /src/tc/main.tr /src/tc/parse.tr /src/tc/types.tr
/tmp/tc -o /tmp/tc-again /src/tc/check.tr /src/tc/gen.tr /src/tc/lex.tr /src/tc/main.tr /src/tc/parse.tr /src/tc/types.tr
cmp /tmp/tc /tmp/tc-again
cmp /tmp/tc /bin/tc
