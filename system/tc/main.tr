// tc, the Terrarium compiler.
//
//     tc [-S] [-L library] [-r runtime.asm] [-s program.sym] -o program file...
//
// Compiles the .tr files, with the modules they import from the library
// (/lib unless -L names another), and assembles the result into a program,
// along with the library's runtime.asm (or the one -r names) and any .asm
// files. With only .asm files, it just assembles those. -S writes the
// compiled assembly instead of a program, and -s writes the program's
// labels, for the debugger. The language is described in docs/language.md.

import asm
import io
import mem
import os
import text

manifest {
    memory = 8 * MiB
    stack = 64 * KiB
    allow = "read write"
}

const MAX_FILES = 64
const MAX_MODULES = 32
const MAX_IMPORTS = 16
const MAX_ASSEMBLY = 2 * MiB        // the compiled assembly of one program

struct SourceFile {
    name []u8
    text []u8
    module u32                      // 0 for the program's own files
    imports [MAX_IMPORTS]u32
    import_count u32
}

var arena mem.Arena
var files [MAX_FILES]SourceFile
var file_count u32
var modules [MAX_MODULES][]u8       // their names; module 0 is the program
var module_count u32
var library []u8
var errors io.Writer
var error_buffer [512]u8

// What to assemble: the runtime, the .asm files, then the compiled code.
var pieces [MAX_FILES]asm.Source
var piece_count u32

fn main(memory []u8) u32 {
    mem.arena_init(&arena, memory)
    io.writer_init(&errors, io.STDERR, error_buffer[:])

    var output []u8
    var runtime []u8
    var symbols []u8
    var assembly_only = false
    library = "/lib"
    module_count = 1
    piece_count = 1                 // the runtime's place
    var i u32 = 0
    while i < os.arg_count() {
        var word = argument(i)
        i += 1
        if text.equal(word, "-S") {
            assembly_only = true
        } else if word.len == 2 && word[0] == '-' {
            if i == os.arg_count() {
                usage()
            }
            var value = argument(i)
            i += 1
            match word[1] {
                'o' => { output = value }
                'L' => { library = value }
                'r' => { runtime = value }
                's' => { symbols = value }
                else => { usage() }
            }
        } else if word.len > 4 && text.equal(word[word.len - 4:], ".asm") {
            add_piece(word, read_source(word))
        } else {
            add_file(word, 0)
        }
    }
    if output.len == 0 || file_count + piece_count == 1 {
        usage()
    }
    if assembly_only && (file_count == 0 || piece_count > 1) {
        usage()
    }

    // With only .asm files there's nothing to compile, and no runtime.
    var first u32 = 1
    if file_count > 0 {
        // Parsing a file can load the modules it imports, which adds files.
        var f u32 = 0
        while f < file_count {
            parse_file(f)
            f += 1
        }
        check_program()

        // A Writer whose file is FAILED keeps the assembly in its buffer,
        // and fails if it fills up.
        var buffer = mem.alloc_bytes(&arena, MAX_ASSEMBLY)
        io.writer_init(&out, io.FAILED, buffer)
        generate()
        if out.failed {
            fail_plain("the program is too large")
        }
        if assembly_only {
            write_file(output, buffer[0:out.used])
            return 0
        }
        if runtime.len == 0 {
            runtime = library_path("runtime.asm")
        }
        pieces[0].name = runtime
        pieces[0].text = read_source(runtime)
        add_piece("compiled code", buffer[0:out.used])
        first = 0
    }

    write_file(output, asm.assemble(&arena, pieces[first:piece_count]))
    if symbols.len > 0 {
        var file = io.open(symbols, io.MODE_WRITE)
        if file == io.FAILED {
            fail_path("can't write", symbols)
        }
        var w io.Writer
        io.writer_init(&w, file, mem.alloc_bytes(&arena, 16 * KiB))
        asm.put_symbols(&w)
        io.flush(&w)
        io.close(file)
        if w.failed {
            fail_path("can't write", symbols)
        }
    }
    return 0
}

fn add_piece(name []u8, bytes []u8) {
    if piece_count == MAX_FILES {
        fail_plain("too many files")
    }
    pieces[piece_count].name = name
    pieces[piece_count].text = bytes
    piece_count += 1
}

fn usage() {
    fail_plain("usage: tc [-S] [-L library] [-r runtime.asm] [-s program.sym] -o program file...")
}

fn write_file(path []u8, bytes []u8) {
    var file = io.open(path, io.MODE_WRITE)
    if file == io.FAILED || !io.write_all(file, bytes) {
        fail_path("can't write", path)
    }
    io.close(file)
}

fn add_file(path []u8, module u32) {
    if file_count == MAX_FILES {
        fail_plain("too many files")
    }
    files[file_count].name = path
    files[file_count].text = read_source(path)
    files[file_count].module = module
    file_count += 1
}

// The module with this name. The first time, its file is found in the
// library and added to those to parse.
fn load_module(name []u8) u32 {
    var m = module_named(name)
    if m != 0 {
        return m
    }
    if module_count == MAX_MODULES {
        parse_fail("too many modules")
    }
    var path = module_path(name)
    if path.len == 0 {
        error_start(tok.file, tok.line)
        io.put(&errors, "no module '")
        io.put(&errors, name)
        io.put(&errors, "' in ")
        io.put(&errors, library)
        error_end()
    }
    m = module_count
    modules[m] = name
    module_count += 1
    add_file(path, m)
    return m
}

// The path of a module's file in the library, or nothing if it isn't there.
fn module_path(name []u8) []u8 {
    var file_name = mem.alloc_bytes(&arena, name.len + 3)
    mem.copy(file_name, name)
    mem.copy(file_name[name.len:], ".tr")
    var path = library_path(file_name)
    var file = io.open(path, io.MODE_READ)
    if file == io.FAILED {
        return path[0:0]
    }
    io.close(file)
    return path
}

// A file in the library: library/name.
fn library_path(name []u8) []u8 {
    var path = mem.alloc_bytes(&arena, library.len + 1 + name.len)
    mem.copy(path, library)
    path[library.len] = '/'
    mem.copy(path[library.len + 1:], name)
    return path
}

// The loaded module with this name, or 0.
fn module_named(name []u8) u32 {
    for m in 1..module_count {
        if text.equal(modules[m], name) {
            return m
        }
    }
    return 0
}

// The module a file imports under this name, or 0.
fn imported(file u32, name []u8) u32 {
    var f = &files[file]
    for i in 0..f.import_count {
        if text.equal(modules[f.imports[i]], name) {
            return f.imports[i]
        }
    }
    return 0
}

fn argument(index u32) []u8 {
    var buffer = mem.alloc_bytes(&arena, 256)
    var n = os.arg(index, buffer)
    if n > buffer.len {
        fail_plain("argument is too long")
    }
    return buffer[0:n]
}

// Reads a whole file into the arena.
fn read_source(path []u8) []u8 {
    var file = io.open(path, 0)
    if file == io.FAILED {
        fail_path("can't read", path)
    }
    var start = (arena.used + 3) & ~3
    var free = arena.memory[start:]
    var n u32 = 0
    while true {
        if n == free.len {
            fail_path("out of memory reading", path)
        }
        var got = io.read(file, free[n:])
        if got == io.FAILED {
            fail_path("can't read", path)
        }
        if got == 0 {
            break
        }
        n += got
    }
    io.close(file)
    arena.used = start + n
    return free[0:n]
}

//
// Errors
//

// Starts an error message at a place in the source. Finish it with error_end().
fn error_start(file u32, line u32) {
    io.put(&errors, files[file].name)
    io.put_byte(&errors, ':')
    io.put_u32(&errors, line)
    io.put(&errors, ": ")
}

fn error_end() {
    io.put_byte(&errors, '\n')
    io.flush(&errors)
    os.exit(1)
}

fn fail(n *Node, message []u8) {
    error_start(n.file, n.line)
    io.put(&errors, message)
    error_end()
}

fn fail_name(n *Node, message []u8, name []u8) {
    error_start(n.file, n.line)
    io.put(&errors, message)
    io.put(&errors, " '")
    io.put(&errors, name)
    io.put(&errors, "'")
    error_end()
}

fn fail_plain(message []u8) {
    io.put(&errors, "tc: ")
    io.put(&errors, message)
    error_end()
}

fn fail_path(message []u8, path []u8) {
    io.put(&errors, "tc: ")
    io.put(&errors, message)
    io.put(&errors, " ")
    io.put(&errors, path)
    error_end()
}
