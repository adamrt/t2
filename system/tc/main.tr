// tc, the Terrarium compiler.
//
//     tc [-L library] -o program.asm file.tr...
//
// Reads every file, and the modules they import from the library (/lib
// unless -L names another), checks the whole program, and writes assembly
// for the Terrarium assembler. The language is described in
// spec/language.md.

import io
import mem
import os
import text

manifest {
    memory = 8 * MiB
    stack = 64 * KiB
    allow = "read write"
}

const MAX_FILES = 64
const MAX_MODULES = 32
const MAX_IMPORTS = 16

struct SourceFile {
    name []u8
    text []u8
    module u32                      // 0 for the program's own files
    imports [MAX_IMPORTS]u32
    import_count u32
}

var arena mem.Arena
var files [MAX_FILES]SourceFile
var file_count u32
var modules [MAX_MODULES][]u8       // their names; module 0 is the program
var module_count u32
var library []u8
var errors io.Writer
var error_buffer [512]u8

fn main(memory []u8) u32 {
    mem.arena_init(&arena, memory)
    io.writer_init(&errors, io.STDERR, error_buffer[:])

    var output []u8
    library = "/lib"
    module_count = 1
    var i u32 = 0
    while i < os.arg_count() {
        var word = argument(i)
        i += 1
        if text.equal(word, "-o") || text.equal(word, "-L") {
            if i == os.arg_count() {
                usage()
            }
            if text.equal(word, "-o") {
                output = argument(i)
            } else {
                library = argument(i)
            }
            i += 1
        } else {
            add_file(word, 0)
        }
    }
    if output.len == 0 || file_count == 0 {
        usage()
    }

    // Parsing a file can load the modules it imports, which adds files.
    var f u32 = 0
    while f < file_count {
        parse_file(f)
        f += 1
    }
    check_program()

    var file = io.open(output, 1)
    if file == io.FAILED {
        fail_path("can't write", output)
    }
    var buffer = mem.alloc_bytes(&arena, 64 * KiB)
    io.writer_init(&out, file, buffer)
    generate()
    io.flush(&out)
    io.close(file)
    return 0
}

fn usage() {
    fail_plain("usage: tc [-L library] -o program.asm file.tr...")
}

fn add_file(path []u8, module u32) {
    if file_count == MAX_FILES {
        fail_plain("too many files")
    }
    files[file_count].name = path
    files[file_count].text = read_source(path)
    files[file_count].module = module
    file_count += 1
}

// The module with this name. The first time, its file is found in the
// library and added to those to parse.
fn load_module(name []u8) u32 {
    var m = module_named(name)
    if m != 0 {
        return m
    }
    if module_count == MAX_MODULES {
        parse_fail("too many modules")
    }
    var path = module_path(name)
    if path.len == 0 {
        error_start(tok.file, tok.line)
        io.put(&errors, "no module '")
        io.put(&errors, name)
        io.put(&errors, "' in ")
        io.put(&errors, library)
        error_end()
    }
    m = module_count
    modules[m] = name
    module_count += 1
    add_file(path, m)
    return m
}

// The path of a module's file in the library, or nothing if it isn't there.
fn module_path(name []u8) []u8 {
    var path = mem.alloc_bytes(&arena, library.len + name.len + 4)
    mem.copy(path, library)
    path[library.len] = '/'
    mem.copy(path[library.len + 1:], name)
    mem.copy(path[library.len + 1 + name.len:], ".tr")
    var file = io.open(path, io.MODE_READ)
    if file == io.FAILED {
        return path[0:0]
    }
    io.close(file)
    return path
}

// The loaded module with this name, or 0.
fn module_named(name []u8) u32 {
    for m in 1..module_count {
        if text.equal(modules[m], name) {
            return m
        }
    }
    return 0
}

// The module a file imports under this name, or 0.
fn imported(file u32, name []u8) u32 {
    var f = &files[file]
    for i in 0..f.import_count {
        if text.equal(modules[f.imports[i]], name) {
            return f.imports[i]
        }
    }
    return 0
}

fn argument(index u32) []u8 {
    var buffer = mem.alloc_bytes(&arena, 256)
    var n = os.arg(index, buffer)
    if n > buffer.len {
        fail_plain("argument is too long")
    }
    return buffer[0:n]
}

// Reads a whole file into the arena.
fn read_source(path []u8) []u8 {
    var file = io.open(path, 0)
    if file == io.FAILED {
        fail_path("can't read", path)
    }
    var start = (arena.used + 3) & ~3
    var free = arena.memory[start:]
    var n u32 = 0
    while true {
        if n == free.len {
            fail_path("out of memory reading", path)
        }
        var got = io.read(file, free[n:])
        if got == io.FAILED {
            fail_path("can't read", path)
        }
        if got == 0 {
            break
        }
        n += got
    }
    io.close(file)
    arena.used = start + n
    return free[0:n]
}

// Errors ---------------------------------------------------------------------

// Starts an error message at a place in the source. Finish it with error_end().
fn error_start(file u32, line u32) {
    io.put(&errors, files[file].name)
    io.put_byte(&errors, ':')
    io.put_u32(&errors, line)
    io.put(&errors, ": ")
}

fn error_end() {
    io.put_byte(&errors, '\n')
    io.flush(&errors)
    os.exit(1)
}

fn fail(n *Node, message []u8) {
    error_start(n.file, n.line)
    io.put(&errors, message)
    error_end()
}

fn fail_name(n *Node, message []u8, name []u8) {
    error_start(n.file, n.line)
    io.put(&errors, message)
    io.put(&errors, " '")
    io.put(&errors, name)
    io.put(&errors, "'")
    error_end()
}

fn fail_plain(message []u8) {
    io.put(&errors, "tc: ")
    io.put(&errors, message)
    error_end()
}

fn fail_path(message []u8, path []u8) {
    io.put(&errors, "tc: ")
    io.put(&errors, message)
    io.put(&errors, " ")
    io.put(&errors, path)
    error_end()
}
