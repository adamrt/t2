// Windows and drawing. A Canvas collects GPU commands for a window, and
// present() sends them. The GPU reads text and images when the commands run,
// so the canvas keeps its own copy of any text; images must stay unchanged
// until present(). Coordinates are relative to the window's top left, and
// colors are 0xAARRGGBB. The GPU commands are described in spec/devices.md.

import mem

const EVENT_DRAW u32 = 1
const EVENT_KEY_DOWN u32 = 2
const EVENT_KEY_UP u32 = 3
const EVENT_TEXT u32 = 4
const EVENT_MOUSE_MOVE u32 = 5
const EVENT_MOUSE_DOWN u32 = 6
const EVENT_MOUSE_UP u32 = 7
const EVENT_WHEEL u32 = 8
const EVENT_CLOSE u32 = 9
const EVENT_RESIZE u32 = 10        // x and y are the new width and height

const KEY_BACKSPACE u32 = 8
const KEY_TAB u32 = 9
const KEY_ENTER u32 = 10
const KEY_ESCAPE u32 = 27
const KEY_DELETE u32 = 127
const KEY_LEFT u32 = 0x100
const KEY_RIGHT u32 = 0x101
const KEY_UP u32 = 0x102
const KEY_DOWN u32 = 0x103
const KEY_HOME u32 = 0x104
const KEY_END u32 = 0x105
const KEY_PAGE_UP u32 = 0x106
const KEY_PAGE_DOWN u32 = 0x107
const KEY_F1 u32 = 0x110

const MOD_SHIFT u32 = 1
const MOD_CTRL u32 = 2
const MOD_ALT u32 = 4
const MOD_SUPER u32 = 8

const FOREVER u32 = 0xffffffff

struct ScreenInfo {
    width u32
    height u32
    font_width u32
    font_height u32
}

struct Event {
    kind u32
    window u32
    x i32
    y i32
    key u32             // a key, or for EVENT_TEXT a character's Unicode number
    modifiers u32
    buttons u32         // buttons held, or the button pressed or released
    reserved u32
}

// An image of 0xAARRGGBB pixels, row after row.
struct Image {
    width u32
    height u32
    pixels []u32
}

fn window_open(title []u8, width u32, height u32) u32
fn window_draw(window u32, commands []u32) u32
// Lets the window be resized with the grow box in its corner, and zoomed.
fn window_resizable(window u32, min_width u32, min_height u32) u32
fn window_title(window u32, title []u8) u32
fn event_wait(event *Event, timeout u32) u32
fn screen_info(info *ScreenInfo) u32
// Keeps text for another program to paste (at most 64 KiB).
fn clipboard_set(text []u8) u32
// Copies the clipboard into buffer and returns its whole length.
fn clipboard_get(buffer []u8) u32

fn rgb(r u32, g u32, b u32) u32 {
    return 0xff000000 | (r << 16) | (g << 8) | b
}

struct Canvas {
    window u32
    words []u32
    used u32
    strings []u8
    strings_used u32
}

// The canvas keeps commands in words and copies of text in strings.
fn canvas_init(c *Canvas, window u32, words []u32, strings []u8) {
    c.window = window
    c.words = words
    c.used = 0
    c.strings = strings
    c.strings_used = 0
}

// Sends the collected commands to the window.
fn present(c *Canvas) {
    if c.used > 0 {
        window_draw(c.window, c.words[0:c.used])
        c.used = 0
    }
    c.strings_used = 0
}

// Starts a command of n words, sending earlier ones first if they won't fit.
fn canvas_begin(c *Canvas, n u32) {
    if c.used + n > c.words.len {
        present(c)
    }
}

fn canvas_word(c *Canvas, word u32) {
    c.words[c.used] = word
    c.used += 1
}

fn draw_fill(c *Canvas, x i32, y i32, w i32, h i32, color u32) {
    canvas_begin(c, 6)
    canvas_word(c, 1)
    canvas_word(c, x as u32)
    canvas_word(c, y as u32)
    canvas_word(c, w as u32)
    canvas_word(c, h as u32)
    canvas_word(c, color)
}

fn draw_line(c *Canvas, x0 i32, y0 i32, x1 i32, y1 i32, color u32) {
    canvas_begin(c, 6)
    canvas_word(c, 2)
    canvas_word(c, x0 as u32)
    canvas_word(c, y0 as u32)
    canvas_word(c, x1 as u32)
    canvas_word(c, y1 as u32)
    canvas_word(c, color)
}

fn draw_image(c *Canvas, image *Image, sx i32, sy i32, w i32, h i32, dx i32, dy i32, blend bool) {
    canvas_begin(c, 11)
    canvas_word(c, 3)
    canvas_word(c, image.pixels.ptr as u32)
    canvas_word(c, image.width)
    canvas_word(c, image.height)
    canvas_word(c, sx as u32)
    canvas_word(c, sy as u32)
    canvas_word(c, w as u32)
    canvas_word(c, h as u32)
    canvas_word(c, dx as u32)
    canvas_word(c, dy as u32)
    canvas_word(c, blend as u32)
}

fn draw_text_scaled(c *Canvas, x i32, y i32, color u32, text []u8, scale u32) {
    if text.len > c.strings.len {
        text = text[0:c.strings.len]
    }
    if text.len > c.strings.len - c.strings_used {
        present(c)
    }
    var copied = c.strings[c.strings_used:c.strings_used + text.len]
    mem.copy(copied, text)
    c.strings_used += text.len
    canvas_begin(c, 7)
    canvas_word(c, 4)
    canvas_word(c, x as u32)
    canvas_word(c, y as u32)
    canvas_word(c, color)
    canvas_word(c, copied.ptr as u32)
    canvas_word(c, copied.len)
    canvas_word(c, scale)
}

fn draw_text(c *Canvas, x i32, y i32, color u32, text []u8) {
    draw_text_scaled(c, x, y, color, text, 1)
}

// A triangle whose color blends between the colors of its corners.
fn draw_triangle(c *Canvas, x0 i32, y0 i32, c0 u32, x1 i32, y1 i32, c1 u32, x2 i32, y2 i32, c2 u32) {
    canvas_begin(c, 10)
    canvas_word(c, 5)
    canvas_word(c, x0 as u32)
    canvas_word(c, y0 as u32)
    canvas_word(c, c0)
    canvas_word(c, x1 as u32)
    canvas_word(c, y1 as u32)
    canvas_word(c, c1)
    canvas_word(c, x2 as u32)
    canvas_word(c, y2 as u32)
    canvas_word(c, c2)
}

// A triangle covered with part of an image. Each corner gives a position and
// the image pixel (u, v) that goes there. The tint multiplies every pixel.
fn draw_textured(c *Canvas, image *Image, x0 i32, y0 i32, u0 i32, v0 i32, x1 i32, y1 i32, u1 i32, v1 i32, x2 i32, y2 i32, u2 i32, v2 i32, tint u32) {
    canvas_begin(c, 17)
    canvas_word(c, 6)
    canvas_word(c, image.pixels.ptr as u32)
    canvas_word(c, image.width)
    canvas_word(c, image.height)
    canvas_word(c, x0 as u32)
    canvas_word(c, y0 as u32)
    canvas_word(c, u0 as u32)
    canvas_word(c, v0 as u32)
    canvas_word(c, x1 as u32)
    canvas_word(c, y1 as u32)
    canvas_word(c, u1 as u32)
    canvas_word(c, v1 as u32)
    canvas_word(c, x2 as u32)
    canvas_word(c, y2 as u32)
    canvas_word(c, u2 as u32)
    canvas_word(c, v2 as u32)
    canvas_word(c, tint)
}

// Limits the following commands to a rectangle, until unclip().
fn set_clip(c *Canvas, x i32, y i32, w i32, h i32) {
    canvas_begin(c, 5)
    canvas_word(c, 7)
    canvas_word(c, x as u32)
    canvas_word(c, y as u32)
    canvas_word(c, w as u32)
    canvas_word(c, h as u32)
}

fn clear_clip(c *Canvas) {
    set_clip(c, 0, 0, -1, -1)
}
