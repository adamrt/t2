// The core library: memory, text and output.

const STDIN: u32 = 0;
const STDOUT: u32 = 1;
const STDERR: u32 = 2;
const FAILED: u32 = 0xffffffff;

fn exit(status: u32);
fn read(file: u32, buffer: []u8) -> u32;
fn write(file: u32, bytes: []u8) -> u32;
fn open(path: []u8, mode: u32) -> u32;
fn close(file: u32) -> u32;
fn arg_count() -> u32;
fn arg(index: u32, buffer: []u8) -> u32;
fn mem_copy(to: *u8, from: *u8, count: u32);
fn mem_fill(to: *u8, value: u32, count: u32);
fn stop();

fn panic(message: []u8) {
    write(STDERR, "panic: ");
    write(STDERR, message);
    write(STDERR, "\n");
    stop();
}

// Memory ---------------------------------------------------------------------

// An arena hands out memory from one block and frees it all at once.
struct Arena {
    memory: []u8;
    used: u32;
}

fn arena_init(a: *Arena, memory: []u8) {
    a.memory = memory;
    a.used = 0;
}

// Returns size bytes aligned to 4. The memory is zero, because a program's
// memory starts zeroed and reset() zeroes what it gives back.
fn alloc(a: *Arena, size: u32) -> *u8 {
    var start = (a.used + 3) & ~3;
    if size > a.memory.len || start > a.memory.len - size {
        panic("out of memory");
    }
    a.used = start + size;
    return (a.memory.ptr as u32 + start) as *u8;
}

// Takes a block of size bytes, for example to give to another arena.
fn alloc_bytes(a: *Arena, size: u32) -> []u8 {
    return alloc(a, size)[0:size];
}

fn reset(a: *Arena) {
    mem_fill(a.memory.ptr, 0, a.used);
    a.used = 0;
}

// Text -----------------------------------------------------------------------

fn text_equal(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn copy(to: []u8, from: []u8) {
    if to.len < from.len {
        panic("copy doesn't fit");
    }
    mem_copy(to.ptr, from.ptr, from.len);
}

// Little-endian words, as Terrarium's formats store them.
fn read_word(bytes: []u8, offset: u32) -> u32 {
    return bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24);
}

fn write_word(bytes: []u8, offset: u32, value: u32) {
    bytes[offset] = (value & 255) as u8;
    bytes[offset + 1] = ((value >> 8) & 255) as u8;
    bytes[offset + 2] = ((value >> 16) & 255) as u8;
    bytes[offset + 3] = (value >> 24) as u8;
}

fn is_digit(c: u8) -> bool {
    return c >= '0' && c <= '9';
}

fn is_letter(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

// Text is UTF-8. These count and step over its characters, which take one to
// four bytes each. A byte that isn't part of a whole character counts as one
// on its own, the way the GPU draws it: as "?".

fn is_continuation(c: u8) -> bool {
    return (c & 0xc0) == 0x80;
}

// The bytes in the character that starts at text[at].
fn char_length(text: []u8, at: u32) -> u32 {
    var b = text[at];
    var more: u32 = 0;
    if b >= 0xc2 && b < 0xe0 {
        more = 1;
    } else if b >= 0xe0 && b < 0xf0 {
        more = 2;
    } else if b >= 0xf0 && b < 0xf5 {
        more = 3;
    }
    if more >= text.len - at {
        return 1;
    }
    for k in 1..more + 1 {
        if !is_continuation(text[at + k]) {
            return 1;
        }
    }
    return more + 1;
}

fn char_count(text: []u8) -> u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    while i < text.len {
        i += char_length(text, i);
        n += 1;
    }
    return n;
}

// Where the character that ends at text[end] starts.
fn char_start(text: []u8, end: u32) -> u32 {
    for k in 2..5 {
        if end >= k && char_length(text, end - k) == k {
            return end - k;
        }
    }
    if end == 0 {
        return 0;
    }
    return end - 1;
}

// Writes a character as UTF-8 at the start of out. Returns the bytes it
// took, or 0 if it didn't fit.
fn encode_char(c: u32, out: []u8) -> u32 {
    var n: u32 = 4;
    if c < 0x80 {
        n = 1;
    } else if c < 0x800 {
        n = 2;
    } else if c < 0x10000 {
        n = 3;
    }
    if out.len < n {
        return 0;
    }
    if n == 1 {
        out[0] = c as u8;
        return 1;
    }
    for i in 1..n {
        out[n - i] = (0x80 | ((c >> (6 * (i - 1))) & 0x3f)) as u8;
    }
    var lead: u32 = 0xf0;
    if n == 2 {
        lead = 0xc0;
    } else if n == 3 {
        lead = 0xe0;
    }
    out[0] = (lead | (c >> (6 * (n - 1)))) as u8;
    return n;
}

// Output ---------------------------------------------------------------------

// Collects output in a buffer and writes it in large pieces.
struct Writer {
    file: u32;
    buffer: []u8;
    used: u32;
}

fn writer_init(w: *Writer, file: u32, buffer: []u8) {
    w.file = file;
    w.buffer = buffer;
    w.used = 0;
}

// Writes all the bytes, unless the file fails.
fn write_all(file: u32, bytes: []u8) -> bool {
    var done: u32 = 0;
    while done < bytes.len {
        var n = write(file, bytes[done:]);
        if n == 0 || n == FAILED {
            return false;
        }
        done += n;
    }
    return true;
}

fn flush(w: *Writer) {
    if w.used > 0 {
        write_all(w.file, w.buffer[0:w.used]);
        w.used = 0;
    }
}

fn put(w: *Writer, text: []u8) {
    if text.len > w.buffer.len - w.used {
        flush(w);
        if text.len > w.buffer.len {
            write_all(w.file, text);
            return;
        }
    }
    copy(w.buffer[w.used:], text);
    w.used += text.len;
}

fn put_byte(w: *Writer, c: u8) {
    if w.used == w.buffer.len {
        flush(w);
    }
    w.buffer[w.used] = c;
    w.used += 1;
}

fn put_u32(w: *Writer, value: u32) {
    var digits: [10]u8;
    var n: u32 = 10;
    var v = value;
    while true {
        n -= 1;
        digits[n] = (v % 10 + '0') as u8;
        v /= 10;
        if v == 0 {
            break;
        }
    }
    put(w, digits[n:]);
}

fn put_i32(w: *Writer, value: i32) {
    if value < 0 {
        put_byte(w, '-');
        put_u32(w, (0 - value) as u32);
        return;
    }
    put_u32(w, value as u32);
}

fn put_hex(w: *Writer, value: u32) {
    var shift: u32 = 32;
    while shift > 0 {
        shift -= 4;
        put_byte(w, "0123456789abcdef"[(value >> shift) & 15]);
    }
}

// Writes text straight to standard output.
fn print(text: []u8) {
    write_all(STDOUT, text);
}

// Input ------------------------------------------------------------------------

// Reads a file a buffer at a time and hands out lines.
struct Reader {
    file: u32;
    buffer: []u8;
    start: u32;
    end: u32;
    done: bool;
}

fn reader_init(r: *Reader, file: u32, buffer: []u8) {
    r.file = file;
    r.buffer = buffer;
    r.start = 0;
    r.end = 0;
    r.done = false;
}

// Copies the next line, without its newline, into out and returns its
// length. A line longer than out is cut short. Returns FAILED at the end.
fn read_line(r: *Reader, out: []u8) -> u32 {
    var n: u32 = 0;
    while true {
        if r.start == r.end {
            if r.done {
                if n == 0 {
                    return FAILED;
                }
                return n;
            }
            r.start = 0;
            r.end = read(r.file, r.buffer);
            if r.end == 0 || r.end == FAILED {
                r.end = 0;
                r.done = true;
            }
            continue;
        }
        var c = r.buffer[r.start];
        r.start += 1;
        if c == '\n' {
            return n;
        }
        if n < out.len {
            out[n] = c;
            n += 1;
        }
    }
    return n;
}

// Turns decimal text into a number. Returns FAILED if it isn't one.
fn parse_u32(text: []u8) -> u32 {
    if text.len == 0 {
        return FAILED;
    }
    var value: u32 = 0;
    for i in 0..text.len {
        if !is_digit(text[i]) {
            return FAILED;
        }
        value = value * 10 + (text[i] - '0');
    }
    return value;
}
