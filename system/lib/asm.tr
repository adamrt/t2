// Assembling: Terrarium assembly in, a program out. spec/assembly.md
// describes the language, and spec/executable.md the program. tc assembles
// what it compiles with this.
//
// The sources are read twice. The first pass learns where every label is
// and how big each section is; the second encodes every instruction.

import io
import mem
import os
import text

// A piece of assembly: its name, for messages, and its text.
struct Source {
    name []u8
    text []u8
}

const BASE = 0x10000                // where code and data start in memory
const HEADER_SIZE = 32
const DEFAULT_STACK = 0x10000
const SLOTS = 0x8000                // in the symbol table, a power of two
const MAX_SYMBOLS = 0x6000
const TOKENS = 64                   // at most 63 a line, then End
const STRINGS_SIZE = 1024           // for the decoded strings of a line

// The sections, which number the offsets, and a symbol's kind besides.
const CODE = 0
const DATA = 1
const BSS = 2
const CONSTANT = 3

// Opcodes, named as in spec/isa.md.
const LI = 0x01
const LIH = 0x02
const ADDI = 0x20
const LD = 0x30
const ST = 0x34
const BZ = 0x46
const BNZ = 0x47
const JMP = 0x50
const CALL = 0x51
const CALLR = 0x52
const RET = 0x53
const PUSH = 0x60
const POP = 0x61
const COPY = 0x70
const FILL = 0x71
const SYS = 0x80
const IN = 0x90
const OUT = 0x91
const RESUME = 0x92
const WAIT = 0x93
const HALT = 0xff

enum Kind {
    End, Name, Register, Number, String,

    If, Goto, Call, Return, Push, Pop, Copy, Fill, Sys, Halt, Io, Resume, Wait, U8, U16,

    DotCode, DotData, DotBss, DotByte, DotZero, DotMemory, DotStack, DotAllow,

    Plus, Minus, Times, Divide, DivideSigned, Remainder, RemainderSigned,
    And, Or, Xor, ShiftLeft, ShiftRight, ShiftRightSigned, TimesFixed, DivideFixed,
    Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual,
    LessSigned, LessEqualSigned, GreaterSigned, GreaterEqualSigned,
    Assign, LBracket, RBracket, Comma, Colon,
}

struct Token {
    kind Kind
    value u32           // a number's value, or a register's number
    text []u8           // a name's text, or a string's decoded bytes
}

struct Symbol {
    name []u8           // empty in a free slot
    kind u32            // CODE, DATA or BSS for a label, or CONSTANT
    value u32           // a constant's value, or a label's offset in its section
    line u32            // where it's defined, counting every line of every source
}

// .memory, .stack and .allow, which may each be given once.
struct Setting {
    value u32
    given bool
}

var sources []Source
var source u32                      // the one being read
var input []u8                      // its text
var pos u32
var line u32                        // in that source
var all_lines u32                   // in every source so far
var pass u32
var section u32
var offsets [3]u32                  // in code, data and bss
var bss_base u32
var code []u8
var data []u8
var symbols []Symbol
var symbol_count u32
var tokens [TOKENS]Token
var cursor u32
var strings [STRINGS_SIZE]u8
var memory_size Setting
var stack_size Setting
var allowed Setting
var errors io.Writer
var error_buffer [256]u8

// Assembles the sources, in order, into a program in the arena, and returns
// it. A mistake stops with a message.
fn assemble(arena *mem.Arena, all []Source) []u8 {
    sources = all
    symbols = new(arena, Symbol, SLOTS)
    symbol_count = 0
    read_all(1)
    bss_base = BASE + align4(offsets[DATA])
    var program = mem.alloc_bytes(arena, HEADER_SIZE + offsets[CODE] + offsets[DATA])
    code = program[HEADER_SIZE:HEADER_SIZE + offsets[CODE]]
    data = program[HEADER_SIZE + offsets[CODE]:]
    read_all(2)

    var start = find_symbol("start")
    if start.name.len == 0 || start.kind != CODE {
        fail("no 'start' label in .code")
    }
    var stack u32 = DEFAULT_STACK
    if stack_size.given {
        stack = stack_size.value
    }
    var need = offsets[CODE] + align4(offsets[DATA]) + align4(offsets[BSS]) + stack
    var memory = need
    if memory_size.given {
        memory = memory_size.value
    }
    memory = align4(memory)
    if memory < need {
        fail(".memory is smaller than the program")
    }
    mem.copy(program, "TRX2")
    mem.write_word(program, 4, label_address(start))
    mem.write_word(program, 8, offsets[CODE])
    mem.write_word(program, 12, offsets[DATA])
    mem.write_word(program, 16, offsets[BSS])
    mem.write_word(program, 20, stack)
    mem.write_word(program, 24, memory)
    mem.write_word(program, 28, allowed.value)
    return program
}

// Writes a line like "c 00010000 start" for each label of the program just
// assembled, c for code and d for data, in the symbol table's order.
fn put_symbols(w *io.Writer) {
    for i in 0..symbols.len {
        var s = &symbols[i]
        if s.name.len > 0 && s.kind != CONSTANT {
            if s.kind == CODE {
                io.put(w, "c ")
            } else {
                io.put(w, "d ")
            }
            io.put_hex(w, label_address(s))
            io.put_byte(w, ' ')
            io.put(w, s.name)
            io.put_byte(w, '\n')
        }
    }
}

// One pass over every source, a line at a time.
fn read_all(which u32) {
    pass = which
    section = CODE
    offsets[CODE] = 0
    offsets[DATA] = 0
    offsets[BSS] = 0
    all_lines = 0
    memory_size.given = false
    stack_size.given = false
    allowed.given = false
    source = 0
    while source < sources.len {
        input = sources[source].text
        pos = 0
        line = 0
        while pos < input.len {
            line += 1
            all_lines += 1
            tokenize()
            statement()
        }
        source += 1
    }
}

fn align4(n u32) u32 {
    return (n + 3) & ~3
}

// Errors ---------------------------------------------------------------------

fn fail(message []u8) {
    fail_name(message, "")
}

// Stops with "source:line: message 'name'", or with "asm: message" once the
// passes are over.
fn fail_name(message []u8, name []u8) {
    io.writer_init(&errors, io.STDERR, error_buffer[:])
    if source < sources.len {
        io.put(&errors, sources[source].name)
        io.put_byte(&errors, ':')
        io.put_u32(&errors, line)
        io.put(&errors, ": ")
    } else {
        io.put(&errors, "asm: ")
    }
    io.put(&errors, message)
    if name.len > 0 {
        io.put(&errors, " '")
        io.put(&errors, name)
        io.put_byte(&errors, '\'')
        // Compiled names start with '_', and one nothing defines is usually
        // a function declared without a body.
        if name[0] == '_' && text.equal(message, "undefined name") {
            io.put(&errors, " (functions without a body are defined in assembly, as in /lib/runtime.asm)")
        }
    }
    io.put_byte(&errors, '\n')
    io.flush(&errors)
    os.exit(1)
}

// Tokens ---------------------------------------------------------------------

fn char_at(offset u32) u8 {
    if pos + offset >= input.len {
        return 0
    }
    return input[pos + offset]
}

// Names are letters, digits, '_' and '.', as in _io.write, and start with a
// letter or '_'.
fn is_name_char(c u8) bool {
    return text.is_letter(c) || text.is_digit(c) || c == '.'
}

fn read_word() []u8 {
    var start = pos
    while pos < input.len && is_name_char(input[pos]) {
        pos += 1
    }
    return input[start:pos]
}

// Splits the line at pos into tokens, and moves pos to the next line.
fn tokenize() {
    var n u32 = 0
    var used u32 = 0
    cursor = 0
    while pos < input.len {
        var c = input[pos]
        if c == '\n' {
            pos += 1
            break
        }
        if c == ' ' || c == '\t' || c == '\r' {
            pos += 1
            continue
        }
        if c == ';' {
            while pos < input.len && input[pos] != '\n' {
                pos += 1
            }
            continue
        }
        if n == TOKENS - 1 {
            fail("line is too long")
        }
        var t = &tokens[n]
        n += 1
        t.value = 0
        if c == '.' && text.is_letter(char_at(1)) {
            pos += 1
            t.kind = directive(read_word())
        } else if text.is_digit(c) {
            t.kind = Kind.Number
            t.value = parse_number(read_word())
        } else if text.is_letter(c) {
            t.text = read_word()
            t.value = register_number(t.text)
            if t.value < 9 {
                t.kind = Kind.Register
            } else {
                t.kind = keyword(t.text)
            }
        } else if c == '\'' {
            pos += 1
            t.kind = Kind.Number
            t.value = read_char()
            if char_at(0) != '\'' {
                fail("unterminated character")
            }
            pos += 1
        } else if c == '"' {
            pos += 1
            var start = used
            while char_at(0) != '"' {
                if pos >= input.len || input[pos] == '\n' {
                    fail("unterminated string")
                }
                if used == STRINGS_SIZE {
                    fail("line is too long")
                }
                strings[used] = read_char() as u8
                used += 1
            }
            pos += 1
            t.kind = Kind.String
            t.text = strings[start:used]
        } else {
            t.kind = read_operator()
        }
    }
    tokens[n].kind = Kind.End
}

// A register's number, sp being 8, or 99 if the word isn't one.
fn register_number(word []u8) u32 {
    if word.len != 2 {
        return 99
    }
    if word[0] == 's' && word[1] == 'p' {
        return 8
    }
    if word[0] == 'r' && word[1] >= '0' && word[1] < '8' {
        return word[1] - '0'
    }
    return 99
}

fn keyword(word []u8) Kind {
    match word[0] {
        'c' => {
            if text.equal(word, "call") { return Kind.Call }
            if text.equal(word, "copy") { return Kind.Copy }
        }
        'f' => {
            if text.equal(word, "fill") { return Kind.Fill }
        }
        'g' => {
            if text.equal(word, "goto") { return Kind.Goto }
        }
        'h' => {
            if text.equal(word, "halt") { return Kind.Halt }
        }
        'i' => {
            if text.equal(word, "if") { return Kind.If }
            if text.equal(word, "io") { return Kind.Io }
        }
        'p' => {
            if text.equal(word, "push") { return Kind.Push }
            if text.equal(word, "pop") { return Kind.Pop }
        }
        'r' => {
            if text.equal(word, "return") { return Kind.Return }
            if text.equal(word, "resume") { return Kind.Resume }
        }
        's' => {
            if text.equal(word, "sys") { return Kind.Sys }
        }
        'u' => {
            if text.equal(word, "u8") { return Kind.U8 }
            if text.equal(word, "u16") { return Kind.U16 }
        }
        'w' => {
            if text.equal(word, "wait") { return Kind.Wait }
        }
    }
    return Kind.Name
}

fn directive(word []u8) Kind {
    if text.equal(word, "code") { return Kind.DotCode }
    if text.equal(word, "data") { return Kind.DotData }
    if text.equal(word, "bss") { return Kind.DotBss }
    if text.equal(word, "byte") { return Kind.DotByte }
    if text.equal(word, "zero") { return Kind.DotZero }
    if text.equal(word, "memory") { return Kind.DotMemory }
    if text.equal(word, "stack") { return Kind.DotStack }
    if text.equal(word, "allow") { return Kind.DotAllow }
    fail("unknown directive")
    return Kind.End
}

fn digit_value(c u8) u32 {
    if c >= '0' && c <= '9' {
        return c - '0'
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10
    }
    return 99
}

// A decimal number, or hexadecimal after 0x.
fn parse_number(word []u8) u32 {
    var base u32 = 10
    var i u32 = 0
    if word.len >= 2 && word[0] == '0' {
        if word[1] != 'x' && word[1] != 'X' || word.len == 2 {
            fail("bad number")
        }
        base = 16
        i = 2
    }
    var value u32 = 0
    while i < word.len {
        var digit = digit_value(word[i])
        if digit >= base || value > (0xffffffff - digit) / base {
            fail("bad number")
        }
        value = value * base + digit
        i += 1
    }
    return value
}

// Reads a character or an escape, and moves past it.
fn read_char() u32 {
    if pos >= input.len || input[pos] == '\n' {
        fail("unterminated character")
    }
    var c = input[pos]
    pos += 1
    if c != '\\' {
        return c
    }
    var e = char_at(0)
    pos += 1
    match e {
        'n' => { return '\n' }
        't' => { return '\t' }
        'r' => { return '\r' }
        '0' => { return 0 }
        '\\', '\'', '"' => { return e }
    }
    fail("bad escape")
    return 0
}

// Takes c after an operator, as in /s, unless a name follows: "/size" is
// '/' and then "size".
fn suffix(c u8) bool {
    if char_at(0) == c && !is_name_char(char_at(1)) {
        pos += 1
        return true
    }
    return false
}

// Reads an operator. A compound assignment like += is two: + and then =.
fn read_operator() Kind {
    var c = input[pos]
    pos += 1
    match c {
        '+' => { return Kind.Plus }
        '-' => { return Kind.Minus }
        '&' => { return Kind.And }
        '|' => { return Kind.Or }
        '^' => { return Kind.Xor }
        '[' => { return Kind.LBracket }
        ']' => { return Kind.RBracket }
        ',' => { return Kind.Comma }
        ':' => { return Kind.Colon }
        '*' => {
            if suffix('f') { return Kind.TimesFixed }
            return Kind.Times
        }
        '/' => {
            if suffix('s') { return Kind.DivideSigned }
            if suffix('f') { return Kind.DivideFixed }
            return Kind.Divide
        }
        '%' => {
            if suffix('s') { return Kind.RemainderSigned }
            return Kind.Remainder
        }
        '=' => {
            if char_at(0) == '=' { pos += 1; return Kind.Equal }
            return Kind.Assign
        }
        '!' => {
            if char_at(0) == '=' { pos += 1; return Kind.NotEqual }
        }
        '<' => {
            if char_at(0) == '<' { pos += 1; return Kind.ShiftLeft }
            if char_at(0) == '=' {
                pos += 1
                if suffix('s') { return Kind.LessEqualSigned }
                return Kind.LessEqual
            }
            if suffix('s') { return Kind.LessSigned }
            return Kind.Less
        }
        '>' => {
            if char_at(0) == '>' {
                pos += 1
                if suffix('s') { return Kind.ShiftRightSigned }
                return Kind.ShiftRight
            }
            if char_at(0) == '=' {
                pos += 1
                if suffix('s') { return Kind.GreaterEqualSigned }
                return Kind.GreaterEqual
            }
            if suffix('s') { return Kind.GreaterSigned }
            return Kind.Greater
        }
    }
    fail("unexpected character")
    return Kind.End
}

// The arithmetic instruction an operator stands for, or 0. Adding 0x10
// gives the one that takes a constant.
fn alu_opcode(kind Kind) u32 {
    match kind {
        Kind.Plus => { return 0x10 }
        Kind.Minus => { return 0x11 }
        Kind.Times => { return 0x12 }
        Kind.Divide => { return 0x13 }
        Kind.DivideSigned => { return 0x14 }
        Kind.Remainder => { return 0x15 }
        Kind.RemainderSigned => { return 0x16 }
        Kind.And => { return 0x17 }
        Kind.Or => { return 0x18 }
        Kind.Xor => { return 0x19 }
        Kind.ShiftLeft => { return 0x1a }
        Kind.ShiftRight => { return 0x1b }
        Kind.ShiftRightSigned => { return 0x1c }
        Kind.TimesFixed => { return 0x1d }
        Kind.DivideFixed => { return 0x1e }
    }
    return 0
}

// The branch instruction a comparison stands for, or 0. Those without one
// of their own swap the operands: a > b is b < a.
fn branch_opcode(kind Kind) u32 {
    match kind {
        Kind.Equal => { return 0x40 }
        Kind.NotEqual => { return 0x41 }
        Kind.Less, Kind.Greater => { return 0x42 }
        Kind.GreaterEqual, Kind.LessEqual => { return 0x43 }
        Kind.LessSigned, Kind.GreaterSigned => { return 0x44 }
        Kind.GreaterEqualSigned, Kind.LessEqualSigned => { return 0x45 }
    }
    return 0
}

fn swaps(kind Kind) bool {
    match kind {
        Kind.Greater, Kind.LessEqual, Kind.GreaterSigned, Kind.LessEqualSigned => { return true }
    }
    return false
}

// Reading tokens -------------------------------------------------------------

fn peek() *Token {
    return &tokens[cursor]
}

fn next() *Token {
    cursor += 1
    return &tokens[cursor - 1]
}

fn take(kind Kind) bool {
    if tokens[cursor].kind == kind {
        cursor += 1
        return true
    }
    return false
}

fn expect(kind Kind, what []u8) {
    if !take(kind) {
        fail_name("expected", what)
    }
}

fn expect_register() u32 {
    if peek().kind != Kind.Register {
        fail("expected a register")
    }
    return next().value
}

fn expect_end() {
    if peek().kind != Kind.End {
        fail("unexpected text at end of line")
    }
}

// An optional u8 or u16 before a memory operand: what to add to the opcode
// that loads or stores 32 bits.
fn size_prefix() u32 {
    if take(Kind.U16) {
        return 1
    }
    if take(Kind.U8) {
        return 2
    }
    return 0
}

// Symbols --------------------------------------------------------------------

// The symbol with this name, or the free slot where it belongs.
fn find_symbol(name []u8) *Symbol {
    var h u32 = 0x811c9dc5
    for i in 0..name.len {
        h = (h ^ name[i]) * 0x01000193
    }
    while true {
        var s = &symbols[h & (SLOTS - 1)]
        if s.name.len == 0 || text.equal(s.name, name) {
            return s
        }
        h += 1
    }
    return null
}

fn define(name []u8, kind u32, value u32) {
    var s = find_symbol(name)
    if pass == 2 {
        if s.kind != kind || s.value != value {
            fail_name("internal error, symbol moved between passes:", name)
        }
        return
    }
    if s.name.len > 0 {
        fail_name("already defined:", name)
    }
    s.name = name
    s.kind = kind
    s.value = value
    s.line = all_lines
    symbol_count += 1
    if symbol_count == MAX_SYMBOLS {
        fail("too many symbols")
    }
}

fn label_address(s *Symbol) u32 {
    if s.kind == BSS {
        return bss_base + s.value
    }
    return BASE + s.value
}

// Values ---------------------------------------------------------------------

// A number, or the name of a constant or a label, with an optional '-'
// before it. Sets *label when it's a label, whose address is 0 in the first
// pass.
fn value(label *bool) u32 {
    var negate = take(Kind.Minus)
    var t = next()
    var v u32 = 0
    *label = false
    if t.kind == Kind.Number {
        v = t.value
    } else if t.kind == Kind.Name {
        var s = find_symbol(t.text)
        if s.name.len > 0 && s.kind == CONSTANT {
            if s.line >= all_lines {
                fail_name("constant used before its definition:", t.text)
            }
            v = s.value
        } else {
            *label = true
            if pass == 1 {
                return 0
            }
            if s.name.len == 0 {
                fail_name("undefined name", t.text)
            }
            if negate {
                fail("a label can't be negated")
            }
            return label_address(s)
        }
    } else {
        fail("expected a value")
    }
    if negate {
        return 0 - v
    }
    return v
}

// A number or a constant.
fn constant() u32 {
    var label bool
    var v = value(&label)
    if label {
        fail("expected a number or constant")
    }
    return v
}

fn fits16(v u32) bool {
    return v + 0x8000 <= 0xffff
}

// A constant that fits in 16 signed bits, as its low 16 bits.
fn immediate() u32 {
    var v = constant()
    if !fits16(v) {
        fail("value doesn't fit")
    }
    return v & 0xffff
}

// A label in .code: its address, or 0 in the first pass.
fn code_label() u32 {
    var t = next()
    if t.kind != Kind.Name {
        fail("expected a label")
    }
    if pass == 1 {
        return 0
    }
    var s = find_symbol(t.text)
    if s.name.len == 0 {
        fail_name("undefined name", t.text)
    }
    if s.kind != CODE {
        fail_name("not a label in .code:", t.text)
    }
    return label_address(s)
}

// Output ---------------------------------------------------------------------

fn emit(word u32) {
    if section != CODE {
        fail("instructions belong in .code")
    }
    if pass == 2 {
        mem.write_word(code, offsets[CODE], word)
    }
    offsets[CODE] += 4
}

fn emit_fields(op u32, a u32, b u32, low u32) {
    emit(op << 24 | a << 20 | b << 16 | (low & 0xffff))
}

fn emit_jump(op u32, target u32) {
    emit(op << 24 | ((target >> 2) & 0xffffff))
}

fn emit_byte(b u8) {
    if section != DATA {
        fail("data belongs in .data")
    }
    if pass == 2 {
        data[offsets[DATA]] = b
    }
    offsets[DATA] += 1
}

// Space in .data or .bss, which is zero to begin with.
fn zeros(n u32) {
    if section == CODE {
        fail("can't reserve space in .code")
    }
    if offsets[section] + n < n {
        fail("value doesn't fit")
    }
    offsets[section] += n
}

// Statements -----------------------------------------------------------------

fn statement() {
    var t = peek()
    if t.kind == Kind.Name && tokens[cursor + 1].kind == Kind.Colon {
        define(t.text, section, offsets[section])
        cursor += 2
        t = peek()
    }
    match t.kind {
        Kind.End => {
            return
        }
        Kind.Name => {
            constant_definition()
        }
        Kind.Register => {
            assign()
        }
        Kind.LBracket, Kind.U8, Kind.U16 => {
            store()
        }
        Kind.If => {
            cursor += 1
            if_statement()
        }
        Kind.Goto => {
            cursor += 1
            var target = code_label()
            expect_end()
            emit_jump(JMP, target)
        }
        Kind.Call => {
            cursor += 1
            if peek().kind == Kind.Register {
                var r = next().value
                expect_end()
                emit_fields(CALLR, r, 0, 0)
            } else {
                var target = code_label()
                expect_end()
                emit_jump(CALL, target)
            }
        }
        Kind.Return, Kind.Resume, Kind.Wait, Kind.Halt => {
            cursor += 1
            expect_end()
            var op u32 = RET
            if t.kind == Kind.Resume {
                op = RESUME
            } else if t.kind == Kind.Wait {
                op = WAIT
            } else if t.kind == Kind.Halt {
                op = HALT
            }
            emit_fields(op, 0, 0, 0)
        }
        Kind.Push, Kind.Pop => {
            cursor += 1
            var op u32 = PUSH
            if t.kind == Kind.Pop {
                op = POP
            }
            while true {
                emit_fields(op, expect_register(), 0, 0)
                if peek().kind == Kind.End {
                    break
                }
                expect(Kind.Comma, ",")
            }
        }
        Kind.Copy, Kind.Fill => {
            cursor += 1
            var a = expect_register()
            expect(Kind.Comma, ",")
            var b = expect_register()
            expect(Kind.Comma, ",")
            var c = expect_register()
            expect_end()
            var op u32 = COPY
            if t.kind == Kind.Fill {
                op = FILL
            }
            emit_fields(op, a, b, c << 12)
        }
        Kind.Sys => {
            cursor += 1
            var n = constant()
            expect_end()
            if n > 0xffff {
                fail("system call number out of range")
            }
            emit_fields(SYS, 0, 0, n)
        }
        Kind.Io => {
            cursor += 1
            var port = expect_register()
            expect(Kind.Assign, "=")
            var v = expect_register()
            expect_end()
            emit_fields(OUT, v, port, 0)
        }
        Kind.DotCode, Kind.DotData, Kind.DotBss => {
            cursor += 1
            expect_end()
            section = CODE
            if t.kind == Kind.DotData {
                section = DATA
            } else if t.kind == Kind.DotBss {
                section = BSS
            }
        }
        Kind.DotByte => {
            cursor += 1
            bytes()
        }
        Kind.DotZero => {
            cursor += 1
            var n = constant()
            expect_end()
            zeros(n)
        }
        Kind.DotMemory => {
            cursor += 1
            set_once(&memory_size)
        }
        Kind.DotStack => {
            cursor += 1
            set_once(&stack_size)
        }
        Kind.DotAllow => {
            cursor += 1
            set_once(&allowed)
        }
        else => {
            fail("expected a statement")
        }
    }
}

// NAME = value
fn constant_definition() {
    var t = next()
    if !take(Kind.Assign) {
        fail("expected '=' after a name")
    }
    var v = constant()
    expect_end()
    define(t.text, CONSTANT, v)
}

// Statements that start with a register.
fn assign() {
    var rd = next().value
    var op = next().kind
    if op != Kind.Assign {
        // rd += value, rd >>s= value, ...
        var opcode = alu_opcode(op)
        if opcode == 0 {
            fail("expected an operator")
        }
        expect(Kind.Assign, "=")
        arithmetic(opcode, rd, rd)
        return
    }
    if take(Kind.Io) {
        var port = expect_register()
        expect_end()
        emit_fields(IN, rd, port, 0)
        return
    }
    var size = size_prefix()
    if peek().kind == Kind.LBracket {
        var offset u32
        var base = memory_operand(&offset)
        expect_end()
        emit_fields(LD + size, rd, base, offset)
        return
    }
    if size != 0 {
        fail_name("expected", "[")
    }
    if peek().kind == Kind.Register {
        var rs = next().value
        if peek().kind == Kind.End {
            emit_fields(ADDI, rd, rs, 0)
            return
        }
        var opcode = alu_opcode(next().kind)
        if opcode == 0 {
            fail("expected an operator")
        }
        arithmetic(opcode, rd, rs)
        return
    }
    // A number or constant takes one instruction if it fits in 16 bits; a
    // label always takes two.
    var label bool
    var v = value(&label)
    expect_end()
    emit_fields(LI, rd, 0, v)
    if label || !fits16(v) {
        emit_fields(LIH, rd, 0, v >> 16)
    }
}

// An arithmetic operation into rd from rs and a register or a constant.
fn arithmetic(op u32, rd u32, rs u32) {
    if peek().kind == Kind.Register {
        var rt = next().value
        expect_end()
        emit_fields(op, rd, rs, rt << 12)
        return
    }
    var imm = immediate()
    expect_end()
    emit_fields(op + 0x10, rd, rs, imm)
}

// [reg], [reg + value] or [reg - value]. Returns the register, and sets
// *offset to the offset's low 16 bits.
fn memory_operand(offset *u32) u32 {
    expect(Kind.LBracket, "[")
    var base = expect_register()
    var v u32 = 0
    if take(Kind.Plus) {
        v = constant()
    } else if take(Kind.Minus) {
        v = 0 - constant()
    }
    if !fits16(v) {
        fail("value doesn't fit")
    }
    expect(Kind.RBracket, "]")
    *offset = v & 0xffff
    return base
}

// [reg + offset] = reg, with u8 or u16 before it for a smaller store.
fn store() {
    var size = size_prefix()
    var offset u32
    var base = memory_operand(&offset)
    expect(Kind.Assign, "=")
    var v = expect_register()
    expect_end()
    emit_fields(ST + size, v, base, offset)
}

// if a CMP b goto label, where b can also be 0 with == and !=.
fn if_statement() {
    var a = expect_register()
    var b u32 = 0
    var compare = next().kind
    var op = branch_opcode(compare)
    if op == 0 {
        fail("expected a comparison")
    }
    if peek().kind == Kind.Number {
        if next().value != 0 || (compare != Kind.Equal && compare != Kind.NotEqual) {
            fail("only '== 0' and '!= 0' compare with a number")
        }
        op = BZ
        if compare == Kind.NotEqual {
            op = BNZ
        }
    } else {
        b = expect_register()
        if swaps(compare) {
            var first = a
            a = b
            b = first
        }
    }
    if !take(Kind.Goto) {
        fail("expected 'goto'")
    }
    var target = code_label()
    expect_end()
    var offset u32 = 0
    if pass == 2 {
        // The distance in words from the next instruction.
        var distance = (target - (BASE + offsets[CODE] + 4)) as i32
        offset = (distance >> 2) as u32
        if !fits16(offset) {
            fail("branch target is too far away")
        }
    }
    emit_fields(op, a, b, offset)
}

// .byte 1, 'x', "text"
fn bytes() {
    while true {
        var t = peek()
        if t.kind == Kind.String {
            cursor += 1
            for i in 0..t.text.len {
                emit_byte(t.text[i])
            }
        } else {
            var v = constant()
            if v + 128 >= 384 {
                fail("value doesn't fit in a byte")
            }
            emit_byte(v as u8)
        }
        if peek().kind == Kind.End {
            return
        }
        expect(Kind.Comma, ",")
    }
}

fn set_once(s *Setting) {
    var v = constant()
    expect_end()
    if s.given {
        fail("directive is already set")
    }
    s.given = true
    s.value = v
}
