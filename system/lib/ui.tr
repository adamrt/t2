// Standard controls in the style of Mac OS 8's Platinum, in greys, drawn the
// immediate way: on every event the program redraws its window by calling
// the control functions, which draw themselves and say what happened to
// them. A button reports a click when the mouse is pressed and released on
// it.
//
//     ui.event(&panel, &e)
//     if ui.button(&panel, 1, 10, 10, 80, 24, "Save") { save() }
//     ui.end(&panel)
//     gfx.present(panel.canvas)
//
// Each control needs an id of its own, any number but 0. Text is the system
// font's 8 by 16 pixels.

import gfx
import mem
import text

// Platinum's greys, for programs to draw with too.
const BLACK u32 = 0xff000000
const WHITE u32 = 0xffffffff
const FACE u32 = 0xffdddddd         // controls, and the backgrounds of tool windows
const TRACK u32 = 0xffcccccc        // the channel a scroll bar or slider runs in
const SELECTION u32 = 0xffbbbbbb    // selected text and rows
const SHADOW u32 = 0xff999999       // the dark side of a raised edge
const DIM u32 = 0xff808080          // text that matters less
const DARK u32 = 0xff666666         // controls being pressed

const SCROLL_WIDTH = 16
const FIELD_HEIGHT = 22

struct Panel {
    canvas *gfx.Canvas
    mouse_x i32
    mouse_y i32
    pressed bool            // a press happened in this event
    released bool           // a release happened in this event
    active u32              // the control the mouse went down on
    typed u32               // a character typed in this event, or 0
    key u32                 // a key pressed in this event, or 0
    focus u32               // the text field that takes typing
    grab i32                // where in a scroll bar's thumb it was grabbed, or -1
}

fn init(panel *Panel, canvas *gfx.Canvas) {
    mem.fill(panel as *u8, 0, size_of(Panel))
    panel.canvas = canvas
    panel.grab = -1
}

// Takes in one event, before the controls are drawn for it.
fn event(panel *Panel, e *gfx.Event) {
    panel.pressed = false
    panel.released = false
    panel.typed = 0
    panel.key = 0
    if e.kind == gfx.EVENT_MOUSE_MOVE || e.kind == gfx.EVENT_MOUSE_DOWN || e.kind == gfx.EVENT_MOUSE_UP {
        panel.mouse_x = e.x
        panel.mouse_y = e.y
    }
    if e.kind == gfx.EVENT_MOUSE_DOWN {
        panel.pressed = true
        panel.active = 0
    } else if e.kind == gfx.EVENT_MOUSE_UP {
        panel.released = true
    } else if e.kind == gfx.EVENT_TEXT {
        panel.typed = e.key
    } else if e.kind == gfx.EVENT_KEY_DOWN {
        panel.key = e.key
    }
}

// Ends an event: a release lets go of the control that was pressed.
fn end(panel *Panel) {
    if panel.released {
        panel.active = 0
        panel.grab = -1
    }
}

fn inside(panel *Panel, x i32, y i32, w i32, h i32) bool {
    return panel.mouse_x >= x && panel.mouse_x < x + w && panel.mouse_y >= y && panel.mouse_y < y + h
}

// Whether the control is being held down with the mouse over it. A press on
// it makes it the active one.
fn track(panel *Panel, id u32, over bool) bool {
    if panel.pressed && over {
        panel.active = id
    }
    return panel.active == id && over && !panel.released
}

// Whether the control was clicked: pressed and released over it.
fn clicked(panel *Panel, id u32, over bool) bool {
    return panel.released && over && panel.active == id
}

//
// Drawing
//

fn label(panel *Panel, x i32, y i32, words []u8) {
    gfx.draw_text(panel.canvas, x, y, BLACK, words)
}

// A label for something less important, or something that can't be used.
fn dim_label(panel *Panel, x i32, y i32, words []u8) {
    gfx.draw_text(panel.canvas, x, y, DIM, words)
}

// Bold, the way the old Macs made it: the text twice, a pixel apart.
fn bold_label(panel *Panel, x i32, y i32, words []u8) {
    gfx.draw_text(panel.canvas, x, y, BLACK, words)
    gfx.draw_text(panel.canvas, x + 1, y, BLACK, words)
}

fn text_width(words []u8) i32 {
    return (text.char_count(words) * 8) as i32
}

// Light lines along the top and left, dark ones along the bottom and right:
// raised with light first, sunken with dark first.
fn bevel(c *gfx.Canvas, x i32, y i32, w i32, h i32, light u32, dark u32) {
    gfx.draw_fill(c, x, y, w - 1, 1, light)
    gfx.draw_fill(c, x, y + 1, 1, h - 2, light)
    gfx.draw_fill(c, x + 1, y + h - 1, w - 1, 1, dark)
    gfx.draw_fill(c, x + w - 1, y, 1, h - 1, dark)
}

fn outline(c *gfx.Canvas, x i32, y i32, w i32, h i32, color u32) {
    gfx.draw_fill(c, x, y, w, 1, color)
    gfx.draw_fill(c, x, y + h - 1, w, 1, color)
    gfx.draw_fill(c, x, y + 1, 1, h - 2, color)
    gfx.draw_fill(c, x + w - 1, y + 1, 1, h - 2, color)
}

// An outline with its corners left out, which looks rounded.
fn rounded(c *gfx.Canvas, x i32, y i32, w i32, h i32, color u32) {
    gfx.draw_fill(c, x + 1, y, w - 2, 1, color)
    gfx.draw_fill(c, x + 1, y + h - 1, w - 2, 1, color)
    gfx.draw_fill(c, x, y + 1, 1, h - 2, color)
    gfx.draw_fill(c, x + w - 1, y + 1, 1, h - 2, color)
}

// A box raised from the window, with a black edge.
fn raised(c *gfx.Canvas, x i32, y i32, w i32, h i32) {
    outline(c, x, y, w, h, BLACK)
    gfx.draw_fill(c, x + 1, y + 1, w - 2, h - 2, FACE)
    bevel(c, x + 1, y + 1, w - 2, h - 2, WHITE, SHADOW)
}

// A white box set into the window, for text, lists and pictures.
fn sunken(c *gfx.Canvas, x i32, y i32, w i32, h i32) {
    bevel(c, x, y, w, h, SHADOW, WHITE)
    outline(c, x + 1, y + 1, w - 2, h - 2, BLACK)
    gfx.draw_fill(c, x + 2, y + 2, w - 4, h - 4, WHITE)
}

// A line cut into the window, to separate things.
fn separator(panel *Panel, x i32, y i32, w i32) {
    gfx.draw_fill(panel.canvas, x, y, w, 1, SHADOW)
    gfx.draw_fill(panel.canvas, x, y + 1, w, 1, WHITE)
}

// A frame cut into the window around controls that belong together, with a
// title on its top edge.
fn group(panel *Panel, x i32, y i32, w i32, h i32, title []u8) {
    var c = panel.canvas
    outline(c, x + 1, y + 9, w - 1, h - 9, WHITE)
    outline(c, x, y + 8, w - 1, h - 9, SHADOW)
    if title.len > 0 {
        gfx.draw_fill(c, x + 8, y, text_width(title) + 8, 16, FACE)
        gfx.draw_text(c, x + 12, y, BLACK, title)
    }
}

//
// Controls
//

fn draw_button(c *gfx.Canvas, x i32, y i32, w i32, h i32, words []u8, down bool) {
    rounded(c, x, y, w, h, BLACK)
    var color = BLACK
    if down {
        gfx.draw_fill(c, x + 1, y + 1, w - 2, h - 2, DARK)
        bevel(c, x + 1, y + 1, w - 2, h - 2, BLACK, SHADOW)
        color = WHITE
    } else {
        gfx.draw_fill(c, x + 1, y + 1, w - 2, h - 2, FACE)
        bevel(c, x + 1, y + 1, w - 2, h - 2, WHITE, SHADOW)
        bevel(c, x + 2, y + 2, w - 4, h - 4, FACE, TRACK)
    }
    gfx.draw_text(c, x + (w - text_width(words)) / 2, y + (h - 16) / 2, color, words)
}

// A push button. Returns true when it's clicked.
fn button(panel *Panel, id u32, x i32, y i32, w i32, h i32, words []u8) bool {
    var over = inside(panel, x, y, w, h)
    var down = track(panel, id, over)
    draw_button(panel.canvas, x, y, w, h, words, down)
    return clicked(panel, id, over)
}

// The button Enter presses, with a thick ring around it. The ring takes
// 4 pixels on every side.
fn default_button(panel *Panel, id u32, x i32, y i32, w i32, h i32, words []u8) bool {
    var c = panel.canvas
    rounded(c, x - 4, y - 4, w + 8, h + 8, BLACK)
    rounded(c, x - 3, y - 3, w + 6, h + 6, BLACK)
    rounded(c, x - 2, y - 2, w + 4, h + 4, BLACK)
    var enter = panel.key == gfx.KEY_ENTER
    return button(panel, id, x, y, w, h, words) || enter
}

// A box that can be ticked. Returns true when it changes.
fn checkbox(panel *Panel, id u32, x i32, y i32, words []u8, value *bool) bool {
    var c = panel.canvas
    var over = inside(panel, x, y, 18 + text_width(words), 16)
    var down = track(panel, id, over)
    var changed = clicked(panel, id, over)
    if changed {
        *value = !*value
    }
    var top = y + 2
    outline(c, x, top, 12, 12, BLACK)
    var inner = WHITE
    if down {
        inner = SHADOW
    }
    gfx.draw_fill(c, x + 1, top + 1, 10, 10, inner)
    gfx.draw_fill(c, x + 1, top + 1, 10, 1, SHADOW)
    gfx.draw_fill(c, x + 1, top + 2, 1, 9, SHADOW)
    if *value {
        // A check mark, two pixels thick.
        for t in 0..2 {
            gfx.draw_line(c, x + 2, top + 5 + t as i32, x + 4, top + 7 + t as i32, BLACK)
            gfx.draw_line(c, x + 4, top + 7 + t as i32, x + 9, top + 2 + t as i32, BLACK)
        }
    }
    gfx.draw_text(c, x + 18, y, BLACK, words)
    return changed
}

// One of a set of choices, of which one is chosen. Returns true when it's
// clicked; the program then makes it the chosen one.
fn radio(panel *Panel, id u32, x i32, y i32, words []u8, chosen bool) bool {
    var c = panel.canvas
    var over = inside(panel, x, y, 18 + text_width(words), 16)
    var down = track(panel, id, over)
    var top = y + 2
    // A circle, row by row: how far in from each side each row starts.
    var edge = "421100001124"
    var inner = WHITE
    if down {
        inner = SHADOW
    }
    for row in 0..12 {
        var d = (edge[row] - '0') as i32
        gfx.draw_fill(c, x + d, top + row as i32, 12 - 2 * d, 1, BLACK)
        if row > 0 && row < 11 {
            var e = d + 1
            if row == 1 || row == 10 {
                e = 3
            }
            gfx.draw_fill(c, x + e, top + row as i32, 12 - 2 * e, 1, inner)
        }
    }
    if chosen {
        gfx.draw_fill(c, x + 4, top + 3, 4, 6, BLACK)
        gfx.draw_fill(c, x + 3, top + 4, 6, 4, BLACK)
    }
    gfx.draw_text(c, x + 18, y, BLACK, words)
    return clicked(panel, id, over)
}

// A one-line text field editing buffer[0:*length], FIELD_HEIGHT pixels tall.
// Clicking it gives it the typing, which a ring around it shows; the ring
// takes 3 pixels on every side. Returns true when Enter is pressed in it.
fn field(panel *Panel, id u32, x i32, y i32, w i32, buffer []u8, length *u32) bool {
    var c = panel.canvas
    if panel.pressed {
        if inside(panel, x, y, w, FIELD_HEIGHT) {
            panel.focus = id
        } else if panel.focus == id {
            panel.focus = 0
        }
    }
    var entered = false
    if panel.focus == id {
        if panel.typed != 0 && *length + 4 <= buffer.len {
            *length += text.encode_char(panel.typed, buffer[*length:])
        } else if panel.key == gfx.KEY_BACKSPACE && *length > 0 {
            *length = text.char_start(buffer, *length)
        } else if panel.key == gfx.KEY_ENTER {
            entered = true
        }
    }
    sunken(c, x, y, w, FIELD_HEIGHT)
    if panel.focus == id {
        outline(c, x - 3, y - 3, w + 6, FIELD_HEIGHT + 6, DARK)
        outline(c, x - 2, y - 2, w + 4, FIELD_HEIGHT + 4, DARK)
    }
    // Shows the end of the text, as much as fits.
    var start = *length
    var shown u32 = 0
    var room = ((w - 10) / 8) as u32
    while start > 0 && shown < room {
        start = text.char_start(buffer, start)
        shown += 1
    }
    gfx.draw_text(c, x + 5, y + 3, BLACK, buffer[start:*length])
    if panel.focus == id {
        gfx.draw_fill(c, x + 5 + (shown * 8) as i32, y + 3, 1, 16, BLACK)
    }
    return entered
}

// A bar that fills as value goes from 0 to total, 12 pixels tall.
fn progress(panel *Panel, x i32, y i32, w i32, value u32, total u32) {
    var c = panel.canvas
    sunken(c, x, y, w, 12)
    if total == 0 {
        return
    }
    var filled = ((w - 4) as u32 * min_u(value, total) / total) as i32
    if filled > 0 {
        gfx.draw_fill(c, x + 2, y + 2, filled, 8, DARK)
        gfx.draw_fill(c, x + 2, y + 2, filled, 1, SHADOW)
    }
}

// A scroll bar for a list of total lines that shows page of them, starting
// at *position. It's SCROLL_WIDTH pixels wide and h tall. Returns true when
// it changes *position: the arrows move a line, the track a page, and the
// thumb follows the mouse.
fn scrollbar(panel *Panel, id u32, x i32, y i32, h i32, position *u32, total u32, page u32) bool {
    var c = panel.canvas
    var w i32 = SCROLL_WIDTH
    outline(c, x, y, w, h, BLACK)
    var track_y = y + w - 1
    var track_h = h - 2 * (w - 1)
    var last u32 = 0
    if total > page {
        last = total - page
    }
    var before = *position
    if *position > last {
        *position = last
    }
    var up = inside(panel, x, y, w, w)
    var down = inside(panel, x, y + h - w, w, w)
    var thumb_h = track_h
    var thumb_y = track_y
    if last > 0 {
        thumb_h = max_i((track_h as u32 * page / total) as i32, 16)
        thumb_y = track_y + ((track_h - thumb_h) as u32 * *position / last) as i32
    }
    if last > 0 && panel.pressed && inside(panel, x, y, w, h) {
        panel.active = id
        panel.grab = -1
        if up {
            *position = sub_or_zero(*position, 1)
        } else if down {
            *position = min_u(*position + 1, last)
        } else if panel.mouse_y < thumb_y {
            *position = sub_or_zero(*position, page)
        } else if panel.mouse_y >= thumb_y + thumb_h {
            *position = min_u(*position + page, last)
        } else {
            panel.grab = panel.mouse_y - thumb_y
        }
    } else if last > 0 && panel.active == id && panel.grab >= 0 && track_h > thumb_h {
        var top = max_i(panel.mouse_y - panel.grab - track_y, 0)
        *position = min_u((top as u32 * last + (track_h - thumb_h) as u32 / 2) / (track_h - thumb_h) as u32, last)
    }
    if last > 0 {
        thumb_y = track_y + ((track_h - thumb_h) as u32 * *position / last) as i32
    }

    // The track, then the thumb with ridges to grip, then the arrows.
    gfx.draw_fill(c, x + 1, track_y, w - 2, track_h, TRACK)
    gfx.draw_fill(c, x + 1, track_y, w - 2, 1, SHADOW)
    gfx.draw_fill(c, x + 1, track_y + 1, 1, track_h - 1, SHADOW)
    if last > 0 {
        raised(c, x, thumb_y, w, thumb_h)
        var middle = thumb_y + thumb_h / 2 - 4
        for i in 0..4 {
            gfx.draw_fill(c, x + 4, middle + i as i32 * 2, w - 8, 1, SHADOW)
            gfx.draw_fill(c, x + 5, middle + i as i32 * 2 + 1, w - 8, 1, WHITE)
        }
    }
    arrow(c, x, y, true, last > 0 && panel.active == id && panel.grab < 0 && up && !panel.released, last > 0)
    arrow(c, x, y + h - w, false, last > 0 && panel.active == id && panel.grab < 0 && down && !panel.released, last > 0)
    return *position != before
}

fn arrow(c *gfx.Canvas, x i32, y i32, up bool, down bool, usable bool) {
    var w i32 = SCROLL_WIDTH
    outline(c, x, y, w, w, BLACK)
    var color = BLACK
    if down {
        gfx.draw_fill(c, x + 1, y + 1, w - 2, w - 2, DARK)
        color = WHITE
    } else {
        gfx.draw_fill(c, x + 1, y + 1, w - 2, w - 2, FACE)
        bevel(c, x + 1, y + 1, w - 2, w - 2, WHITE, SHADOW)
    }
    if !usable {
        color = SHADOW
    }
    var mid = x + w / 2
    if up {
        gfx.draw_triangle(c, mid, y + 4, color, mid - 5, y + 10, color, mid + 5, y + 10, color)
    } else {
        gfx.draw_triangle(c, mid - 5, y + 6, color, mid + 5, y + 6, color, mid, y + 12, color)
    }
}

fn sub_or_zero(a u32, b u32) u32 {
    if a > b {
        return a - b
    }
    return 0
}

fn max_i(a i32, b i32) i32 {
    if a > b {
        return a
    }
    return b
}

fn min_u(a u32, b u32) u32 {
    if a < b {
        return a
    }
    return b
}
