// Processes and the memory they live in.
//
// Each process gets one unbroken run of physical memory: its code, then its
// data. Programs only see addresses relative to their own run, so the kernel
// can slide runs together whenever free memory is in pieces.

enum State {
    Free,
    Ready,
    Blocked,        // waiting; it repeats its system call when woken
    Zombie,         // ended, waiting for its parent to collect the status
}

const MAX_PROCESSES = 32;
const MAX_HANDLES = 16;
const ARGS_SIZE = 1024;
const PATH_SIZE = 256;
const PROCESS_NAME_SIZE = 32;
const PAGE: u32 = 4096;
const HEADER: u32 = 32;
const RESERVE: u32 = 2 * MiB;       // memory only recovery programs can use

// Permissions, as in a program's manifest.
const ALLOW_READ: u32 = 1;
const ALLOW_WRITE: u32 = 2;
const ALLOW_SPAWN: u32 = 4;
const ALLOW_WINDOW: u32 = 8;
const ALLOW_PROCESSES: u32 = 16;
const ALLOW_RECOVERY: u32 = 32;
const ALLOW_AUDIO: u32 = 64;
const ALLOW_NETWORK: u32 = 128;

struct Process {
    state: State;
    id: u32;
    parent: u32;
    name: [PROCESS_NAME_SIZE]u8;
    name_len: u32;
    regs: [9]u32;
    pc: u32;
    region: u32;            // physical address of its memory
    memory: u32;            // bytes of memory
    code_size: u32;
    stack_size: u32;
    handles: [MAX_HANDLES]*Object;
    args: [ARGS_SIZE]u8;
    args_len: u32;
    arg_count: u32;
    dir: [PATH_SIZE]u8;
    dir_len: u32;
    status: u32;
    wake_time: u32;         // when a sleep ends, or 0
    cycles: u32;
    permissions: u32;
    trace: *Object;         // where to report this process's system calls
    trace_spawns: *Object;  // where to report those of processes it starts
    stack_low: u32;         // the lowest sp seen, for the stack's high-water mark
    bytes_read: u32;
    bytes_written: u32;
}

var processes: [MAX_PROCESSES]Process;
var next_id: u32;
var last_run: u32;
var spawn_args: [ARGS_SIZE]u8;

fn next_ready() -> *Process {
    for i in 0..MAX_PROCESSES {
        var n = (last_run + 1 + i) % MAX_PROCESSES;
        if processes[n].state == State.Ready {
            last_run = n;
            return &processes[n];
        }
    }
    return null;
}

fn any_alive() -> bool {
    for i in 0..MAX_PROCESSES {
        if processes[i].state == State.Ready || processes[i].state == State.Blocked {
            return true;
        }
    }
    return false;
}

fn wake_all() {
    for i in 0..MAX_PROCESSES {
        if processes[i].state == State.Blocked {
            processes[i].state = State.Ready;
        }
    }
}

// The earliest time a sleeping process wants to wake, or 0.
fn next_wake() -> u32 {
    var soonest: u32 = 0;
    for i in 0..MAX_PROCESSES {
        var t = processes[i].wake_time;
        if processes[i].state == State.Blocked && t != 0 && (soonest == 0 || t < soonest) {
            soonest = t;
        }
    }
    return soonest;
}

// Makes the process repeat its system call when it next runs.
fn block(p: *Process) {
    p.state = State.Blocked;
    p.pc -= 4;
}

fn find_process(id: u32) -> *Process {
    for i in 0..MAX_PROCESSES {
        if processes[i].state != State.Free && processes[i].id == id {
            return &processes[i];
        }
    }
    return null;
}

// Starts the program at an absolute path. Each argument in args ends with a
// zero byte. The new process gets handles 0, 1 and 2 from the given objects.
fn spawn_process(parent: *Process, path: []u8, args: []u8, handles: []*Object) -> *Process {
    var f: FileRef;
    if !lookup(path, &f) || f.kind != KIND_FILE {
        return null;
    }
    var header: [HEADER]u8;
    if read_at(&f, 0, header[:]) != HEADER || !text_equal(header[0:4], "TRX2") {
        return null;
    }
    var entry = get_word(header[:], 4);
    var code = get_word(header[:], 8);
    var data = get_word(header[:], 12);
    var bss = get_word(header[:], 16);
    var stack = get_word(header[:], 20);
    var memory = get_word(header[:], 24);
    // A program gets what its manifest asks for, but never more than its parent has.
    var permissions = get_word(header[:], 28);
    if parent != null {
        permissions &= parent.permissions;
    }
    // Each size is checked on its own first, so the sums below can't wrap.
    if memory > memory_end - memory_start || code > memory || code > f.size || data > f.size {
        return null;
    }
    var data_size = memory - code;
    if code % 4 != 0 || memory % 4 != 0 || HEADER + code + data > f.size || data > data_size || bss > data_size || stack > data_size {
        return null;
    }
    if align4(data) + align4(bss) + stack > data_size || entry < GUARD || entry - GUARD >= code || args.len > ARGS_SIZE {
        return null;
    }
    // The arguments may be in the parent's memory, which reserving memory
    // can move, so they're copied first.
    copy(spawn_args[:], args);
    var saved_args = spawn_args[0:args.len];

    var p: *Process = null;
    for i in 0..MAX_PROCESSES {
        if processes[i].state == State.Free {
            p = &processes[i];
            break;
        }
    }
    if p == null {
        return null;
    }
    mem_fill(p as *u8, 0, size_of(Process));
    var region = reserve(memory, p, permissions & ALLOW_RECOVERY != 0);
    if region == FAILED {
        return null;
    }
    var bytes = physical_bytes(region, memory);
    mem_fill(bytes.ptr, 0, memory);
    read_at(&f, HEADER, bytes[0:code]);
    read_at(&f, HEADER + code, bytes[code:code + data]);

    next_id += 1;
    p.id = next_id;
    p.region = region;
    p.memory = memory;
    p.code_size = code;
    p.stack_size = stack;
    p.permissions = permissions;
    p.pc = entry;
    p.regs[0] = GUARD + align4(data) + align4(bss);
    p.regs[1] = GUARD + data_size - stack;
    p.regs[8] = GUARD + data_size;
    p.stack_low = p.regs[8];

    var slash = path.len;
    while slash > 0 && path[slash - 1] != '/' {
        slash -= 1;
    }
    p.name_len = min(path.len - slash, PROCESS_NAME_SIZE);
    copy(p.name[:], path[slash:slash + p.name_len]);
    copy(p.args[:], saved_args);
    p.args_len = saved_args.len;
    for i in 0..saved_args.len {
        if saved_args[i] == 0 {
            p.arg_count += 1;
        }
    }
    if parent != null {
        p.parent = parent.id;
        copy(p.dir[:], parent.dir[0:parent.dir_len]);
        p.dir_len = parent.dir_len;
    } else {
        p.dir[0] = '/';
        p.dir_len = 1;
    }
    for i in 0..handles.len {
        p.handles[i] = handles[i];
        if handles[i] != null {
            handles[i].refs += 1;
        }
    }
    if parent != null {
        p.trace = parent.trace_spawns;
        if p.trace == null {
            p.trace = parent.trace;
        }
        if p.trace != null {
            p.trace.refs += 1;
        }
    }
    p.state = State.Ready;
    return p;
}

fn exit_process(p: *Process, status: u32) {
    if running == p {
        running = null;
    }
    for i in 0..MAX_HANDLES {
        if p.handles[i] != null {
            release_object(p.handles[i]);
            p.handles[i] = null;
        }
    }
    if p.trace != null {
        release_object(p.trace);
        p.trace = null;
    }
    if p.trace_spawns != null {
        release_object(p.trace_spawns);
        p.trace_spawns = null;
    }
    release_memory(p);
    p.status = status;
    var parent = find_process(p.parent);
    if parent != null && parent.state != State.Zombie {
        p.state = State.Zombie;
    } else {
        p.state = State.Free;
    }
    // Children that already ended have nobody left to collect them.
    for i in 0..MAX_PROCESSES {
        if processes[i].state == State.Zombie && processes[i].parent == p.id {
            processes[i].state = State.Free;
        }
    }
    wake_all();
}

fn align4(n: u32) -> u32 {
    return (n + 3) & ~3;
}

// Memory ---------------------------------------------------------------------

struct Region {
    base: u32;
    size: u32;
    owner: *Process;
}

var regions: [MAX_PROCESSES]Region;     // sorted by base
var region_count: u32;
var memory_start: u32;
var memory_end: u32;

fn memory_init(start: u32, end: u32) {
    memory_start = start;
    memory_end = end;
}

fn physical_bytes(base: u32, size: u32) -> []u8 {
    return ((base + GUARD) as *u8)[0:size];
}

fn memory_used() -> u32 {
    var used: u32 = 0;
    for i in 0..region_count {
        used += regions[i].size;
    }
    return used;
}

// Finds a run of size bytes for owner, compacting memory if that helps.
// Only recovery programs may dip into the reserve. Returns the run's physical
// address, or FAILED.
fn reserve(request: u32, owner: *Process, recovery: bool) -> u32 {
    var size = (request + PAGE - 1) / PAGE * PAGE;
    var available = memory_end - memory_start - memory_used();
    if !recovery {
        if available < RESERVE {
            return FAILED;
        }
        available -= RESERVE;
    }
    if region_count == MAX_PROCESSES || size > available {
        return FAILED;
    }
    var base = memory_start;
    var at = region_count;
    for i in 0..region_count {
        if regions[i].base - base >= size {
            at = i;
            break;
        }
        base = regions[i].base + regions[i].size;
    }
    if at == region_count && memory_end - base < size {
        compact();
        base = memory_start + memory_used();
    }
    var i = region_count;
    while i > at {
        regions[i] = regions[i - 1];
        i -= 1;
    }
    regions[at].base = base;
    regions[at].size = size;
    regions[at].owner = owner;
    region_count += 1;
    return base;
}

fn release_memory(owner: *Process) {
    for i in 0..region_count {
        if regions[i].owner == owner {
            for j in i..region_count - 1 {
                regions[j] = regions[j + 1];
            }
            region_count -= 1;
            return;
        }
    }
}

// Slides every process's memory down so the free memory is in one piece.
fn compact() {
    put(&log, "Terrarium: compacting memory\n");
    flush(&log);
    var base = memory_start;
    for i in 0..region_count {
        var r = &regions[i];
        if r.base != base {
            mem_copy(physical_bytes(base, 0).ptr, physical_bytes(r.base, 0).ptr, r.size);
            r.base = base;
            r.owner.region = base;
        }
        base += r.size;
    }
}
